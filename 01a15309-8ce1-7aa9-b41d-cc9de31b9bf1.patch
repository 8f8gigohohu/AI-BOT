--- /dev/null
+++ b/server/vault.ts
@@ -0,0 +1,91 @@
+import { createCipheriv, createDecipheriv, randomBytes } from 'node:crypto';
+import {
+  existsSync,
+  readFileSync,
+  writeFileSync,
+  renameSync,
+  unlinkSync,
+  chmodSync,
+} from 'node:fs';
+import { resolve } from 'node:path';
+import { z } from 'zod';
+import type { IpStatus } from '../shared/types.js';
+import { AppError } from './errors.js';
+
+export interface Credentials {
+  apiKey: string;
+  apiSecret: string;
+  ipStatus: IpStatus;
+}
+const record = z
+  .object({
+    apiKey: z.string().min(1).max(512),
+    apiSecret: z.string().min(1).max(2048),
+    ipStatus: z.enum(['unknown', 'confirmed', 'not_configured']),
+  })
+  .strict();
+const AAD = Buffer.from('darkdevil-quant:zebpay-vault:v1');
+export class CredentialVault {
+  private path: string;
+  constructor(
+    dataDir: string,
+    private key: Buffer,
+  ) {
+    this.path = resolve(dataDir, 'zebpay.enc');
+  }
+  has(): boolean {
+    return existsSync(this.path);
+  }
+  save(credentials: Credentials): void {
+    record.parse(credentials);
+    const iv = randomBytes(12);
+    const cipher = createCipheriv('aes-256-gcm', this.key, iv);
+    cipher.setAAD(AAD);
+    const data = Buffer.concat([
+      cipher.update(JSON.stringify(credentials), 'utf8'),
+      cipher.final(),
+    ]);
+    const envelope = {
+      version: 1,
+      iv: iv.toString('base64'),
+      tag: cipher.getAuthTag().toString('base64'),
+      data: data.toString('base64'),
+    };
+    const temp = `${this.path}.${randomBytes(8).toString('hex')}.tmp`;
+    try {
+      writeFileSync(temp, JSON.stringify(envelope), { mode: 0o600, flag: 'wx' });
+      renameSync(temp, this.path);
+      chmodSync(this.path, 0o600);
+    } finally {
+      if (existsSync(temp)) unlinkSync(temp);
+    }
+  }
+  read(): Credentials | null {
+    if (!this.has()) return null;
+    try {
+      const e = JSON.parse(readFileSync(this.path, 'utf8'));
+      if (e.version !== 1) throw new Error();
+      const decipher = createDecipheriv('aes-256-gcm', this.key, Buffer.from(e.iv, 'base64'));
+      decipher.setAAD(AAD);
+      decipher.setAuthTag(Buffer.from(e.tag, 'base64'));
+      const plaintext = Buffer.concat([
+        decipher.update(Buffer.from(e.data, 'base64')),
+        decipher.final(),
+      ]);
+      try {
+        return record.parse(JSON.parse(plaintext.toString('utf8')));
+      } finally {
+        plaintext.fill(0);
+      }
+    } catch {
+      throw new AppError(
+        'VAULT_UNAVAILABLE',
+        'Stored credentials cannot be decrypted. Restore the original master key or disconnect and reconnect securely.',
+        503,
+      );
+    }
+  }
+  clear(): void {
+    if (this.has()) unlinkSync(this.path);
+  }
+}
