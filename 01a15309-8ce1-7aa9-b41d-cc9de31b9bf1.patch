+import { useEffect, useState } from 'react';
+import { ArrowRight, ChevronLeft, ChevronRight, ScrollText } from 'lucide-react';
+import type { Decision, DecisionFills, DecisionOutcome, JournalView } from '../../shared/types';
+import { api, formatMoney, formatNumber, formatTime } from '../api';
+import { Badge, Button, Empty, Notice, Panel } from './ui';
+
+function DecisionRow({
+  decision,
+  outcome,
+}: {
+  decision: Decision;
+  outcome: DecisionOutcome | undefined;
+}) {
+  const [open, setOpen] = useState(false),
+    [page, setPage] = useState(1);
+  const [fills, setFills] = useState<DecisionFills | null>(null),
+    [error, setError] = useState(''),
+    [busy, setBusy] = useState(false);
+  useEffect(() => {
+    if (!open) return;
+    const controller = new AbortController();
+    setBusy(true);
+    setError('');
+    setFills(null);
+    api<DecisionFills>(
+      `/api/journal/decisions/${decision.id}/fills?page=${page}`,
+      'GET',
+      undefined,
+      controller.signal,
+    )
+      .then((result) => {
+        if (!controller.signal.aborted) setFills(result);
+      })
+      .catch((e) => {
+        if (!controller.signal.aborted) setError(e.message);
+      })
+      .finally(() => {
+        if (!controller.signal.aborted) setBusy(false);
+      });
+    return () => controller.abort();
+  }, [open, page, decision.id, outcome?.fills]);
+  return (
+    <details className="decision-row" onToggle={(e) => setOpen(e.currentTarget.open)}>
+      <summary>
+        <div className={`decision-indicator signal-${decision.signal}`}>
+          {decision.signal.toUpperCase()}
+        </div>
+        <div>
+          <strong>{decision.pair}</strong>
+          <span>
+            {decision.venue} · {decision.observations} observations · {decision.strength} rule
+            strength
+          </span>
+        </div>
+        <span className="mono muted">{formatTime(decision.createdAt, true)} UTC</span>
+        <Badge tone={outcome?.fills ? 'purple' : 'neutral'}>
+          {outcome ? `${outcome.fills} linked paper fill(s)` : 'Outcome unavailable'}
+        </Badge>
+        <ChevronRight size={15} />
+      </summary>
+      <div className="decision-row-detail">
+        {decision.reasons.map((reason) => (
+          <p key={reason}>{reason}</p>
+        ))}
+        <Notice tone="amber">
+          Risk: {decision.risk}. {decision.risks.join(' ')}
+        </Notice>
+        {outcome && (
+          <>
+            <div className="decision-outcome-grid">
+              <div>
+                <span>All linked quantity</span>
+                <strong className="mono">{outcome.quantity}</strong>
+              </div>
+              <div>
+                <span>Assumed fees · all linked fills</span>
+                <strong className="mono">{formatMoney(outcome.assumedFees)}</strong>
+              </div>
+              <div>
+                <span>Current / archived wallet fills</span>
+                <strong className="mono">
+                  {outcome.currentWalletFills} / {outcome.archivedWalletFills}
+                </strong>
+              </div>
+              <div>
+                <span>Linked SELL realized P&L</span>
+                <strong className="mono">{formatMoney(outcome.sellRealizedPnl)}</strong>
+              </div>
+            </div>
+            <p className="outcome-attribution">
+              {decision.signal === 'hold'
+                ? 'HOLD is research-only and cannot be linked to a paper execution.'
+                : decision.signal === 'buy'
+                  ? 'Entry executions are not realized outcomes. Later exits are not attributed to this BUY decision without a lot-attribution model.'
+                  : 'Linked SELL P&L is the recorded simulated average-cost execution result, not proof of predictive accuracy or a complete round trip.'}
+            </p>
+          </>
+        )}
+        {error && <Notice tone="red">{error}</Notice>}
+        {fills?.trades.length ? (
+          <div className="table-scroll linked-fills-table">
+            <table>
+              <thead>
+                <tr>
+                  <th>Time (UTC)</th>
+                  <th>Wallet</th>
+                  <th>Simulated side</th>
+                  <th>Quantity</th>
+                  <th>Assumed fee</th>
+                  <th>Realized P&L</th>
+                </tr>
+              </thead>
+              <tbody>
+                {fills.trades.map((trade) => (
+                  <tr key={trade.id}>
+                    <td className="mono">{formatTime(trade.createdAt, true)}</td>
+                    <td>
+                      <Badge
+                        tone={trade.portfolioId === fills.currentPortfolioId ? 'purple' : 'neutral'}
+                      >
+                        {trade.portfolioId === fills.currentPortfolioId
+                          ? 'Current virtual wallet'
+                          : 'Archived virtual wallet'}
+                      </Badge>
+                    </td>
+                    <td>{trade.side.toUpperCase()}</td>
+                    <td className="mono">{formatNumber(trade.quantity, 8)}</td>
+                    <td className="mono">{formatMoney(trade.fee)}</td>
+                    <td className="mono">
+                      {trade.side === 'sell'
+                        ? formatMoney(trade.realizedPnl)
+                        : 'Not realized by entry'}
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+        ) : (
+          <p className="muted">
+            {busy
+              ? 'Reading recorded linked fills…'
+              : fills
+                ? 'No linked paper fills on this page.'
+                : 'Open this decision to read linked executions.'}
+          </p>
+        )}
+        {fills && fills.total > fills.pageSize && (
+          <div className="pagination">
+            <span>
+              Linked fills · page {page} of {Math.ceil(fills.total / fills.pageSize)} ·{' '}
+              {fills.total} total
+            </span>
+            <div>
+              <Button
+                variant="ghost"
+                disabled={busy || page <= 1}
+                onClick={() => setPage((n) => n - 1)}
+                aria-label="Previous linked fills"
+              >
+                <ChevronLeft size={14} />
+                Previous
+              </Button>
+              <Button
+                variant="ghost"
+                disabled={busy || page * fills.pageSize >= fills.total}
+                onClick={() => setPage((n) => n + 1)}
+                aria-label="Next linked fills"
+              >
+                Next
+                <ChevronRight size={14} />
+              </Button>
+            </div>
+          </div>
+        )}
+      </div>
+    </details>
+  );
+}
+export function DecisionHistory({
+  journal,
+  page,
+  onPage,
+  busy,
+  onResearch,
+}: {
+  journal: JournalView | null;
+  page: number;
+  onPage: (page: number) => void;
+  busy: boolean;
+  onResearch: () => void;
+}) {
+  return (
+    <Panel
+      title="Recorded research decisions"
+      description="Every displayed decision is matched against its complete local fill history, including archived virtual wallets. These are execution links, not claimed AI accuracy."
+    >
+      {journal?.decisions.length ? (
+        <div className="decisions-list">
+          {journal.decisions.map((decision) => (
+            <DecisionRow
+              key={decision.id}
+              decision={decision}
+              outcome={journal.outcomes?.[decision.id]}
+            />
+          ))}
+        </div>
+      ) : (
+        <Empty
+          icon={<ScrollText size={25} />}
+          title={busy ? 'Reading the decision journal' : 'Your reasoning belongs in the record'}
+          text="Signals are recorded with their explanation and risk. No autonomous learning or order execution is implied."
+          action={
+            <Button variant="secondary" onClick={onResearch}>
+              Open research lab
+              <ArrowRight size={14} />
+            </Button>
+          }
+        />
+      )}
+      {journal && journal.decisionCount > journal.decisionPageSize && (
+        <div className="pagination">
+          <span>
+            Decisions · page {page} of {Math.ceil(journal.decisionCount / journal.decisionPageSize)}{' '}
+            · {journal.decisionCount} total
+          </span>
+          <div>
+            <Button
+              variant="ghost"
+              disabled={busy || page <= 1}
+              onClick={() => onPage(page - 1)}
+              aria-label="Previous decisions"
+            >
+              <ChevronLeft size={14} />
+              Previous
+            </Button>
+            <Button
+              variant="ghost"
+              disabled={busy || page * journal.decisionPageSize >= journal.decisionCount}
+              onClick={() => onPage(page + 1)}
+              aria-label="Next decisions"
+            >
+              Next
+              <ChevronRight size={14} />
+            </Button>
+          </div>
+        </div>
+      )}
+    </Panel>
+  );
+}
+
+export function PaperPerformancePanel({ journal }: { journal: JournalView | null }) {
+  const performance = journal?.performance;
+  return (
+    <Panel
+      title="Recorded paper performance"
+      description="Entire current virtual wallet ledger, not just the 200 displayed fills. These are recorded simulations, never real account profits."
+    >
+      <div className="paper-performance-grid">
+        <div>
+          <span>All simulated fills</span>
+          <strong className="mono">{performance?.fills ?? '—'}</strong>
+        </div>
+        <div>
+          <span>Recorded SELL realized P&L</span>
+          <strong className="mono">{formatMoney(performance?.realizedPnl)}</strong>
+        </div>
+        <div>
+          <span>All assumed fees</span>
+          <strong className="mono">{formatMoney(performance?.assumedFees)}</strong>
+        </div>
+        <div>
+          <span>Profitable simulated SELL fills</span>
+          <strong className="mono">
+            {performance?.profitableSellPercent === null ||
+            performance?.profitableSellPercent === undefined
+              ? '—'
+              : `${formatNumber(performance.profitableSellPercent, 2)}%`}
+          </strong>
+        </div>
+      </div>
+      <p className="snapshot-foot">
+        {performance
+          ? `${performance.buys} BUY / ${performance.sells} SELL fills · ${performance.profitableSells} profitable, ${performance.losingSells} losing, ${performance.breakEvenSells} break-even SELL fills.`
+          : 'Unlock and load the private journal to read performance.'}{' '}
+        The SELL-fill rate is not a round-trip win rate, AI accuracy, or an expected return.
+      </p>
+    </Panel>
+  );
+}
