@@ -0,0 +1,136 @@
+import { useEffect, useState } from 'react';
+import { Database, Layers, LockKeyhole } from 'lucide-react';
+import type { CommonProps, MarketProps } from '../context';
+import { api, formatNumber, formatTime } from '../api';
+import { Badge, Empty, Notice, PageHeading, Panel } from '../components/ui';
+import { FuturesInsights } from '../components/FuturesInsights';
+import { MarketPanel, Watchlist } from '../components/Terminal';
+interface Depth {
+  symbol: string;
+  bids: [number, number][];
+  asks: [number, number][];
+  timestamp: number;
+}
+export function MarketsPage(props: CommonProps & MarketProps) {
+  const { venue, pair, market, notify } = props;
+  const [depth, setDepth] = useState<Depth | null>(null),
+    [error, setError] = useState('');
+  useEffect(() => {
+    setDepth(null);
+    setError('');
+    if (venue !== 'futures') return;
+    const controller = new AbortController();
+    api<{ data: Depth }>(
+      `/api/futures/depth?symbol=${encodeURIComponent(pair)}`,
+      'GET',
+      undefined,
+      controller.signal,
+    )
+      .then((r) => setDepth(r.data))
+      .catch((e) => {
+        if (!controller.signal.aborted) setError(e.message);
+      });
+    return () => controller.abort();
+  }, [venue, pair, market?.selected?.observedAt]);
+  return (
+    <>
+      <PageHeading
+        eyebrow="MARKET EXPLORER"
+        title="One exchange. A wider view"
+        description="Actual ZebPay Spot and Futures observations — no cross-exchange prices or inferred conversions."
+        actions={
+          <Badge tone="green">
+            <Database size={13} />
+            ZebPay data only
+          </Badge>
+        }
+      />
+      <div className="explorer-top">
+        <MarketPanel {...props} />
+        <Panel
+          title="Depth snapshot"
+          actions={<Badge>{venue === 'futures' ? 'FUTURES' : 'SPOT'}</Badge>}
+        >
+          {venue === 'spot' ? (
+            <Empty
+              icon={<LockKeyhole size={24} />}
+              title="Spot depth is unavailable"
+              text="Both the Spot book request and its saved example use an undefined baseUrl variable. The app does not silently repair it or substitute another endpoint."
+            />
+          ) : depth ? (
+            <div className="depth-content">
+              <div className="depth-columns">
+                <div>
+                  <div className="depth-label positive">BIDS</div>
+                  <div className="depth-header">
+                    <span>Price</span>
+                    <span>Quantity</span>
+                  </div>
+                  {depth.bids.slice(0, 8).map(([p, q], i) => (
+                    <div className="depth-row" key={i}>
+                      <span className="positive mono">{formatNumber(p, 6)}</span>
+                      <span className="mono">{formatNumber(q, 8)}</span>
+                    </div>
+                  ))}
+                </div>
+                <div>
+                  <div className="depth-label negative">ASKS</div>
+                  <div className="depth-header">
+                    <span>Price</span>
+                    <span>Quantity</span>
+                  </div>
+                  {depth.asks.slice(0, 8).map(([p, q], i) => (
+                    <div className="depth-row" key={i}>
+                      <span className="negative mono">{formatNumber(p, 6)}</span>
+                      <span className="mono">{formatNumber(q, 8)}</span>
+                    </div>
+                  ))}
+                </div>
+              </div>
+              <p className="depth-source">
+                Exchange timestamp {formatTime(depth.timestamp)} UTC · REST snapshot, not a stream
+              </p>
+            </div>
+          ) : (
+            <Empty
+              icon={<Layers size={24} />}
+              title="No depth data available"
+              text={
+                error ||
+                'A valid Futures symbol and an available public market feed are required. The book is not populated with sample orders.'
+              }
+            />
+          )}
+        </Panel>
+      </div>
+      {venue === 'futures' && (
+        <FuturesInsights key={pair} symbol={pair} observationTime={market?.selected?.observedAt} />
+      )}
+      <Watchlist {...props} expanded />
+      {venue === 'futures' && market?.selected && (
+        <div className="journal-stat-row futures-metadata">
+          <div>
+            <span>Exact symbol</span>
+            <strong className="mono">{market.selected.pair}</strong>
+          </div>
+          <div>
+            <span>makerFee · raw API value</span>
+            <strong className="mono">{formatNumber(market.selected.makerFeeRaw, 4)}</strong>
+          </div>
+          <div>
+            <span>takerFee · raw API value</span>
+            <strong className="mono">{formatNumber(market.selected.takerFeeRaw, 4)}</strong>
+          </div>
+          <Badge tone="amber">Fee units unspecified</Badge>
+        </div>
+      )}
+      {venue === 'futures' && (
+        <Notice tone="amber">
+          Futures public market metadata includes maker/taker fee fields. Their units are not
+          specified, so the app does not convert them to percentages or use them as verified
+          transaction costs. All private Futures features remain disabled.
+        </Notice>
+      )}
+    </>
+  );
+}
