+import express, { type ErrorRequestHandler } from 'express';
+import helmet from 'helmet';
+import { rateLimit } from 'express-rate-limit';
+import { z } from 'zod';
+import { SOURCE_NAME, SOURCE_SHA256, CAPABILITIES, LIVE_BLOCKERS } from '../shared/capabilities.js';
+import collectionAudit from '../docs/collection-audit.json' with { type: 'json' };
+import type { Config } from './config.js';
+import { Store } from './store.js';
+import { CredentialVault } from './vault.js';
+import { Sessions } from './auth.js';
+import { ZebpayClient, type Fetcher } from './zebpay.js';
+import { ConnectionManager } from './connection.js';
+import { MarketService } from './markets.js';
+import { PaperEngine } from './paper.js';
+import { ResearchEngine } from './research.js';
+import { LiveSafety } from './live-safety.js';
+import { JournalService } from './journal.js';
+import { AppError, safeError } from './errors.js';
+import { parse, spotPair, futuresSymbol, money } from './validation.js';
+
+export function createApplication(
+  config: Config,
+  options: { fetcher?: Fetcher; now?: () => number; timeoutMs?: number } = {},
+) {
+  const now = options.now ?? Date.now;
+  const store = new Store(config.dataDir, config.masterKey);
+  const vault = new CredentialVault(config.dataDir, config.masterKey);
+  const client = new ZebpayClient(options.fetcher, now, options.timeoutMs);
+  const sessions = new Sessions(config, now);
+  const connection = new ConnectionManager(vault, client, store, now);
+  const markets = new MarketService(client, store, now);
+  const paper = new PaperEngine(store, markets, now);
+  const research = new ResearchEngine(store, now);
+  const live = new LiveSafety(store);
+  const journal = new JournalService(store);
+  const app = express();
+  app.disable('x-powered-by');
+  app.set('trust proxy', 1); // Deploy behind exactly one trusted HTTPS reverse proxy.
+  app.use(
+    helmet({
+      contentSecurityPolicy: {
+        directives: {
+          defaultSrc: ["'self'"],
+          scriptSrc: ["'self'", ...(!config.production ? ["'unsafe-inline'"] : [])],
+          styleSrc: ["'self'", "'unsafe-inline'"],
+          fontSrc: ["'self'"],
+          imgSrc: ["'self'", 'data:'],
+          connectSrc: [
+            "'self'",
+            ...(!config.production
+              ? ['wss://*.e2b.app', 'ws://localhost:*', 'ws://127.0.0.1:*']
+              : []),
+          ],
+          objectSrc: ["'none'"],
+          frameAncestors: ["'self'", 'https://*.arena.ai', 'https://arena.ai', 'https://*.e2b.app'],
+          upgradeInsecureRequests: config.production ? [] : null,
+        },
+      },
+      // The live preview is embedded by Arena. CSP explicitly limits permitted parents.
+      xFrameOptions: false,
+      strictTransportSecurity: config.production
+        ? { maxAge: 31536000, includeSubDomains: true }
+        : false,
+    }),
+  );
+  // Apply before development middleware OR production static/SPA fallbacks.
+  // Even absent private paths return 404, never source or a misleading HTML 200.
+  app.use((req, res, next) => {
+    let path: string;
+    try {
+      path = decodeURIComponent(req.path);
+    } catch {
+      res.status(400).end();
+      return;
+    }
+    if (
+      /(?:^|\/)(?:\.runtime|\.git|\.github|server|scripts|tests|docs)(?:\/|$)/i.test(path) ||
+      /(?:^|\/)\.env(?:[.\/~]|$)/i.test(path) ||
+      /\/(?:[^/]*\.(?:sqlite(?:-[^/]*)?|db(?:-[^/]*)?|enc|key|pem|crt|p12|pfx)|owner\.json|[^/]*\.postman_collection[^/]*\.json)$/i.test(
+        path,
+      )
+    ) {
+      res.status(404).set('Cache-Control', 'no-store').type('text').send('Not found');
+      return;
+    }
+    next();
+  });
+  app.use('/api', (_req, res, next) => {
+    res.set('Cache-Control', 'no-store, private');
+    res.set('Pragma', 'no-cache');
+    next();
+  });
+  app.use(
+    '/api',
+    rateLimit({
+      windowMs: 60000,
+      limit: 240,
+      standardHeaders: 'draft-8',
+      legacyHeaders: false,
+      message: {
+        error: {
+          code: 'WORKSPACE_RATE_LIMIT',
+          message: 'Too many workspace reads. Wait a minute and try again.',
+        },
+      },
+    }),
+  );
+  app.use('/api', express.json({ limit: '16kb', strict: true }));
+  app.use('/api', sessions.csrf);
+  const loginLimiter = rateLimit({
+    windowMs: 15 * 60000,
+    limit: 6,
+    standardHeaders: 'draft-8',
+    legacyHeaders: false,
+    message: {
+      error: {
+        code: 'LOGIN_RATE_LIMIT',
+        message: 'Too many login attempts. Wait 15 minutes before trying again.',
+      },
+    },
+  });
+  const credentialTls: express.RequestHandler = (req, _res, next) => {
+    if (!req.secure && !['localhost', '127.0.0.1', '[::1]'].includes(req.hostname)) {
+      next(
+        new AppError(
+          'HTTPS_REQUIRED',
+          'API credentials may be entered only over HTTPS, or on your own localhost development server.',
+          426,
+        ),
+      );
+      return;
+    }
+    next();
+  };
+
+  app.get('/api/session', (req, res) => res.json(sessions.info(req, res)));
+  app.post('/api/session/login', loginLimiter, credentialTls, async (req, res) => {
+    const input = parse(z.object({ password: z.string().min(1).max(256) }).strict(), req.body);
+    try {
+      const info = await sessions.login(req, res, input.password);
+      store.audit('owner_logged_in');
+      res.json(info);
+    } catch (e) {
+      store.audit('owner_login_failed');
+      throw e;
+    }
+  });
+  app.post('/api/session/logout', sessions.owner, (req, res) => {
+    connection.shutdown();
+    store.audit('owner_logged_out');
+    res.json(sessions.logout(req, res));
+  });
+  app.get('/api/health', (_req, res) =>
+    res.json({ status: 'ok', mode: 'paper', liveEnabled: false }),
+  );
+  app.get('/api/capabilities', (_req, res) =>
+    res.json({
+      source: SOURCE_NAME,
+      sha256: SOURCE_SHA256,
+      capabilities: CAPABILITIES,
+      liveBlockers: LIVE_BLOCKERS,
+      requests: 38,
+      savedResponses: 30,
+    }),
+  );
+  app.get('/api/collection', (_req, res) =>
+    res.json({
+      source: SOURCE_NAME,
+      sha256: SOURCE_SHA256,
+      requests: collectionAudit.requestCount,
+      endpoints: collectionAudit.endpoints.map((e) => ({
+        number: e.number,
+        location: e.location,
+        method: e.method,
+        url: e.url,
+        support: e.support,
+        implementation: e.implementation,
+        reason: e.reason,
+        conflicts: e.documentationConflicts,
+        responseExamples: e.responseExampleCount,
+      })),
+    }),
+  );
+  app.get('/api/market', async (req, res) => {
+    const input = parse(
+      z
+        .object({
+          venue: z.enum(['spot', 'futures']),
+          pair: z.string().max(40),
+          range: z.enum(['1h', '6h', '24h', 'all']).default('1h'),
+        })
+        .strict(),
+      req.query,
+    );
+    parse(input.venue === 'spot' ? spotPair : futuresSymbol, input.pair);
+    res.json(await markets.view(input.venue, input.pair, input.range));
+  });
+  app.get('/api/futures/depth', async (req, res) => {
+    const { symbol } = parse(z.object({ symbol: futuresSymbol }).strict(), req.query);
+    res.json({
+      status: 'available',
+      source: 'Futures / Market / Get Depth update',
+      data: await markets.futuresDepth(symbol),
+    });
+  });
+  app.get('/api/futures/snapshot', async (req, res) => {
+    const { symbol } = parse(z.object({ symbol: futuresSymbol }).strict(), req.query);
+    res.json(await markets.futuresSnapshot(symbol));
+  });
+  app.get('/api/futures/health', async (req, res) => {
+    parse(z.object({}).strict(), req.query);
+    res.json(await markets.futuresHealth());
+  });
+  app.get('/api/futures/rules', async (_req, res) =>
+    res.json({
+      data: await markets.futuresRules(),
+      feeUnits: 'not specified in collection',
+      liveEnabled: false,
+    }),
+  );
+
+  app.get('/api/workspace', sessions.owner, (_req, res) =>
+    res.json({
+      connection: connection.status(),
+      risk: store.risk(),
+      paper: paper.view(),
+      liveEnabled: false,
+      liveBlockers: live.blockers,
+    }),
+  );
+  app.get('/api/connection', sessions.owner, (_req, res) => res.json(connection.status()));
+  app.post('/api/connection', sessions.owner, credentialTls, async (req, res) => {
+    const input = parse(
+      z
+        .object({
+          apiKey: z
+            .string()
+            .min(1)
+            .max(512)
+            .refine((s) => !/[\r\n]/.test(s)),
+          apiSecret: z.string().min(1).max(2048),
+          ipStatus: z.enum(['unknown', 'confirmed', 'not_configured']),
+        })
+        .strict(),
+      req.body,
+    );
+    res.json(await connection.connect(input.apiKey, input.apiSecret, input.ipStatus));
+  });
+  app.post('/api/connection/verify', sessions.owner, async (_req, res) =>
+    res.json(await connection.verifySaved()),
+  );
+  app.post('/api/connection/disconnect', sessions.owner, (_req, res) =>
+    res.json(connection.disconnect()),
+  );
+
+  app.get('/api/account/balances', sessions.owner, (_req, res) =>
+    res.json({
+      status: 'unavailable',
+      balance: null,
+      availableFunds: null,
+      reason:
+        'The collection defines Spot trade/wallet balance requests but no response schema. Futures private authentication is unresolved. No balance fields are inferred or fetched.',
+    }),
+  );
+  app.get('/api/account/fees', sessions.owner, (_req, res) =>
+    res.json({
+      status: 'unavailable',
+      fee: null,
+      reason:
+        'The Spot TDS and Fees response format and fee units are absent. Simulation costs are not actual exchange fees.',
+    }),
+  );
+  app.get('/api/account/positions', sessions.owner, (_req, res) =>
+    res.json({
+      status: 'unavailable',
+      positions: null,
+      pnl: null,
+      reason:
+        'Futures positions are described, but Futures-specific private authentication is not verified. No authenticated Futures request is made.',
+    }),
+  );
+  app.get('/api/orders', sessions.owner, async (req, res) => {
+    const input = parse(
+      z
+        .object({
+          pair: spotPair,
+          status: z.enum(['pending', 'complete']),
+          page: z.coerce.number().int().min(1).max(10000).default(1),
+        })
+        .strict(),
+      req.query,
+    );
+    res.json({
+      data: await connection.orders(input.pair, input.status, input.page),
+      page: input.page,
+      pageSize: 500,
+      source: 'ZebPay Spot · signed GET /orders',
+      note: 'Returned order status is shown verbatim. The collection Complete example itself contains pending status; filter membership never proves execution.',
+    });
+  });
+  app.get('/api/orders/reconcile', sessions.owner, async (req, res) => {
+    const input = parse(
+      z.object({ pair: spotPair, orderId: z.string().regex(/^[1-9]\d{0,14}$/) }).strict(),
+      req.query,
+    );
+    // Supported read-only filters only. Absence is NOT proof of non-execution.
+    const pending = await connection.orders(input.pair, 'pending', 1, input.orderId);
+    const complete = await connection.orders(input.pair, 'complete', 1, input.orderId);
+    const rows = [...pending, ...complete].filter((o) => String(o.id) === input.orderId);
+    res.json({
+      status: rows.length ? 'observed' : 'unresolved',
+      observations: rows,
+      message: rows.length
+        ? 'Review the actual returned statuses. No submission or retry is performed.'
+        : 'No matching order was found. Its execution status is unresolved; do not resubmit blindly.',
+    });
+  });
+  app.delete('/api/orders/:id', sessions.owner, (_req, _res) => {
+    store.audit('cancel_order_blocked', { reasonCode: 'DELETE_SIGNING_UNDEFINED' });
+    throw new AppError(
+      'CANCEL_UNSUPPORTED',
+      'The collection does not specify DELETE signing or a cancellation response. Cancel directly in ZebPay; this app did not send a cancellation.',
+      422,
+    );
+  });
+  app.get('/api/paper/request/:id', sessions.owner, (req, res) => {
+    const id = parse(z.uuid(), req.params.id);
+    const match = store.findRequest(id);
+    res.json(
+      match ? { status: 'filled', trade: match.trade } : { status: 'not_observed', trade: null },
+    );
+  });
+  app.post('/api/orders', sessions.owner, async (req, res) => {
+    if (req.body?.mode === 'live') live.rejectOrder();
+    res.status(201).json(await paper.execute(req.body));
+  });
+  app.post('/api/live/enable', sessions.owner, (req, _res) => {
+    const input = parse(z.object({ confirmation: z.string() }).strict(), req.body);
+    live.requestEnable(input.confirmation);
+  });
+  app.post('/api/live/disable', sessions.owner, (_req, res) =>
+    res.json({ mode: 'paper', liveEnabled: false }),
+  );
+
+  app.post('/api/risk', sessions.owner, (req, res) => {
+    const input = parse(
+      z
+        .object({
+          maximumOrderInr: money,
+          dailyLossInr: money,
+          feeBps: z.number().int().min(0).max(500),
+          slippageBps: z.number().int().min(0).max(500),
+        })
+        .strict(),
+      req.body,
+    );
+    if (Number(input.maximumOrderInr) > 1000000 || Number(input.dailyLossInr) > 1000000)
+      throw new AppError(
+        'LIMIT_TOO_LARGE',
+        'Application risk limits must not exceed ₹10,00,000. These are paper-only limits.',
+      );
+    store.transaction(() => {
+      store.set('risk', { ...store.risk(), ...input });
+      store.audit('risk_limits_updated', input);
+    });
+    res.json(store.risk());
+  });
+  app.post('/api/kill-switch', sessions.owner, (req, res) => {
+    const input = parse(
+      z.object({ enabled: z.boolean(), confirmation: z.string().optional() }).strict(),
+      req.body,
+    );
+    if (!input.enabled && input.confirmation !== 'RESET KILL SWITCH')
+      throw new AppError(
+        'CONFIRMATION_REQUIRED',
+        'Type RESET KILL SWITCH to resume paper execution. Live trading will remain disabled.',
+        409,
+      );
+    store.transaction(() => {
+      store.set('risk', { ...store.risk(), killSwitch: input.enabled });
+      store.audit(input.enabled ? 'emergency_stop_activated' : 'emergency_stop_reset');
+    });
+    if (input.enabled) connection.shutdown();
+    res.json({
+      risk: store.risk(),
+      liveEnabled: false,
+      message:
+        'This does not cancel existing exchange orders. Manage existing orders directly in ZebPay.',
+    });
+  });
+  app.post('/api/paper/reset', sessions.owner, (req, res) => {
+    const input = parse(
+      z.object({ confirmation: z.string(), startingCash: money }).strict(),
+      req.body,
+    );
+    if (Number(input.startingCash) > 10000000)
+      throw new AppError(
+        'PAPER_ALLOCATION_LIMIT',
+        'Use at most ₹1,00,00,000 of explicitly virtual capital.',
+      );
+    res.json(paper.reset(input.confirmation, input.startingCash));
+  });
+  app.get('/api/research/latest', sessions.owner, (req, res) => {
+    const { venue, pair } = parse(
+      z.object({ venue: z.enum(['spot', 'futures']), pair: z.string().max(40) }).strict(),
+      req.query,
+    );
+    parse(venue === 'spot' ? spotPair : futuresSymbol, pair);
+    res.json({
+      decision: store.latestDecision(venue, pair),
+      backtest: venue === 'spot' ? store.latestBacktest(pair) : null,
+    });
+  });
+  app.post('/api/research/analyze', sessions.owner, (req, res) => {
+    const input = parse(
+      z.object({ venue: z.enum(['spot', 'futures']), pair: z.string().max(40) }).strict(),
+      req.body,
+    );
+    parse(input.venue === 'spot' ? spotPair : futuresSymbol, input.pair);
+    res.json(research.analyze(input.venue, input.pair));
+  });
+  app.post('/api/research/backtest', sessions.owner, (req, res) => {
+    const input = parse(z.object({ venue: z.literal('spot'), pair: spotPair }).strict(), req.body);
+    res.json(research.runBacktest(input.pair));
+  });
+  const localPage = z.coerce.number().int().min(1).max(100000).default(1);
+  app.get('/api/journal', sessions.owner, (req, res) => {
+    const { decisionPage } = parse(z.object({ decisionPage: localPage }).strict(), req.query);
+    res.json(journal.view(decisionPage));
+  });
+  app.get('/api/journal/decisions/:id/fills', sessions.owner, (req, res) => {
+    const { id } = parse(z.object({ id: z.uuid() }).strict(), req.params);
+    const { page } = parse(z.object({ page: localPage }).strict(), req.query);
+    res.json(journal.fills(id, page));
+  });
+
+  app.use('/api', (_req, _res, next) =>
+    next(
+      new AppError(
+        'NOT_FOUND',
+        'This workspace operation does not exist. No exchange request was sent.',
+        404,
+      ),
+    ),
+  );
+  const errors: ErrorRequestHandler = (error: unknown, _req, res, _next) => {
+    const safe =
+      error instanceof SyntaxError
+        ? new AppError('INVALID_JSON', 'The request body is not valid JSON.')
+        : typeof error === 'object' &&
+            error !== null &&
+            'type' in error &&
+            error.type === 'entity.too.large'
+          ? new AppError('BODY_TOO_LARGE', 'The request exceeds the safe input limit.', 413)
+          : safeError(error);
+    // Intentionally no request/body/upstream logging. Respond only with curated errors.
+    res.status(safe.status).json({ error: { code: safe.code, message: safe.publicMessage } });
+  };
+  app.use(errors);
+  return {
+    app,
+    store,
+    vault,
+    connection,
+    markets,
+    paper,
+    research,
+    live,
+    journal,
+    close: () => {
+      connection.shutdown();
+      store.close();
+    },
+  };
+}
diff --git a/server/auth.ts b/server/auth.ts
new file mode 100644
index 0000000..e8e26c8
--- /dev/null
+++ b/server/auth.ts
@@ -0,0 +1,158 @@
+import { randomBytes, scrypt, timingSafeEqual } from 'node:crypto';
+import { promisify } from 'node:util';
+import type { Request, Response, NextFunction } from 'express';
+import type { SessionInfo } from '../shared/types.js';
+import type { Config } from './config.js';
+import { AppError } from './errors.js';
+
+const derive = promisify(scrypt);
+interface SessionRecord {
+  id: string;
+  csrf: string;
+  owner: boolean;
+  created: number;
+  touched: number;
+}
+export async function verifyPassword(password: string, encoded: string): Promise<boolean> {
+  try {
+    const [scheme, salt, hash] = encoded.split(':');
+    if (scheme !== 'scrypt' || !/^[a-f0-9]{32}$/.test(salt) || !/^[a-f0-9]{128}$/.test(hash))
+      return false;
+    const actual = (await derive(password, Buffer.from(salt, 'hex'), 64)) as Buffer;
+    const expected = Buffer.from(hash, 'hex');
+    return timingSafeEqual(actual, expected);
+  } catch {
+    return false;
+  }
+}
+export class Sessions {
+  private records = new Map<string, SessionRecord>();
+  constructor(
+    private config: Config,
+    private now: () => number = Date.now,
+  ) {}
+  private name(req: Request): string {
+    return req.secure || this.config.production ? '__Host-ddq' : 'ddq_session';
+  }
+  private token(req: Request): string | undefined {
+    const name = this.name(req);
+    return req.headers.cookie
+      ?.split(';')
+      .map((s) => s.trim())
+      .find((s) => s.startsWith(`${name}=`))
+      ?.slice(name.length + 1);
+  }
+  private create(req: Request, res: Response, owner = false): SessionRecord {
+    const now = this.now();
+    const session = {
+      id: randomBytes(32).toString('hex'),
+      csrf: randomBytes(32).toString('hex'),
+      owner,
+      created: now,
+      touched: now,
+    };
+    this.records.set(session.id, session);
+    res.cookie(this.name(req), session.id, {
+      httpOnly: true,
+      secure: req.secure || this.config.production,
+      sameSite: 'strict',
+      path: '/',
+      maxAge: 8 * 60 * 60 * 1000,
+    });
+    return session;
+  }
+  get(req: Request, res: Response): SessionRecord {
+    const now = this.now();
+    for (const [id, item] of this.records)
+      if (now - item.touched > 30 * 60 * 1000 || now - item.created > 8 * 60 * 60 * 1000)
+        this.records.delete(id);
+    const id = this.token(req);
+    let session = id ? this.records.get(id) : undefined;
+    if (!session) session = this.create(req, res);
+    session.touched = now;
+    return session;
+  }
+  info(req: Request, res: Response): SessionInfo {
+    const session = this.get(req, res);
+    return {
+      authenticated: session.owner,
+      configured: Boolean(this.config.ownerHash),
+      csrfToken: session.csrf,
+    };
+  }
+  csrf = (req: Request, res: Response, next: NextFunction): void => {
+    if (['GET', 'HEAD', 'OPTIONS'].includes(req.method)) {
+      next();
+      return;
+    }
+    const expected = this.config.publicOrigin ?? `${req.protocol}://${req.get('host')}`;
+    if (req.get('origin') !== expected || req.get('sec-fetch-site') === 'cross-site') {
+      next(
+        new AppError(
+          'ORIGIN_REJECTED',
+          'This action must originate from your secured workspace.',
+          403,
+        ),
+      );
+      return;
+    }
+    const session = this.get(req, res);
+    const supplied = req.get('x-csrf-token');
+    if (
+      !supplied ||
+      !/^[a-f0-9]{64}$/.test(supplied) ||
+      !timingSafeEqual(Buffer.from(supplied), Buffer.from(session.csrf))
+    ) {
+      next(
+        new AppError(
+          'CSRF_REJECTED',
+          'Your security session expired. Reload the workspace and try again.',
+          403,
+        ),
+      );
+      return;
+    }
+    if (!req.is('application/json')) {
+      next(new AppError('JSON_REQUIRED', 'Send workspace actions as JSON.', 415));
+      return;
+    }
+    next();
+  };
+  owner = (req: Request, res: Response, next: NextFunction): void => {
+    if (!this.get(req, res).owner) {
+      next(
+        new AppError(
+          'OWNER_REQUIRED',
+          'Unlock the owner workspace before accessing account data or changing settings.',
+          401,
+        ),
+      );
+      return;
+    }
+    next();
+  };
+  async login(req: Request, res: Response, password: string): Promise<SessionInfo> {
+    if (!this.config.ownerHash)
+      throw new AppError(
+        'OWNER_NOT_CONFIGURED',
+        'Run npm run setup in your own terminal, then restart the server. Never enter ZebPay credentials in setup or chat.',
+        503,
+      );
+    if (password.length > 256 || !(await verifyPassword(password, this.config.ownerHash)))
+      throw new AppError('LOGIN_FAILED', 'The workspace password was not accepted.', 401);
+    const previous = this.token(req);
+    if (previous) this.records.delete(previous);
+    const session = this.create(req, res, true);
+    return { authenticated: true, configured: true, csrfToken: session.csrf };
+  }
+  logout(req: Request, res: Response): SessionInfo {
+    const id = this.token(req);
+    if (id) this.records.delete(id);
+    const session = this.create(req, res);
+    return {
+      authenticated: false,
+      configured: Boolean(this.config.ownerHash),
+      csrfToken: session.csrf,
+    };
+  }
+}
