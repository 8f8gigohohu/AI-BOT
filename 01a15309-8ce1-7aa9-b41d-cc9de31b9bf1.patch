+    expect(results.map((r) => r.status)).toEqual([201, 201]);
+    expect(results.map((r) => r.body.replayed).sort()).toEqual([false, true]);
+    expect(results[0].body.trade.id).toBe(results[1].body.trade.id);
+    expect(t.store.trades(t.store.wallet().portfolioId)).toHaveLength(1);
+    expect((await o.get(`/api/paper/request/${order.requestId}`)).body.status).toBe('filled');
+  });
+  it('rejects id reuse with a changed payload and a second identical order inside 30 seconds', async () => {
+    const t = makeTestApp();
