+                </div>
+                <div className="form-actions">
+                  <Button type="submit" disabled={!canEnter || !apiKey || !apiSecret} busy={busy}>
+                    <Link2 size={15} />
+                    {connected ? 'Replace & verify connection' : 'Connect & verify'}
+                    <ArrowRight size={15} />
+                  </Button>
+                  {connection?.hasStoredCredentials && (
+                    <Button type="button" variant="secondary" disabled={busy} onClick={verify}>
+                      Verify saved connection
+                    </Button>
+                  )}
+                </div>
+              </form>
+              {connection?.hasStoredCredentials && (
+                <div className="disconnect-row">
+                  <span>Disconnect removes the encrypted credential record.</span>
+                  <Button variant="ghost" onClick={() => setShowDisconnect(true)} disabled={busy}>
+                    <Unplug size={14} />
+                    Disconnect
+                  </Button>
+                </div>
+              )}
+            </div>
+          </Panel>
+        </div>
+        <div className="connection-aside">
+          <Panel title="Access, at a glance" className="permissions-panel">
+            <div className="permission-list">
+              <Permission label="Public market data" status="No key needed" good />
+              <Permission
+                label="Spot order reads"
+                status={connected ? 'Verified' : 'Not verified'}
+                good={connected}
+              />
+              <Permission label="API trading permission" status="Not verifiable" />
+              <Permission
+                label="IP-whitelist status"
+                status={
+                  connection?.ipStatus === 'confirmed' ? 'User-reported only' : 'Not verified'
+                }
+              />
+              <Permission label="Spot balances & fees" status="Schema missing" />
+              <Permission label="Futures private access" status="Disabled" />
