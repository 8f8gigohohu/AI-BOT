new file mode 100644
index 0000000..e17b74a
--- /dev/null
+++ b/server/config.ts
@@ -0,0 +1,109 @@
+import { existsSync, readFileSync, mkdirSync, writeFileSync, chmodSync } from 'node:fs';
+import { randomBytes } from 'node:crypto';
+import { resolve, sep } from 'node:path';
+
+export interface Config {
+  dataDir: string;
+  masterKey: Buffer;
+  ownerHash: string | null;
+  publicOrigin: string | null;
+  production: boolean;
+}
+// Pure validation: tests can exercise even '/' or '.git' without ever writing there.
+export function assertPrivateDataDir(dataDir: string, appDir = resolve('.')): void {
+  const reserved = [
+    'public',
+    'dist',
+    'src',
+    'server',
+    'shared',
+    'tests',
+    'scripts',
+    'docs',
+    '.git',
+    '.github',
+    'node_modules',
+  ];
+  if (
+    dataDir === appDir ||
+    appDir.startsWith(dataDir.endsWith(sep) ? dataDir : dataDir + sep) ||
+    reserved.some((name) => {
+      const path = resolve(appDir, name);
+      return dataDir === path || dataDir.startsWith(path + sep);
+    })
+  )
+    throw new Error(
+      'DARKDEVIL_DATA_DIR must be a dedicated private directory, not an application, source, or public directory.',
+    );
+}
+export function loadConfig(): Config {
+  process.umask(0o077);
+  const production = process.env.NODE_ENV === 'production';
+  const dataDir = resolve(process.env.DARKDEVIL_DATA_DIR ?? '.runtime');
+  // Never put keys, the vault, or the financial database in served/source folders.
+  assertPrivateDataDir(dataDir);
+  mkdirSync(dataDir, { recursive: true, mode: 0o700 });
+  chmodSync(dataDir, 0o700);
+  let masterKey: Buffer;
+  if (process.env.DARKDEVIL_MASTER_KEY) {
+    const encoded = process.env.DARKDEVIL_MASTER_KEY;
+    masterKey = Buffer.from(encoded, 'base64');
+    if (masterKey.length !== 32 || masterKey.toString('base64') !== encoded)
+      throw new Error(
+        'DARKDEVIL_MASTER_KEY must be canonical base64 encoding of exactly 32 bytes.',
+      );
+  } else {
+    if (production)
+      throw new Error('Production requires DARKDEVIL_MASTER_KEY from a backend secret manager.');
+    const keyFile = resolve(dataDir, 'master.key');
+    if (!existsSync(keyFile)) {
+      if (existsSync(resolve(dataDir, 'zebpay.enc')))
+        throw new Error(
+          'An existing vault has no local master key. Restore its original protected key; no replacement key was generated.',
+        );
+      writeFileSync(keyFile, randomBytes(32), { mode: 0o600, flag: 'wx' });
+    }
+    chmodSync(keyFile, 0o600);
+    masterKey = readFileSync(keyFile);
+    if (masterKey.length !== 32)
+      throw new Error(
+        'Invalid local master key. Restore the original protected key; do not overwrite an existing vault.',
+      );
+  }
+  let ownerHash = process.env.DARKDEVIL_OWNER_HASH || null;
+  const ownerFile = resolve(dataDir, 'owner.json');
+  if (!ownerHash && existsSync(ownerFile)) {
+    try {
+      const owner = JSON.parse(readFileSync(ownerFile, 'utf8')) as { passwordHash?: unknown };
+      if (typeof owner.passwordHash !== 'string') throw new Error('invalid');
+      ownerHash = owner.passwordHash;
+      chmodSync(ownerFile, 0o600);
+    } catch {
+      throw new Error(
+        'Invalid owner configuration. Run owner setup again in your private terminal.',
+      );
+    }
+  }
+  if (ownerHash && !/^scrypt:[a-f0-9]{32}:[a-f0-9]{128}$/.test(ownerHash))
+    throw new Error('Invalid owner password hash. Run owner setup again in your private terminal.');
+  const publicOrigin = process.env.DARKDEVIL_PUBLIC_ORIGIN ?? null;
+  if (publicOrigin) {
+    let valid = false;
+    try {
+      const url = new URL(publicOrigin);
+      valid =
+        ['http:', 'https:'].includes(url.protocol) &&
+        url.origin === publicOrigin &&
+        (!production || url.protocol === 'https:');
+    } catch {
+      /* Curated error below; do not echo configuration values. */
+    }
+    if (!valid)
+      throw new Error(
+        'Set DARKDEVIL_PUBLIC_ORIGIN to an exact HTTPS origin, without a trailing slash.',
+      );
+  }
+  if (production && (!publicOrigin || !ownerHash))
+    throw new Error('Production requires an exact HTTPS DARKDEVIL_PUBLIC_ORIGIN and owner setup.');
+  return { dataDir, masterKey, ownerHash, publicOrigin, production };
+}
diff --git a/server/connection.ts b/server/connection.ts
new file mode 100644
index 0000000..2118d43
--- /dev/null
+++ b/server/connection.ts
@@ -0,0 +1,169 @@
+import type { ConnectionStatus, IpStatus, Order } from '../shared/types.js';
+import { CredentialVault, type Credentials } from './vault.js';
+import { ZebpayClient } from './zebpay.js';
+import { Store } from './store.js';
+import { AppError, safeError } from './errors.js';
+
+export class ConnectionManager {
+  private epoch = 0;
+  private active = new Set<AbortController>();
+  private current: ConnectionStatus;
+  constructor(
+    private vault: CredentialVault,
+    private client: ZebpayClient,
+    private store: Store,
+    private now: () => number = Date.now,
+  ) {
+    this.current = this.base(vault.has() ? 'saved' : 'disconnected');
+  }
+  private base(status: ConnectionStatus['status']): ConnectionStatus {
+    return {
+      status,
+      hasStoredCredentials: this.vault.has(),
+      maskedKey: this.vault.has() ? '••••••••••••' : null,
+      verifiedAt: null,
+      ipStatus: 'unknown',
+      ipVerifiedByApi: false,
+      readPermission: 'unverified',
+      tradePermission: 'unverifiable',
+      message:
+        status === 'saved'
+          ? 'Encrypted credentials are stored. Verify read access again; restarts never restore an active connection automatically.'
+          : 'No active exchange connection. Public market reads and isolated paper research remain available.',
+    };
+  }
+  status(): ConnectionStatus {
+    return { ...this.current, hasStoredCredentials: this.vault.has() };
+  }
+  private invalidate(): number {
+    this.epoch += 1;
+    for (const controller of this.active) controller.abort();
+    this.active.clear();
+    return this.epoch;
+  }
+  async connect(apiKey: string, apiSecret: string, ipStatus: IpStatus): Promise<ConnectionStatus> {
+    const epoch = this.invalidate();
+    this.vault.clear();
+    return this.verifyCredentials({ apiKey, apiSecret, ipStatus }, epoch);
+  }
+  async verifySaved(): Promise<ConnectionStatus> {
+    const credentials = this.vault.read();
+    if (!credentials)
+      throw new AppError(
+        'NO_SAVED_CREDENTIALS',
+        'Enter your API credentials on the secured connection page first.',
+        409,
+      );
+    return this.verifyCredentials(credentials, this.invalidate());
+  }
+  private async verifyCredentials(
+    credentials: Credentials,
+    epoch: number,
+  ): Promise<ConnectionStatus> {
+    const controller = new AbortController();
+    this.active.add(controller);
+    this.current = {
+      ...this.base('verifying'),
+      ipStatus: credentials.ipStatus,
+      message:
+        'Verifying with the documented, read-only pending-orders request. No order is being submitted.',
+    };
+    try {
+      await this.client.orders(credentials, 'BTC-INR', 'pending', 1, '0', controller.signal);
+      if (this.epoch !== epoch)
+        throw new AppError('REQUEST_CANCELLED', 'The connection changed during verification.', 409);
+      this.vault.save(credentials);
+      this.current = {
+        ...this.base('connected'),
+        ipStatus: credentials.ipStatus,
+        verifiedAt: this.now(),
+        readPermission: 'verified',
+        message:
+          'Connected · Spot order-read access verified. Balances, trading permissions, and IP-whitelist status cannot be verified from this collection. Live trading remains blocked.',
+      };
+      this.store.audit('connection_verified', {
+        operation: 'spot.pending',
+        ipStatus: credentials.ipStatus,
+      });
+      return this.status();
+    } catch (error) {
+      const safe = safeError(error);
+      if (this.epoch === epoch) {
+        this.current = {
+          ...this.base(safe.code === 'PERMISSION_MISSING' ? 'permission_missing' : 'failed'),
+          ipStatus: credentials.ipStatus,
+          message: safe.publicMessage,
+        };
+        this.store.audit('connection_failed', { reasonCode: safe.code });
+      }
+      throw safe;
+    } finally {
+      this.active.delete(controller);
+    }
+  }
+  async orders(
+    pair: string,
+    status: 'pending' | 'complete',
+    page: number,
+    orderId = '0',
+  ): Promise<Order[]> {
+    if (this.current.status !== 'connected')
+      throw new AppError('NOT_CONNECTED', 'Verify the read-only ZebPay connection first.', 409);
+    const credentials = this.vault.read();
+    if (!credentials) {
+      this.disconnect();
+      throw new AppError(
+        'NOT_CONNECTED',
+        'The stored credentials were removed. Reconnect securely.',
+        409,
+      );
+    }
+    const epoch = this.epoch;
+    const controller = new AbortController();
+    this.active.add(controller);
+    try {
+      const orders = await this.client.orders(
+        credentials,
+        pair,
+        status,
+        page,
+        orderId,
+        controller.signal,
+      );
+      if (epoch !== this.epoch)
+        throw new AppError(
+          'REQUEST_CANCELLED',
+          'Disconnected reads are not returned to the workspace.',
+          409,
+        );
+      this.store.audit('order_read', { pair, operation: status, count: orders.length });
+      return orders;
+    } catch (error) {
+      if (
+        error instanceof AppError &&
+        ['AUTH_FAILED', 'PERMISSION_MISSING'].includes(error.code) &&
+        epoch === this.epoch
+      ) {
+        this.invalidate();
+        this.current = {
+          ...this.base(error.code === 'PERMISSION_MISSING' ? 'permission_missing' : 'failed'),
+          message: error.publicMessage,
+        };
+      }
+      throw error;
+    } finally {
+      this.active.delete(controller);
+    }
+  }
+  disconnect(): ConnectionStatus {
+    this.invalidate();
+    this.vault.clear();
+    this.current = this.base('disconnected');
+    this.store.audit('connection_disconnected');
+    return this.status();
+  }
+  shutdown(): void {
+    this.invalidate();
+    this.current = this.base(this.vault.has() ? 'saved' : 'disconnected');
+  }
+}
diff --git a/server/errors.ts b/server/errors.ts
new file mode 100644
index 0000000..166b704
--- /dev/null
+++ b/server/errors.ts
@@ -0,0 +1,18 @@
+export class AppError extends Error {
+  constructor(
+    public code: string,
+    public publicMessage: string,
+    public status = 400,
+  ) {
+    super(publicMessage);
+  }
+}
+export function safeError(error: unknown): AppError {
+  if (error instanceof AppError) return error;
+  // Never reflect upstream response bodies, crypto errors, URLs, request headers, or user input.
+  return new AppError(
+    'INTERNAL_ERROR',
+    'The request could not be completed safely. No exchange order was sent.',
+    500,
+  );
+}
