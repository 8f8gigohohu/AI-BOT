+export function SignalCard({
+  decision,
+  setDecision,
+  prefill,
+  requireOwner,
+  notify,
+  venue,
+  pair,
+  market,
+  navigate,
+}: CommonProps & MarketProps & DecisionProps) {
+  const [busy, setBusy] = useState(false);
+  const current = decision?.pair === pair && decision.venue === venue ? decision : null;
+  const count = market?.history.length ?? 0;
+  async function analyze() {
+    if (!requireOwner()) return;
+    setBusy(true);
+    try {
+      const d = await api<Decision>('/api/research/analyze', 'POST', { venue, pair });
+      setDecision(d);
+      notify(
+        d.strength === 'insufficient'
+          ? d.reasons[0]
+          : `A ${d.signal.toUpperCase()} research signal was recorded. No order was placed.`,
+        'info',
+      );
+    } catch (e) {
+      notify((e as Error).message, 'error');
+    } finally {
+      setBusy(false);
+    }
+  }
+  return (
+    <Panel
+      title={
+        <>
+          <span className="engine-title-icon">
+            <BrainCircuit size={17} />
+          </span>
+          Signal intelligence
+        </>
+      }
+      actions={<Badge tone="purple">RULE-BASED</Badge>}
+      className="signal-panel"
+    >
+      <div className="signal-content">
+        <div className="signal-status-row">
+          <span className="eyebrow">{pair} · SMA / RSI ENGINE</span>
+          {current && <span className="muted small-text">{formatTime(current.createdAt)} UTC</span>}
+        </div>
+        <div className={`signal-result signal-${current?.signal ?? 'idle'}`}>
+          <span className="signal-orb">
+            {current ? (
+              current.signal === 'hold' ? (
+                <Pause size={20} />
+              ) : current.signal === 'buy' ? (
+                <ArrowUpRight size={25} />
+              ) : (
+                <ArrowDownRight size={25} />
+              )
+            ) : (
+              <BrainCircuit size={24} />
+            )}
+          </span>
+          <div>
+            <h3>{current ? current.signal.toUpperCase() : 'Evidence before action'}</h3>
+            <p>
+              {current
+                ? `Rule strength: ${current.strength} · ${current.risk} risk`
+                : 'No signal until the data supports one.'}
+            </p>
+          </div>
+          {current && (
+            <Badge tone={current.risk === 'high' ? 'amber' : 'neutral'}>{current.risk} risk</Badge>
+          )}
+        </div>
+        <p className="signal-explanation">
+          {current?.reasons[0] ??
+            'An explainable 5/20 moving-average and RSI strategy. Every signal includes its rationale and risk. You decide what happens next.'}
+        </p>
+        <div className="observation-progress">
+          <div>
+            <span>Observation window</span>
+            <strong className="mono">
+              {Math.min(current?.observations ?? count, 20)}
+              <span> / 20 minimum</span>
+            </strong>
+          </div>
+          <div className="progress-track">
+            <span
+              style={{ width: `${Math.min(((current?.observations ?? count) / 20) * 100, 100)}%` }}
+            />
+          </div>
+        </div>
+        <div className="signal-buttons">
+          <Button variant="secondary" busy={busy} onClick={analyze}>
+            <Zap size={14} />
+            {current ? 'Analyze again' : 'Analyze market'}
+          </Button>
+          {current && current.signal !== 'hold' && venue === 'spot' ? (
+            <TextLink onClick={() => prefill(current)}>Prefill paper ticket</TextLink>
+          ) : (
+            <TextLink onClick={() => navigate('research')}>Open research lab</TextLink>
+          )}
+        </div>
+        <div className="engine-foot">
+          <LockKeyhole size={12} />
+          No auto-execution. No self-learning claims.
+        </div>
+      </div>
+    </Panel>
+  );
+}
+export function RecentActivity({ workspace, navigate }: CommonProps) {
+  const trades = workspace?.paper.trades.slice(0, 4) ?? [];
+  return (
+    <Panel
+      className="activity-panel"
+      title="Execution journal"
+      actions={<TextLink onClick={() => navigate('orders')}>View full journal</TextLink>}
+    >
+      {trades.length ? (
+        <div className="table-scroll">
+          <table>
+            <thead>
+              <tr>
+                <th>Time (UTC)</th>
+                <th>Market</th>
+                <th>Side</th>
+                <th>Quantity</th>
+                <th>Simulated fill</th>
+                <th>Status</th>
+              </tr>
+            </thead>
+            <tbody>
+              {trades.map((t) => (
+                <tr key={t.id}>
+                  <td className="mono muted">{formatTime(t.createdAt)}</td>
+                  <td>{t.pair}</td>
+                  <td>
+                    <Badge tone={t.side === 'buy' ? 'green' : 'red'}>{t.side.toUpperCase()}</Badge>
+                  </td>
+                  <td className="mono">{formatNumber(t.quantity, 8)}</td>
+                  <td className="mono">{formatMoney(t.fillPrice)}</td>
+                  <td>
+                    <Badge tone="purple">Simulated fill</Badge>
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      ) : (
+        <div className="journal-empty">
+          <span className="journal-icon">
+            <Clock3 size={20} />
+          </span>
+          <div>
+            <h3>Your next decision starts the story.</h3>
+            <p>
+              Paper fills and linked research decisions will appear here. Nothing trades in the
+              background.
+            </p>
+          </div>
+          <Badge>No executions</Badge>
+        </div>
+      )}
+    </Panel>
+  );
+}
