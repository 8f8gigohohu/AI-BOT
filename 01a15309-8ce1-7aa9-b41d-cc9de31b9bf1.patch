+                    <span>Implementation: {e.implementation}</span>
+                  </div>
+                  <p>{e.reason}</p>
+                  {e.conflicts.map((c) => (
+                    <Notice key={c} tone="amber">
+                      {c}
+                    </Notice>
+                  ))}
+                </div>
+              </details>
+            ))}
+          </div>
+        ) : (
+          <Empty
+            compact
+            title="No matching requests"
+            text="Try a different term or folder filter."
+          />
+        )}
+      </Panel>
+      <div className="audit-footnotes">
+        <Code2 size={18} />
+        <div>
+          <h3>Reproducible, privacy-preserving audit</h3>
+          <p>
+            The raw collection is not committed because its examples include account-specific data.
+            The audit script reads every request, folder description, script, original request, and
+            saved response. It retains schemas and provenance, not example credentials, account
+            identifiers, balances, or positions.
+          </p>
+          <code>npm run audit:collection -- "/path/to/your/supplied-collection.json"</code>
+        </div>
+      </div>
+    </>
+  );
+}
