+import { z } from 'zod';
+import Decimal from 'decimal.js';
+import { AppError } from './errors.js';
+
+export const spotPair = z.string().regex(/^[A-Z0-9]{1,20}-[A-Z0-9]{1,10}$/);
+export const futuresSymbol = z.string().regex(/^[A-Z0-9]{2,40}$/);
+function finitePositive(s: string): boolean {
+  try {
+    const n = new Decimal(s);
+    return n.isFinite() && n.gt(0);
+  } catch {
+    return false;
+  }
+}
+export const quantity = z
+  .string()
+  .max(32)
+  .regex(/^(?:0|[1-9]\d{0,15})(?:\.\d{1,12})?$/)
+  .refine(finitePositive, 'Must be positive');
+export const money = z
+  .string()
+  .max(20)
+  .regex(/^(?:0|[1-9]\d{0,9})(?:\.\d{1,2})?$/)
+  .refine(finitePositive);
+export function parse<T extends z.ZodType>(s: T, value: unknown): z.output<T> {
+  const result = s.safeParse(value);
+  if (!result.success)
+    throw new AppError(
+      'INVALID_INPUT',
+      'Check the required fields and supported input formats. Values must be finite and positive where applicable.',
+    );
+  return result.data;
+}
+export function numeric(value: unknown, positive = false): string | null {
+  if ((typeof value !== 'string' && typeof value !== 'number') || value === '') return null;
+  try {
+    const d = new Decimal(value);
+    return d.isFinite() && (!positive || d.gt(0)) ? d.toString() : null;
+  } catch {
+    return null;
+  }
+}
