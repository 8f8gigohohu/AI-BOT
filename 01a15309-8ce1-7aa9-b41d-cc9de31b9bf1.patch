+import { useEffect, useState } from 'react';
+import {
+  ArrowRight,
+  Check,
+  ChevronLeft,
+  ChevronRight,
+  Download,
+  Fingerprint,
+  Link2,
+  ListFilter,
+  LockKeyhole,
+  RefreshCw,
+  ScrollText,
+  Search,
+  ShieldCheck,
+} from 'lucide-react';
+import type { JournalView, Order } from '../../shared/types';
+import { DecisionHistory, PaperPerformancePanel } from '../components/DecisionHistory';
+import type { CommonProps, MarketProps } from '../context';
+import { api, formatMoney, formatNumber, formatTime } from '../api';
+import {
+  Badge,
+  Button,
+  Empty,
+  Field,
+  Notice,
+  PageHeading,
+  Panel,
+  TextLink,
+} from '../components/ui';
+export function OrdersPage({
+  session,
+  workspace,
+  requireOwner,
+  notify,
+  navigate,
+  pair,
+  venue,
+}: CommonProps & MarketProps) {
+  const [tab, setTab] = useState('paper'),
+    [journal, setJournal] = useState<JournalView | null>(null),
+    [busy, setBusy] = useState(false),
+    [reload, setReload] = useState(0);
+  const [status, setStatus] = useState<'pending' | 'complete'>('pending'),
+    [orderPair, setOrderPair] = useState(venue === 'spot' ? pair : 'BTC-INR'),
+    [page, setPage] = useState(1),
+    [orders, setOrders] = useState<Order[] | null>(null),
+    [ordersError, setOrdersError] = useState(''),
+    [orderId, setOrderId] = useState(''),
+    [reconciled, setReconciled] = useState<{
+      status: string;
+      observations: Order[];
+      message: string;
+    } | null>(null);
+  const [journalBusy, setJournalBusy] = useState(false);
+  const [decisionPage, setDecisionPage] = useState(1);
+  const [orderPairDraft, setOrderPairDraft] = useState(orderPair);
+  const validPairDraft = /^[A-Z0-9]{1,20}-[A-Z0-9]{1,10}$/.test(orderPairDraft);
+  useEffect(() => {
+    if (!session?.authenticated) {
+      setJournal(null);
+      return;
+    }
+    const controller = new AbortController();
+    setJournalBusy(true);
+    setJournal(null);
+    api<JournalView>(
+      `/api/journal?decisionPage=${decisionPage}`,
+      'GET',
+      undefined,
+      controller.signal,
+    )
+      .then((result) => {
+        if (!controller.signal.aborted) setJournal(result);
+      })
+      .catch(() => {
+        if (!controller.signal.aborted) notify('The local journal could not be read.', 'error');
+      })
+      .finally(() => {
+        if (!controller.signal.aborted) setJournalBusy(false);
+      });
+    return () => controller.abort();
+  }, [session?.authenticated, reload, workspace?.paper.trades[0]?.id, decisionPage]);
+  const connected = workspace?.connection.status === 'connected';
+  useEffect(() => {
+    if (tab !== 'exchange' || !connected || !session?.authenticated) {
+      setOrders(null);
+      return;
+    }
+    const controller = new AbortController();
+    setBusy(true);
+    setOrders(null);
+    setOrdersError('');
+    api<{ data: Order[] }>(
+      `/api/orders?pair=${encodeURIComponent(orderPair)}&status=${status}&page=${page}`,
+      'GET',
+      undefined,
+      controller.signal,
+    )
+      .then((o) => setOrders(o.data))
+      .catch((e) => {
+        if (!controller.signal.aborted) setOrdersError(e.message);
+      })
+      .finally(() => {
+        if (!controller.signal.aborted) setBusy(false);
+      });
+    return () => controller.abort();
+  }, [tab, connected, session?.authenticated, status, page, reload, orderPair]);
+  async function reconcile() {
+    if (!requireOwner()) return;
+    setBusy(true);
+    try {
+      setReconciled(
+        await api(
+          `/api/orders/reconcile?pair=${encodeURIComponent(orderPair)}&orderId=${encodeURIComponent(orderId)}`,
+        ),
+      );
+    } catch (e) {
+      notify((e as Error).message, 'error');
+    } finally {
+      setBusy(false);
+    }
+  }
+  function download() {
+    if (!session?.authenticated || !journal) return;
+    const url = URL.createObjectURL(
+      new Blob(
+        [
+          JSON.stringify(
+            {
+              source: 'DarkDevil Quant local journal',
+              exportedAt: new Date().toISOString(),
+              scope: {
+                kind: 'bounded-view',
+                notDatabaseBackup: true,
+                currentPortfolioId: journal.performance.portfolioId,
+                trades: {
+                  limit: 200,
+                  returned: journal.trades.length,
+                  total: journal.performance.fills,
+                  wallet: 'current virtual wallet only',
+                },
+                decisions: {
+                  page: journal.decisionPage,
+                  pageSize: journal.decisionPageSize,
+                  total: journal.decisionCount,
+                },
+                backtests: { limit: 20, returned: journal.backtests.length },
+                audit: { limit: 200, returned: journal.audit.length },
+                outcomes:
+                  'All persisted linked fills for the included decisions, including archived virtual wallets. BUY entries have no realized exit attribution.',
