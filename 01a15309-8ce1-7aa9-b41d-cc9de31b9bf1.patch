+import { defineConfig } from '@playwright/test';
+import chromium, { inflate } from '@sparticuz/chromium';
+import { resolve } from 'node:path';
+
+const bundledLinux = process.platform === 'linux' && !process.env.PLAYWRIGHT_EXECUTABLE_PATH;
+if (bundledLinux) await inflate(resolve('node_modules/@sparticuz/chromium/bin/al2023.tar.br'));
+export default defineConfig({
+  testDir: './tests/browser',
+  fullyParallel: false,
+  workers: 1,
+  timeout: 30000,
+  reporter: 'list',
+  use: {
+    baseURL: process.env.DARKDEVIL_TEST_URL ?? 'http://127.0.0.1:3000',
+    viewport: { width: 1440, height: 1050 },
+    headless: true,
+    trace: 'off', // No browser trace may accidentally retain a manually entered real credential.
+    screenshot: 'off',
+    launchOptions: {
+      executablePath:
+        process.env.PLAYWRIGHT_EXECUTABLE_PATH ??
+        (bundledLinux ? await chromium.executablePath() : undefined),
+      args: bundledLinux
+        ? chromium.args.filter(
+            (arg) =>
+              !arg.includes('disable-web-security') &&
+              !arg.includes('allow-running-insecure-content') &&
+              !arg.includes('single-process'),
+          )
+        : [],
+      ...(bundledLinux
+        ? {
+            env: {
+              ...process.env,
+              LD_LIBRARY_PATH: `/tmp/al2023/lib:${process.env.LD_LIBRARY_PATH ?? ''}`,
+            },
+          }
+        : {}),
+    },
+  },
+});
