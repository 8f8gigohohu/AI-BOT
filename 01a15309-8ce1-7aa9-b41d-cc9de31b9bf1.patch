+  it('produces only the four verified Spot payload formats as offline data, without adding undocumented fields', () => {
+    const now = 1792404000000;
+    expect(
+      documentedSpotPayload(
+        { type: 'limit', pair: 'BTC-INR', side: 'buy', quantity: '0.00025', price: '7000000' },
