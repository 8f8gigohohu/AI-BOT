+let csrfToken = '';
+export function setCsrf(value: string) {
+  csrfToken = value;
+}
+export class ApiError extends Error {
+  constructor(
+    public code: string,
+    message: string,
+    public status = 0,
+  ) {
+    super(message);
+  }
+}
+export async function api<T>(
+  path: string,
+  method = 'GET',
+  body?: unknown,
+  signal?: AbortSignal,
+): Promise<T> {
+  let response: Response;
+  try {
+    response = await fetch(path, {
+      method,
+      credentials: 'same-origin',
+      cache: 'no-store',
+      signal,
+      headers: {
+        ...(body !== undefined ? { 'Content-Type': 'application/json' } : {}),
+        ...(method !== 'GET' ? { 'X-CSRF-Token': csrfToken } : {}),
+      },
+      ...(body !== undefined ? { body: JSON.stringify(body) } : {}),
+    });
+  } catch (e) {
+    if (signal?.aborted) throw e;
+    throw new ApiError(
+      'NETWORK_ERROR',
+      'The workspace server could not be reached. Check the connection before submitting another action.',
+    );
+  }
+  const result = await response.json().catch(() => null);
+  if (!response.ok)
+    throw new ApiError(
+      result?.error?.code ?? 'REQUEST_FAILED',
+      result?.error?.message ?? 'The request could not be completed safely.',
+      response.status,
+    );
+  if (result === null)
+    throw new ApiError('INVALID_RESPONSE', 'The workspace returned an unreadable response.');
+  return result as T;
+}
+export const formatMoney = (
+  value: string | number | null | undefined,
+  currency = 'INR',
+  decimals = 2,
+) => {
+  if (value === null || value === undefined || !Number.isFinite(Number(value))) return '—';
+  if (!/^[A-Z]{3}$/.test(currency))
+    return `${new Intl.NumberFormat('en-IN', { maximumFractionDigits: decimals, minimumFractionDigits: decimals }).format(Number(value))} ${currency}`;
+  return new Intl.NumberFormat('en-IN', {
+    style: 'currency',
+    currency,
+    maximumFractionDigits: decimals,
+    minimumFractionDigits: decimals,
+  }).format(Number(value));
+};
+export const formatPrice = (value: string | number | null | undefined, currency = 'INR') => {
+  if (value === null || value === undefined || !Number.isFinite(Number(value))) return '—';
+  return formatMoney(value, currency, Number(value) < 1 ? 6 : 2);
+};
+export const formatNumber = (value: string | number | null | undefined, decimals = 6) =>
+  value === null || value === undefined || !Number.isFinite(Number(value))
+    ? '—'
+    : new Intl.NumberFormat('en-IN', { maximumFractionDigits: decimals }).format(Number(value));
+export const formatTime = (value: number | null | undefined, date = false) =>
+  !value
+    ? '—'
+    : new Intl.DateTimeFormat('en-GB', {
+        timeZone: 'UTC',
+        ...(date ? { day: '2-digit', month: 'short' } : {}),
+        hour: '2-digit',
+        minute: '2-digit',
+        ...(date ? {} : { second: '2-digit' }),
+      }).format(value);
+export const percent = (value: number | null | undefined) =>
+  value === null || value === undefined || !Number.isFinite(value)
+    ? '—'
+    : `${value >= 0 ? '+' : ''}${value.toFixed(2)}%`;
