@@ -0,0 +1,84 @@
+import dotenv from 'dotenv';
+import express from 'express';
+import { createServer as createHttpServer } from 'node:http';
+import { resolve } from 'node:path';
+import { loadConfig } from './config.js';
+import { createApplication } from './app.js';
+
+dotenv.config({ quiet: true });
+const config = loadConfig();
+const workspace = createApplication(config);
+const { app } = workspace;
+const server = createHttpServer(app);
+let closeDev: (() => Promise<void>) | undefined;
+if (config.production) {
+  app.use(express.static(resolve('dist/client'), { index: false, dotfiles: 'deny', maxAge: '1d' }));
+  app.get('/{*path}', (_req, res) => {
+    res.set('Cache-Control', 'no-store');
+    res.sendFile(resolve('dist/client/index.html'));
+  });
+} else {
+  const { createServer } = await import('vite');
+  const vite = await createServer({
+    server: {
+      middlewareMode: true,
+      host: '0.0.0.0',
+      hmr: false,
+      // Use the SAME HTTP server. No second WebSocket port or browser localhost
+      // endpoint is advertised through the proxied preview.
+      ws: { server },
+      allowedHosts: ['.e2b.app', 'localhost', '127.0.0.1'],
+      fs: {
+        strict: true,
+        deny: [
+          '**/.env',
+          '**/.env.*',
+          '**/.runtime/**',
+          '**/.git/**',
+          '**/server/**',
+          '**/scripts/**',
+          '**/tests/**',
+          '**/docs/**',
+          '**/.github/**',
+          '**/*.postman_collection*.json',
+          '**/*.sqlite*',
+          '**/*.enc',
+          '**/*.key',
+          '**/*.{pem,crt,p12,pfx}',
+          '**/owner.json',
+          '**/*.log',
+          `${config.dataDir}/**`,
+        ],
+      },
+    },
+    appType: 'spa',
+  });
+  closeDev = () => vite.close();
+  app.use(vite.middlewares);
+}
+const port = Number(process.env.PORT ?? 3000);
+if (!Number.isInteger(port) || port < 1 || port > 65535)
+  throw new Error('PORT must be an integer from 1 to 65535.');
+server.listen(port, '0.0.0.0', () => {
+  console.log(
+    `DarkDevil Quant is listening on 0.0.0.0:${port}. Paper mode is the default. Live execution is blocked.`,
+  );
+  if (!config.ownerHash)
+    console.log(
+      'Read-only workspace: run npm run setup in your terminal and restart to enable secure owner access.',
+    );
+});
+async function shutdown() {
+  workspace.connection.shutdown();
+  await closeDev?.();
+  server.close(() => {
+    workspace.close();
+    process.exit(0);
+  });
+}
+process.once('SIGTERM', () => {
+  void shutdown();
+});
+process.once('SIGINT', () => {
+  void shutdown();
+});
