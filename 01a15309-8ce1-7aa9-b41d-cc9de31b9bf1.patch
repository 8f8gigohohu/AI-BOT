+import { WifiOff, ChartNoAxesCombined } from 'lucide-react';
+import { formatNumber, formatTime } from '../api';
+import type { Observation } from '../../shared/types';
+export function PriceChart({
+  history,
+  loading,
+  available,
+  research = false,
+}: {
+  history: Observation[];
+  loading?: boolean;
+  available: boolean;
+  research?: boolean;
+}) {
+  const width = 840,
+    height = 260,
+    padX = 8,
+    padY = 25;
+  const values = history.map((p) => Number(p.price));
+  const min = values.length ? Math.min(...values) : 0;
+  const max = values.length ? Math.max(...values) : 0;
+  const spread = Math.max(max - min, max * 0.0005, 0.000001);
+  const firstTime = history.at(0)?.time ?? 0,
+    lastTime = history.at(-1)?.time ?? 1;
+  const x = (t: number) =>
+    padX + ((t - firstTime) / Math.max(lastTime - firstTime, 1)) * (width - 2 * padX);
+  const y = (price: number) =>
+    height - padY - ((price - min + spread * 0.2) / (spread * 1.4)) * (height - 2 * padY);
+  const path = history
+    .map(
+      (p, i) =>
+        `${i === 0 || p.time - history[i - 1].time > 120000 ? 'M' : 'L'}${x(p.time).toFixed(2)},${y(Number(p.price)).toFixed(2)}`,
+    )
+    .join(' ');
+  const continuous = history.every((p, i) => i === 0 || p.time - history[i - 1].time <= 120000);
+  const area =
+    history.length >= 2 && continuous
+      ? `${path} L${x(lastTime)},${height} L${x(firstTime)},${height} Z`
+      : '';
+  return (
+    <div className={`price-chart ${research ? 'research-chart' : ''}`}>
+      <div className="chart-grid" aria-hidden="true" />
+      {history.length >= 2 ? (
+        <>
+          <svg
+            viewBox={`0 0 ${width} ${height}`}
+            preserveAspectRatio="none"
+            role="img"
+            aria-label={
+              research
+                ? 'Hypothetical backtest equity, not account performance'
+                : 'Genuine, locally observed ZebPay prices'
+            }
+          >
+            <defs>
+              <linearGradient
+                id={research ? 'research-fill' : 'price-fill'}
+                x1="0"
+                y1="0"
+                x2="0"
+                y2="1"
+              >
+                <stop offset="0%" stopColor="#c3ef7a" stopOpacity=".16" />
+                <stop offset="100%" stopColor="#c3ef7a" stopOpacity="0" />
+              </linearGradient>
+            </defs>
+            {area && <path d={area} fill={`url(#${research ? 'research-fill' : 'price-fill'})`} />}
+            <path
+              d={path}
+              fill="none"
+              stroke="#c3ef7a"
+              strokeWidth="2.2"
+              vectorEffect="non-scaling-stroke"
+            />
+            <circle cx={x(lastTime)} cy={y(values.at(-1)!)} r="4" fill="#c3ef7a" />
+          </svg>
+          <div className="chart-y">
+            <span>{formatNumber(max, 4)}</span>
+            <span>{formatNumber((min + max) / 2, 4)}</span>
+            <span>{formatNumber(min, 4)}</span>
+          </div>
+          <div className="chart-x">
+            <span>{formatTime(firstTime)}</span>
+            <span>{formatTime((firstTime + lastTime) / 2)}</span>
+            <span>{formatTime(lastTime)} UTC</span>
+          </div>
+          {!available && <span className="chart-stale">Recorded data · feed unavailable</span>}
+        </>
+      ) : (
+        <div className="chart-empty">
+          <div className="chart-empty-icon">
+            {loading ? (
+              <span className="loading-rings" />
+            ) : available ? (
+              <ChartNoAxesCombined size={25} />
+            ) : (
+              <WifiOff size={24} />
+            )}
+          </div>
+          <h3>
+            {loading
+              ? 'Listening for the market'
+              : history.length === 1
+                ? 'First observation recorded'
+                : 'Real data. Or no data.'}
+          </h3>
+          <p>
+            {loading
+              ? 'Requesting the documented ZebPay market feed…'
+              : history.length === 1
+                ? 'Keep this workspace open to build a genuine price history.'
+                : 'Your chart starts when ZebPay returns a verified price.\nWe never fill the gaps with sample market data.'}
+          </p>
+          <span className="chart-empty-caption">
+            {history.length === 1
+              ? 'Next observation in approximately 15 seconds'
+              : 'ZEBPAY REST FEED · NO SYNTHETIC HISTORY'}
+          </span>
+        </div>
+      )}
+    </div>
+  );
+}
