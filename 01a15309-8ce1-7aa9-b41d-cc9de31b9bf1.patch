+import { useCallback, useEffect, useState } from 'react';
+import { api } from './api';
+import type { MarketView, Venue } from '../shared/types';
+export function useMarket(
+  venue: Venue,
+  pair: string,
+  range: '1h' | '6h' | '24h' | 'all',
+  polling: boolean,
+) {
+  const [nonce, setNonce] = useState(0);
+  const [state, setState] = useState<{ key: string; data: MarketView | null; loading: boolean }>({
+    key: '',
+    data: null,
+    loading: true,
+  });
+  const key = `${venue}:${pair}:${range}`;
+  useEffect(() => {
+    const controller = new AbortController();
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    setState((s) => ({ key, data: s.key === key ? s.data : null, loading: true }));
+    api<MarketView>(
+      `/api/market?venue=${venue}&pair=${encodeURIComponent(pair)}&range=${range}`,
+      'GET',
+      undefined,
+      controller.signal,
+    )
+      .then((data) => {
+        if (!controller.signal.aborted) setState({ key, data, loading: false });
+      })
+      .catch(() => {
+        if (!controller.signal.aborted)
+          setState({
+            key,
+            data: {
+              status: 'unavailable',
+              reason:
+                'The market feed could not be reached. Check the workspace server and outbound access. No sample prices are substituted.',
+              markets: [],
+              selected: null,
+              history: [],
+              source: 'ZebPay · documented REST endpoints',
+              pollSeconds: 15,
+            },
+            loading: false,
+          });
+      })
+      .finally(() => {
+        if (polling && !controller.signal.aborted)
+          timer = setTimeout(() => setNonce((n) => n + 1), 15000);
+      });
+    return () => {
+      controller.abort();
+      if (timer) clearTimeout(timer);
+    };
+  }, [venue, pair, range, polling, nonce, key]);
+  const refresh = useCallback(() => setNonce((n) => n + 1), []);
+  return {
+    data: state.key === key ? state.data : null,
+    loading: state.key !== key || state.loading,
+    refresh,
+  };
+}
