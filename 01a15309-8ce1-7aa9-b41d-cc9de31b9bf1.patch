+  LoaderCircle,
+  LockKeyhole,
+  ShieldCheck,
+  X,
+} from 'lucide-react';
+export type Page = 'overview' | 'markets' | 'research' | 'orders' | 'connection' | 'risk' | 'audit';
+export type Notify = (message: string, kind?: 'success' | 'error' | 'info') => void;
+export function Badge({
+  children,
+  tone = 'neutral',
+  dot = false,
+}: {
+  children: ReactNode;
+  tone?: 'neutral' | 'green' | 'amber' | 'red' | 'purple';
+  dot?: boolean;
+}) {
+  return (
+    <span className={`badge badge-${tone}`}>
+      {dot && <i className="status-dot" />}
+      {children}
+    </span>
+  );
+}
+export function Button({
+  children,
+  variant = 'primary',
+  busy = false,
+  className = '',
+  ...props
+}: React.ButtonHTMLAttributes<HTMLButtonElement> & {
+  variant?: 'primary' | 'secondary' | 'ghost' | 'danger';
+  busy?: boolean;
+}) {
+  return (
+    <button
+      {...props}
+      disabled={props.disabled || busy}
+      className={`button button-${variant} ${className}`}
+    >
+      {busy && <LoaderCircle size={15} className="spin" />}
+      {children}
+    </button>
+  );
+}
+export function Panel({
+  title,
+  eyebrow,
+  actions,
+  children,
+  className = '',
+  description,
+}: {
+  title?: ReactNode;
+  eyebrow?: string;
+  actions?: ReactNode;
+  children: ReactNode;
+  className?: string;
+  description?: ReactNode;
+}) {
+  return (
+    <section className={`panel ${className}`}>
+      {(title || actions) && (
+        <div className="panel-heading">
+          <div>
+            {eyebrow && <span className="eyebrow">{eyebrow}</span>}
+            <h2>{title}</h2>
+            {description && <p className="panel-description">{description}</p>}
+          </div>
+          {actions}
+        </div>
+      )}
+      {children}
+    </section>
+  );
+}
+export function PageHeading({
+  eyebrow,
+  title,
+  description,
+  actions,
+}: {
+  eyebrow: string;
+  title: string;
+  description: string;
+  actions?: ReactNode;
+}) {
+  return (
+    <div className="page-heading">
+      <div>
+        <div className="eyebrow">{eyebrow}</div>
+        <h1>
+          {title}
+          <span className="heading-dot">.</span>
+        </h1>
+        <p>{description}</p>
+      </div>
+      {actions && <div className="page-actions">{actions}</div>}
+    </div>
+  );
+}
+export function Empty({
+  icon,
+  title,
+  text,
+  action,
+  compact = false,
+}: {
+  icon?: ReactNode;
+  title: string;
+  text: string;
+  action?: ReactNode;
+  compact?: boolean;
+}) {
+  return (
+    <div className={`empty-state ${compact ? 'empty-compact' : ''}`}>
+      <span className="empty-icon">{icon ?? <Info size={23} />}</span>
+      <h3>{title}</h3>
+      <p>{text}</p>
+      {action}
+    </div>
+  );
+}
+export function Notice({
+  children,
+  tone = 'neutral',
+  title,
+}: {
+  children: ReactNode;
+  tone?: 'neutral' | 'green' | 'amber' | 'red';
+  title?: string;
+}) {
+  return (
+    <div className={`notice notice-${tone}`}>
+      {tone === 'green' ? (
+        <ShieldCheck size={17} />
+      ) : tone === 'amber' || tone === 'red' ? (
+        <AlertTriangle size={17} />
+      ) : (
+        <Info size={17} />
+      )}
+      <div>
+        {title && <strong>{title}</strong>}
+        <div>{children}</div>
+      </div>
+    </div>
+  );
+}
+export function Field({
+  label,
+  hint,
+  children,
+}: {
+  label: string;
+  hint?: string;
+  children: ReactNode;
+}) {
+  return (
+    <label className="field">
+      <span className="field-label">{label}</span>
+      {children}
+      {hint && <span className="field-hint">{hint}</span>}
+    </label>
+  );
+}
+export function Modal({
+  title,
+  subtitle,
+  children,
+  onClose,
+  tone = 'normal',
+}: {
+  title: string;
+  subtitle?: string;
+  children: ReactNode;
+  onClose: () => void;
+  tone?: 'normal' | 'danger';
+}) {
+  const ref = useRef<HTMLDialogElement>(null);
+  useEffect(() => {
+    const el = ref.current;
+    el?.showModal();
+    return () => {
+      el?.close();
+    };
+  }, []);
+  return (
+    <dialog
+      className={`modal modal-${tone}`}
+      ref={ref}
+      onCancel={onClose}
+      onClick={(e) => {
+        if (e.target === ref.current) onClose();
+      }}
+    >
+      <div className="modal-top">
+        <span className="modal-mark">
+          {tone === 'danger' ? <AlertTriangle size={22} /> : <LockKeyhole size={22} />}
+        </span>
+        <button className="icon-button" onClick={onClose} aria-label="Close dialog">
+          <X size={20} />
