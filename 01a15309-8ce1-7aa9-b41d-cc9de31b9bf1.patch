+export function OrderTicket({
+  workspace,
+  session,
+  requireOwner,
+  notify,
+  refreshWorkspace,
+  market,
+  venue,
+  pair,
+  prefilled,
+}: CommonProps & MarketProps & { prefilled: { side: 'buy' | 'sell'; decisionId: string } | null }) {
+  const [side, setSide] = useState<'buy' | 'sell'>('buy');
+  const [qty, setQty] = useState('');
+  const [confirm, setConfirm] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [decisionId, setDecisionId] = useState<string | null>(null);
+  const [uncertain, setUncertain] = useState(false);
+  const request = useRef<{ id: string; fingerprint: string } | null>(null);
+  useEffect(() => {
+    setQty('');
+    setDecisionId(null);
+    request.current = null;
+    setUncertain(false);
+  }, [pair, venue]);
+  useEffect(() => {
+    if (prefilled) {
+      setSide(prefilled.side);
+      setDecisionId(prefilled.decisionId);
+      setQty('');
+    }
+  }, [prefilled, pair, venue]);
+  const selected = market?.selected;
+  const risk = workspace?.risk;
+  const price = selected?.price ? Number(selected.price) : 0;
+  const valid =
+    venue === 'spot' && selected?.quote === 'INR' && market?.status === 'available' && price > 0;
+  const fill = price * (1 + ((side === 'buy' ? 1 : -1) * (risk?.slippageBps ?? 0)) / 10000);
+  const notional = Number(qty) > 0 ? Number(qty) * fill : 0;
+  const fee = (notional * (risk?.feeBps ?? 0)) / 10000;
+  function portion(percent: number) {
+    if (!valid || !workspace) return;
+    const max = Number(workspace.risk.maximumOrderInr);
+    const q =
+      side === 'buy'
+        ? Math.min(
+            (Number(workspace.paper.wallet.cash) * percent) / (1 + workspace.risk.feeBps / 10000),
+            max,
+          ) / fill
+        : Math.min(
+            Number(workspace.paper.wallet.positions[pair]?.quantity ?? 0) * percent,
+            max / fill,
+          );
+    setQty((Math.floor(q * 1e8) / 1e8).toFixed(8).replace(/\.?0+$/, '') || '0');
+  }
+  function review(e: FormEvent) {
+    e.preventDefault();
+    if (!requireOwner()) return;
+    if (!valid) {
+      notify('A fresh, exact INR Spot price is required. No simulation was submitted.', 'error');
+      return;
+    }
+    if (!/^(?:0|[1-9]\d{0,15})(?:\.\d{1,12})?$/.test(qty) || Number(qty) <= 0) {
+      notify('Enter a positive quantity with at most 12 decimal places.', 'error');
+      return;
+    }
+    setConfirm(true);
+  }
+  async function submit() {
+    const fingerprint = `${pair}:${side}:${qty}:${decisionId}`;
+    if (!request.current || request.current.fingerprint !== fingerprint)
+      request.current = { id: crypto.randomUUID(), fingerprint };
+    setBusy(true);
+    try {
+      const result = await api<{ trade: PaperTrade; replayed: boolean }>('/api/orders', 'POST', {
+        mode: 'paper',
+        venue: 'spot',
+        pair,
+        side,
+        quantity: qty,
+        requestId: request.current.id,
+        decisionId,
+      });
+      notify(
+        result.replayed
+          ? 'This simulation was already recorded. No duplicate fill was created.'
+          : 'Paper order filled using an observed ZebPay price. No real order was sent.',
+        'success',
+      );
+      setConfirm(false);
+      setQty('');
+      setDecisionId(null);
+      setUncertain(false);
+      request.current = null;
+      await refreshWorkspace();
+    } catch (e) {
+      if (e instanceof ApiError && e.code === 'NETWORK_ERROR') {
+        setUncertain(true);
+        setConfirm(false);
+      }
+      notify(e instanceof Error ? e.message : 'The simulation could not be completed.', 'error');
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function reconcile() {
+    if (!request.current) return;
+    setBusy(true);
+    try {
+      const result = await api<{ status: string }>(`/api/paper/request/${request.current.id}`);
+      if (result.status === 'filled') {
+        notify('The paper fill is recorded in your ledger. It was not repeated.', 'success');
+        setQty('');
+        request.current = null;
+      } else
+        notify(
+          'No paper fill is recorded for that request ID. You may review and retry the same simulation safely.',
+          'info',
+        );
+      setUncertain(false);
+      await refreshWorkspace();
+    } catch (e) {
+      notify((e as Error).message, 'error');
+    } finally {
+      setBusy(false);
+    }
+  }
+  return (
+    <Panel
+      className="ticket-panel"
+      title="Order ticket"
+      actions={<Badge tone="purple">PAPER</Badge>}
+    >
+      <div className="ticket-content">
+        <div className="segment trade-side">
+          <button
+            className={side === 'buy' ? 'active buy' : ''}
+            onClick={() => {
+              setSide('buy');
+              setDecisionId(null);
+            }}
+            disabled={busy || uncertain}
+          >
+            <ArrowDownLeft size={15} />
+            Buy
+          </button>
+          <button
+            className={side === 'sell' ? 'active sell' : ''}
+            onClick={() => {
+              setSide('sell');
+              setDecisionId(null);
+            }}
+            disabled={busy || uncertain}
+          >
+            <ArrowUpRight size={15} />
+            Sell
+          </button>
+        </div>
+        <div className="order-type">
+          <span>Market simulation</span>
+          <Badge>Spot · long-only</Badge>
+        </div>
+        <form onSubmit={review}>
+          <label className="field">
+            <span className="field-label">
+              Quantity<span className="muted">{pair}</span>
+            </span>
+            <div className="quantity-input">
+              <input
+                aria-label="Order quantity"
+                inputMode="decimal"
+                autoComplete="off"
+                placeholder="0.00"
+                value={qty}
+                maxLength={32}
+                disabled={busy || uncertain || venue !== 'spot'}
+                onChange={(e) => setQty(e.target.value)}
+              />
+              <span>{selected?.base ?? pair.split('-')[0]}</span>
+            </div>
+          </label>
+          <div className="allocation-buttons">
+            {[25, 50, 75, 100].map((p) => (
+              <button
+                type="button"
+                key={p}
+                disabled={!valid || !workspace || busy || uncertain}
+                onClick={() => portion(p / 100)}
+                title="Percentage of virtual funds; your maximum-order cap still applies"
+              >
+                {p === 100 ? 'Max' : `${p}%`}
+              </button>
+            ))}
+          </div>
+          <div className="ticket-calculation">
+            <div>
+              <span>Reference price</span>
+              <strong className="mono">{formatPrice(selected?.price, selected?.quote)}</strong>
+            </div>
+            <div>
+              <span>Est. simulated notional</span>
+              <strong className="mono">{qty && valid ? formatMoney(notional) : '—'}</strong>
+            </div>
+            <div>
+              <span>Assumed fee {risk ? `(${risk.feeBps} bps)` : ''}</span>
+              <strong className="mono">{qty && valid && risk ? formatMoney(fee) : '—'}</strong>
+            </div>
+            <div className="calculation-total">
+              <span>Virtual {side === 'buy' ? 'debit' : 'credit'}</span>
+              <strong className="mono">
+                {qty && valid && risk
+                  ? formatMoney(side === 'buy' ? notional + fee : notional - fee)
+                  : '—'}
+              </strong>
+            </div>
+          </div>
+          {decisionId && (
+            <div className="linked-decision">
+              <BrainCircuit size={12} />
+              Linked to a research decision · review required
+            </div>
+          )}
+          <Button
+            className="ticket-submit"
+            type="submit"
+            disabled={busy || uncertain || (session?.authenticated && (!valid || risk?.killSwitch))}
+          >
+            {!session?.authenticated ? (
+              <>
+                <LockKeyhole size={15} />
+                Unlock paper trading
+              </>
+            ) : risk?.killSwitch ? (
+              'Emergency stop active'
+            ) : venue === 'futures' ? (
+              'Futures simulation unavailable'
+            ) : (
+              <>
+                {side === 'buy' ? 'Review paper buy' : 'Review paper sell'}
+                <ArrowRight size={15} />
+              </>
+            )}
+          </Button>
+        </form>
+        {uncertain && (
+          <Notice tone="amber" title="Paper outcome not confirmed">
+            <p>Do not create another request yet. Check this request in the local ledger.</p>
+            <Button variant="secondary" busy={busy} onClick={reconcile}>
+              Check simulation status
+            </Button>
+          </Notice>
+        )}
+        <div className="ticket-balance">
+          <span>Available virtual INR</span>
+          <strong className="mono">{formatMoney(workspace?.paper.wallet.cash)}</strong>
+        </div>
+        <div className="ticket-disclaimer">
+          <ShieldCheck size={14} />
+          <span>Simulation only. No exchange order is sent.</span>
+        </div>
+      </div>
+      {confirm && (
+        <Modal
+          title={`Review simulated ${side}`}
+          subtitle="This changes only your virtual paper portfolio. It does not submit an order to ZebPay."
+          onClose={() => {
+            if (!busy) setConfirm(false);
+          }}
+        >
+          <div className="confirmation-details">
+            <div>
+              <span>Market</span>
+              <strong>{pair}</strong>
+            </div>
+            <div>
+              <span>Quantity</span>
+              <strong className="mono">{qty}</strong>
+            </div>
+            <div>
+              <span>Estimated virtual {side === 'buy' ? 'debit' : 'credit'}</span>
+              <strong className="mono">
+                {formatMoney(side === 'buy' ? notional + fee : notional - fee)}
+              </strong>
+            </div>
+            <div>
+              <span>Simulation costs</span>
+              <strong>
+                {risk?.feeBps} bps fee · {risk?.slippageBps} bps slippage
+              </strong>
+            </div>
+          </div>
+          <Notice>
+            Final validation uses the current observed price and server-side risk limits. These
+            assumed costs are not verified ZebPay fees.
+          </Notice>
+          <div className="modal-actions">
+            <Button variant="secondary" disabled={busy} onClick={() => setConfirm(false)}>
+              Go back
+            </Button>
+            <Button busy={busy} onClick={submit}>
+              Simulate {side}
+              <Check size={15} />
+            </Button>
+          </div>
+        </Modal>
+      )}
+    </Panel>
+  );
+}
