+import { useEffect, useRef, useState, type FormEvent } from 'react';
+import {
+  Activity,
+  ArrowDownLeft,
+  ArrowDownRight,
+  ArrowRight,
+  ArrowUpRight,
+  BrainCircuit,
+  Check,
+  ChevronDown,
+  Clock3,
+  Info,
+  Layers,
+  LockKeyhole,
+  Pause,
+  Play,
+  RefreshCw,
+  Search,
+  ShieldCheck,
+  ShieldX,
+  Wallet,
+  WifiOff,
+  Zap,
+} from 'lucide-react';
+import type { Decision, PaperTrade } from '../../shared/types';
+import type { CommonProps, DecisionProps, MarketProps } from '../context';
