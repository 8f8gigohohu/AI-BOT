+import { createHmac } from 'node:crypto';
+import { z } from 'zod';
+import type { Order } from '../shared/types.js';
+import type { Credentials } from './vault.js';
+import { AppError } from './errors.js';
+import { numeric } from './validation.js';
+
+// Every entry points to a request in docs/collection-audit.json. There is NO generic
+// URL proxy, mutation method, transfer method, or Futures authentication adapter.
+export const READ_OPERATIONS = {
+  'spot.markets': { url: 'https://www.zebapi.com/api/v1/market', source: 1, private: false },
+  'spot.ticker': {
+    url: 'https://www.zebapi.com/api/v1/market/BTC-INR/ticker',
+    source: 2,
+    private: false,
+  },
+  'spot.pending': { url: 'https://www.zebapi.com/api/v1/orders', source: 8, private: true },
+  'spot.complete': { url: 'https://www.zebapi.com/api/v1/orders', source: 9, private: true },
+  'futures.markets': {
+    url: 'https://futuresbe.zebpay.com/api/v1/market/markets',
+    source: 18,
+    private: false,
+  },
+  'futures.info': {
+    url: 'https://futuresbe.zebpay.com/api/v1/market/marketInfo',
+    source: 19,
+    private: false,
+  },
+  'futures.book': {
+    url: 'https://futuresbe.zebpay.com/api/v1/market/orderBook',
+    source: 20,
+    private: false,
+  },
+  'futures.ticker24h': {
+    url: 'https://futuresbe.zebpay.com/api/v1/market/ticker24Hr',
+    source: 21,
+    private: false,
+  },
+  'futures.aggregates': {
+    url: 'https://futuresbe.zebpay.com/api/v1/market/aggTrade',
+    source: 22,
+    private: false,
+  },
+  'futures.health': {
+    url: 'https://futuresbe.zebpay.com/healthCheckStatus',
+    source: 38,
+    private: false,
+  },
+  'futures.exchangeInfo': {
+    url: 'https://futuresbe.zebpay.com/api/v1/exchange/exchangeInfo',
+    source: 23,
+    private: false,
+  },
+} as const;
+export type ReadOperation = keyof typeof READ_OPERATIONS;
+export type Fetcher = (input: string, init: RequestInit) => Promise<Response>;
+
+// Matches Trade API / Signature Generation for GET Methods, including insertion
+// order, encodeURIComponent (not form '+' encoding), millisecond nonce, and hex.
+export function signedQuery(
+  entries: readonly (readonly [string, string])[],
+  secret: string,
+): { query: string; signature: string } {
+  const query = entries
+    .map(([key, value]) => `${encodeURIComponent(key)}=${encodeURIComponent(value)}`)
+    .join('&');
+  return { query, signature: createHmac('sha256', secret).update(query).digest('hex') };
+}
+export function signPostPayload(
+  payload: Record<string, unknown>,
+  secret: string,
+  now: number,
+): { body: string; signature: string } {
+  // Pure, OFFLINE utility for the documented Spot POST recipe. Never used by transport.
+  const body = JSON.stringify({ ...payload, timestamp: now });
+  return { body, signature: createHmac('sha256', secret).update(body).digest('hex') };
+}
+
+const amount = z.number().finite();
+export const spotMarketSchema = z.array(
+  z.object({
+    market: z.string(),
+    pair: z.string(),
+    virtualCurrency: z.string(),
+    currency: z.string(),
+    pricechange: z.string().optional(),
+    '24hoursHigh': z.string().optional(),
+    '24hoursLow': z.string().optional(),
+    volume: amount.optional(),
+  }),
+);
+export const tickerSchema = z.object({
+  market: z.string(),
+  pair: z.literal('BTC-INR'),
+  virtualCurrency: z.string(),
+  currency: z.literal('INR'),
+  buy: z.string(),
+  sell: z.string(),
+  pricechange: z.string(),
+  '24hoursHigh': z.string(),
+  '24hoursLow': z.string(),
+  volume: amount,
+});
+export const orderSchema = z.object({
+  id: z.number().int().positive().refine(Number.isSafeInteger),
+  price: amount,
+  size: amount,
+  type: z.string(),
+  trade_pair: z.string(),
+  side: z.string(),
+  created_at: z.number().int(),
+  executed_value: amount,
+  open_size: amount,
+  filled_size: amount,
+  status: z.string(),
+  market_order_amt: amount,
+  stop_price: amount,
+});
+const ordersEnvelope = z.object({
+  data: z.array(orderSchema),
+  statusCode: z.literal(200),
+  statusDescription: z.string(),
+});
+const futureEnvelope = <T extends z.ZodType>(data: T) =>
+  z.object({
+    statusCode: z.literal(200),
+    statusDescription: z.string(),
+    data,
+    customMessage: z.array(z.string()),
+  });
+export const futuresMarketsSchema = futureEnvelope(
+  z.object({
+    timezone: z.string(),
+    serverTime: z.number(),
+    symbols: z.array(
+      z.object({
+        symbol: z.string(),
+        status: z.string(),
+        baseAsset: z.string(),
+        quoteAsset: z.string(),
+        pricePrecision: z.number(),
+        quantityPrecision: z.number(),
+        makerFee: z.number(),
+        takerFee: z.number(),
+      }),
+    ),
+  }),
+);
+export const futuresInfoSchema = futureEnvelope(
+  z.record(
+    z.string(),
+    z.object({
+      marketPrice: z.string().optional(),
+      lastPrice: z.string().optional(),
+      priceChangePercent: z.string().optional(),
+      baseAssetVolume: z.string().optional(),
+    }),
+  ),
+);
+export const futuresBookSchema = futureEnvelope(
+  z.object({
+    symbol: z.string(),
+    bids: z.array(z.tuple([z.number(), z.number()])),
+    asks: z.array(z.tuple([z.number(), z.number()])),
+    timestamp: z.number(),
+  }),
+);
+export const futuresExchangeSchema = futureEnvelope(
+  z.object({
+    pairs: z.array(
+      z.object({
+        name: z.string(),
+        pair: z.string(),
+        baseAsset: z.string(),
+        quoteAsset: z.string(),
+        makerFee: z.number(),
+        takerFee: z.number(),
+        filters: z.array(
+          z.object({
+            filterType: z.string(),
+            minQty: z.string().optional(),
+            maxQty: z.string().optional(),
+            notional: z.string().optional(),
+            limit: z.string().optional(),
+          }),
+        ),
+        pricePrecision: z.string(),
+        quantityPrecision: z.string(),
+        limitPriceVarAllowed: z.number(),
+      }),
+    ),
+  }),
+);
+
+// Pin the SAVED nested ticker shape, not the contradictory flat prose object.
+// Keep duplicate values separate. A snapshot service reports disagreement.
+const rawNumeric = z
+  .string()
+  .refine(
+    (value) =>
+      /^[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[+-]?\d+)?$/i.test(value) && numeric(value) !== null,
+  );
+const rawNonnegative = rawNumeric.refine((value) => {
+  const parsed = numeric(value);
+  return parsed !== null && !parsed.startsWith('-');
+});
+const identifier = z.number().int().nonnegative().refine(Number.isSafeInteger);
+export const futuresTicker24hSchema = futureEnvelope(
+  z.object({
+    symbol: z.string(),
+    info: z.object({
+      eventTimestamp: identifier,
+      symbol: z.string(),
+      priceChange: rawNumeric,
+      priceChangePercentage: rawNumeric,
+      weightedAveragePrice: rawNonnegative,
+      lastPrice: rawNonnegative,
+      lastQuantityTraded: rawNonnegative,
+      openPrice: rawNonnegative,
+      highestPrice: rawNonnegative,
+      lowestPrice: rawNonnegative,
+      totalTradedVolume: rawNonnegative,
+      totalTradedQuoteAssetVolume: rawNonnegative,
+      startTime: identifier,
+      endTime: identifier,
+      firstTradeId: identifier,
+      lastTradeId: identifier,
+      numberOfTrades: identifier,
+    }),
+    timestamp: identifier,
+    datetime: z.string(),
+    high: amount,
+    low: amount,
+    vwap: amount,
+    open: amount,
+    close: amount,
+    last: amount,
+    change: amount,
+    percentage: amount,
+    average: amount,
+    baseVolume: amount,
+    quoteVolume: amount,
+  }),
+);
+export const futuresAggregatesSchema = futureEnvelope(
+  z.array(
+    z.object({
+      aggregateTradeId: identifier,
+      symbol: z.string(),
+      price: rawNonnegative,
+      quantity: rawNonnegative,
+      firstTradeId: identifier,
+      lastTradeId: identifier,
+      tradeTime: identifier,
+      isBuyerMarketMaker: z.boolean(),
+    }),
+  ),
+);
+const futuresHealthSchema = z.object({ message: z.literal('OK') });
+
+export function documentedResponse<T extends z.ZodType>(schema: T, raw: unknown): z.output<T> {
+  const result = schema.safeParse(raw);
+  if (!result.success)
+    throw new AppError(
+      'UNDOCUMENTED_RESPONSE',
+      'ZebPay returned a response that does not match the supplied collection. Data is unavailable; no fields or success status were guessed.',
+      502,
+    );
+  return result.data;
+}
+
+export class ZebpayClient {
+  constructor(
+    private fetcher: Fetcher = fetch,
+    private now: () => number = Date.now,
+    private timeoutMs = 8000,
+  ) {}
+  private async request(
+    operation: ReadOperation,
+    entries: [string, string][],
+    credentials?: Credentials,
+    signal?: AbortSignal,
+  ): Promise<unknown> {
+    const spec = READ_OPERATIONS[operation];
+    if (!spec)
+      throw new AppError(
+        'UNSUPPORTED_OPERATION',
+        'This operation is not supported by the audited collection.',
+        422,
+      );
+    const headers: Record<string, string> = { 'Content-Type': 'application/json' };
+    let query: string;
+    if (spec.private) {
+      if (!credentials)
+        throw new AppError('NOT_CONNECTED', 'Connect and verify ZebPay read access first.', 409);
+      const signed = signedQuery(
+        [...entries, ['timestamp', String(this.now())]],
+        credentials.apiSecret,
+      );
+      query = signed.query;
+      headers['X-AUTH-APIKEY'] = credentials.apiKey;
+      headers['X-AUTH-SIGNATURE'] = signed.signature;
+    } else {
+      query = entries
+        .map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`)
+        .join('&');
+      // Use the exact documented public headers; never attach account credentials.
+      if (
+        operation === 'futures.markets' ||
+        operation === 'futures.info' ||
+        operation === 'futures.book' ||
+        operation === 'futures.ticker24h'
+      ) {
+        delete headers['Content-Type'];
+        headers.accept = 'application/json';
+      }
+    }
+    const url = spec.url + (query ? `?${query}` : '');
+    const timeout = AbortSignal.timeout(this.timeoutMs);
+    const abort = signal ? AbortSignal.any([signal, timeout]) : timeout;
+    try {
+      // Exactly ONE attempt. Redirects are rejected to keep signed headers on the pinned host.
+      const response = await this.fetcher(url, {
+        method: 'GET',
+        headers,
+        redirect: 'error',
+        signal: abort,
+      });
+      if (response.status === 401)
+        throw new AppError(
+          'AUTH_FAILED',
+          'ZebPay rejected authentication. Check the key, secret, and server clock in your secured setup.',
+          401,
+        );
+      if (response.status === 403)
+        throw new AppError(
+          'PERMISSION_MISSING',
+          'ZebPay denied read access. Check API permissions and the server IP whitelist directly in ZebPay. The exact cause cannot be verified from this collection.',
+          403,
+        );
+      if (response.status === 429)
+        throw new AppError(
+          'RATE_LIMITED',
+          'ZebPay rate-limited this read. Wait before refreshing; no automatic private retry is performed.',
+          429,
+        );
+      if (!response.ok)
+        throw new AppError(
+          'EXCHANGE_UNAVAILABLE',
+          'The documented ZebPay endpoint could not complete this read. No sample data has been substituted.',
+          502,
+        );
+      if (Number(response.headers.get('content-length') ?? 0) > 5_000_000)
+        throw new AppError(
+          'RESPONSE_TOO_LARGE',
+          'The ZebPay response exceeded the safe read limit.',
+          502,
+        );
+      const reader = response.body?.getReader();
+      if (!reader)
+        throw new AppError('UNDOCUMENTED_RESPONSE', 'The ZebPay response was empty.', 502);
+      const chunks: Uint8Array[] = [];
+      let size = 0;
+      try {
+        while (true) {
+          const part = await reader.read();
+          if (part.done) break;
+          size += part.value.length;
+          if (size > 5_000_000) {
+            await reader.cancel();
+            throw new AppError(
+              'RESPONSE_TOO_LARGE',
+              'The ZebPay response exceeded the safe read limit.',
+              502,
+            );
+          }
+          chunks.push(part.value);
+        }
+      } finally {
+        reader.releaseLock();
+      }
+      try {
+        return JSON.parse(Buffer.concat(chunks).toString('utf8'));
+      } catch {
+        throw new AppError(
+          'UNDOCUMENTED_RESPONSE',
+          'ZebPay did not return the documented JSON format.',
+          502,
+        );
+      }
+    } catch (error) {
+      if (error instanceof AppError) throw error;
+      if (signal?.aborted)
+        throw new AppError(
+          'REQUEST_CANCELLED',
+          'This read was cancelled because the connection changed or was disconnected.',
+          409,
+        );
+      throw new AppError(
+        'ZEBPAY_UNREACHABLE',
+        'Cannot reach the documented ZebPay host. Check server outbound access, DNS, and IP rules. No sample data is substituted.',
+        503,
+      );
+    }
+  }
+  async spotMarkets(signal?: AbortSignal) {
+    return documentedResponse(
+      spotMarketSchema,
+      await this.request('spot.markets', [], undefined, signal),
+    );
+  }
+  async spotTicker(signal?: AbortSignal) {
+    return documentedResponse(
+      tickerSchema,
+      await this.request('spot.ticker', [['group', 'singapore']], undefined, signal),
+    );
+  }
+  async orders(
+    credentials: Credentials,
+    pair = 'BTC-INR',
+    status: 'pending' | 'complete' = 'pending',
+    page = 1,
+    orderId = '0',
+    signal?: AbortSignal,
+  ): Promise<Order[]> {
+    const entries: [string, string][] = [
+      ['trade_pair', pair],
+      ['status', status === 'pending' ? 'pending' : 'Complete'],
+      ['orderid', orderId],
+      ['page', String(page)],
+      ['limit', '500'],
+    ];
+    const response = documentedResponse(
+      ordersEnvelope,
+      await this.request(
+        status === 'pending' ? 'spot.pending' : 'spot.complete',
+        entries,
+        credentials,
+        signal,
+      ),
+    );
+    return response.data;
+  }
+  async futuresMarkets() {
+    return documentedResponse(futuresMarketsSchema, await this.request('futures.markets', []));
+  }
+  async futuresInfo() {
+    return documentedResponse(futuresInfoSchema, await this.request('futures.info', []));
+  }
+  async futuresBook(symbol: string) {
+    return documentedResponse(
+      futuresBookSchema,
+      await this.request('futures.book', [['symbol', symbol]]),
+    );
+  }
+  async futuresExchangeInfo() {
+    return documentedResponse(
+      futuresExchangeSchema,
+      await this.request('futures.exchangeInfo', []),
+    );
+  }
+  async futuresTicker24h(symbol: string) {
+    return documentedResponse(
+      futuresTicker24hSchema,
+      await this.request('futures.ticker24h', [['symbol', symbol]]),
+    );
+  }
+  async futuresAggregates(symbol: string) {
+    return documentedResponse(
+      futuresAggregatesSchema,
+      await this.request('futures.aggregates', [['symbol', symbol]]),
+    );
+  }
+  async futuresHealth() {
+    return documentedResponse(futuresHealthSchema, await this.request('futures.health', []));
+  }
+}
