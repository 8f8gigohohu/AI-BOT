+import { useEffect, useRef, useState } from 'react';
+import { Activity, RefreshCw } from 'lucide-react';
+import type { FuturesPublicSnapshot, PublicRead } from '../../shared/types';
+import { api, formatTime } from '../api';
+import { Badge, Button, Empty, Notice, Panel } from './ui';
+
+export function FuturesInsights({
+  symbol,
+  observationTime,
+}: {
+  symbol: string;
+  observationTime: number | undefined;
+}) {
+  const [snapshot, setSnapshot] = useState<FuturesPublicSnapshot | null>(null);
+  const [error, setError] = useState(''),
+    [loading, setLoading] = useState(false),
+    [refresh, setRefresh] = useState(0);
+  const [health, setHealth] = useState<PublicRead<{ message: 'OK' }> | null>(null);
+  const [healthError, setHealthError] = useState(''),
+    [checking, setChecking] = useState(false);
+  const healthController = useRef<AbortController | null>(null);
+  useEffect(() => () => healthController.current?.abort(), []);
+  useEffect(() => {
+    const controller = new AbortController();
+    setSnapshot(null);
+    setError('');
+    setLoading(true);
+    api<FuturesPublicSnapshot>(
+      `/api/futures/snapshot?symbol=${encodeURIComponent(symbol)}`,
+      'GET',
+      undefined,
+      controller.signal,
+    )
+      .then((result) => {
+        if (!controller.signal.aborted) setSnapshot(result);
+      })
+      .catch((e) => {
+        if (!controller.signal.aborted) setError(e.message);
+      })
+      .finally(() => {
+        if (!controller.signal.aborted) setLoading(false);
+      });
+    return () => controller.abort();
+  }, [symbol, observationTime, refresh]);
+  async function checkHealth() {
+    healthController.current?.abort();
+    const controller = new AbortController();
+    healthController.current = controller;
+    setChecking(true);
+    setHealthError('');
+    setHealth(null);
+    try {
+      const result = await api<PublicRead<{ message: 'OK' }>>(
+        '/api/futures/health',
+        'GET',
+        undefined,
+        controller.signal,
+      );
+      if (!controller.signal.aborted) setHealth(result);
+    } catch (e) {
+      if (!controller.signal.aborted) setHealthError((e as Error).message);
+    } finally {
+      if (!controller.signal.aborted) setChecking(false);
+    }
+  }
+  const ticker = snapshot?.ticker.data;
+  const aggregates = snapshot?.aggregates.data;
+  const values = ticker
+    ? [
+        ['lastPrice', ticker.info.lastPrice],
+        ['highestPrice', ticker.info.highestPrice],
+        ['lowestPrice', ticker.info.lowestPrice],
+        ['openPrice', ticker.info.openPrice],
+        ['totalTradedVolume', ticker.info.totalTradedVolume],
+        ['totalTradedQuoteAssetVolume', ticker.info.totalTradedQuoteAssetVolume],
+      ]
+    : [];
+  return (
+    <section className="futures-insights" aria-label="Futures public observations">
+      <div className="futures-read-toolbar">
+        <div>
+          <Badge tone="purple">PUBLIC DATA ONLY</Badge>
+          <span>
+            Exact symbol <strong className="mono">{symbol}</strong> · 15-second read cache
+          </span>
+        </div>
+        <Button variant="ghost" busy={loading} onClick={() => setRefresh((n) => n + 1)}>
+          <RefreshCw size={14} />
+          Refresh public snapshots
+        </Button>
+      </div>
+      <div className="futures-readouts">
+        <Panel
+          title="Reported 24-hour ticker"
+          description="Values below come from data.info. This snapshot is not an executable quote."
+        >
+          {snapshot && ticker ? (
+            <>
+              <div className="futures-stat-grid">
+                {values.map(([label, value]) => (
+                  <div key={label}>
+                    <span>{label}</span>
+                    <strong className="mono">{value}</strong>
+                  </div>
+                ))}
+              </div>
+              <div className="raw-percentages">
+                <div>
+                  <span>info.priceChangePercentage · raw</span>
+                  <strong className="mono">{ticker.info.priceChangePercentage}</strong>
+                </div>
+                <div>
+                  <span>data.percentage · raw</span>
+                  <strong className="mono">{ticker.percentage}</strong>
+                </div>
+              </div>
+              {snapshot.conflicts.length > 0 && (
+                <div className="padded-notice">
+                  <Notice tone="amber" title="Ticker fields disagree">
+                    {snapshot.conflicts.map((conflict) => (
+                      <p key={conflict}>{conflict}</p>
+                    ))}
+                    These parallel fields are not merged or used for signals.
+                  </Notice>
+                </div>
+              )}
+              <div className="snapshot-foot">
+                Received {formatTime(snapshot.ticker.receivedAt)} UTC · Exchange timestamp (raw):{' '}
+                <span className="mono">{ticker.timestamp}</span>
+              </div>
+              <details className="public-raw-details">
+                <summary>Inspect documented raw ticker fields</summary>
+                <pre>{JSON.stringify(ticker, null, 2)}</pre>
+              </details>
+            </>
+          ) : (
+            <Empty
+              compact
+              title={loading ? 'Reading public ticker' : 'Ticker unavailable'}
+              text={
+                error ||
+                snapshot?.ticker.reason ||
+                'No documented ticker response has been received. No example values are used.'
+              }
+            />
+          )}
+        </Panel>
+        <Panel
+          title="Public aggregate trades"
+          description="Market-wide aggregates — not your account fills, order history, or evidence of execution."
+        >
+          {snapshot && aggregates?.trades.length ? (
+            <>
+              <div className="table-scroll">
+                <table className="aggregate-table">
+                  <thead>
+                    <tr>
+                      <th>Aggregate ID</th>
+                      <th>Price</th>
+                      <th>Quantity</th>
+                      <th>Buyer is maker</th>
+                      <th>tradeTime · raw</th>
+                    </tr>
+                  </thead>
+                  <tbody>
+                    {aggregates.trades.slice(0, 20).map((trade, i) => (
+                      <tr key={`${trade.aggregateTradeId}-${i}`}>
+                        <td className="mono">{trade.aggregateTradeId}</td>
+                        <td className="mono">{trade.price}</td>
+                        <td className="mono">{trade.quantity}</td>
+                        <td>{String(trade.isBuyerMarketMaker)}</td>
+                        <td className="mono muted">{trade.tradeTime}</td>
+                      </tr>
+                    ))}
+                  </tbody>
+                </table>
+              </div>
+              <p className="snapshot-foot">
+                Showing {Math.min(20, aggregates.trades.length)} of {aggregates.returnedCount}{' '}
+                returned aggregates · received {formatTime(snapshot.aggregates.receivedAt)} UTC. No
+                pagination or historical backfill is inferred.
+              </p>
+            </>
+          ) : (
+            <Empty
+              compact
+              title={
+                loading
+                  ? 'Reading public aggregates'
+                  : aggregates
+                    ? 'No aggregates in this response'
+                    : 'Public aggregates unavailable'
+              }
+              text={
+                error ||
+                snapshot?.aggregates.reason ||
+                'An empty or unavailable public tape is not a statement about your private account fills.'
+              }
+            />
+          )}
+        </Panel>
+      </div>
+      <div className="futures-health-row">
+        <Activity size={18} />
+        <div>
+          <strong>
+            {health?.status === 'available'
+              ? 'Public service reported OK'
+              : health || healthError
+                ? 'Public health unavailable'
+                : 'Public health not checked'}
+          </strong>
+          <p>
+            {health?.status === 'unavailable'
+              ? health.reason
+              : healthError ||
+                'This service-health read does not verify an API key, account, trading permission, or IP whitelist.'}
+          </p>
+        </div>
+        <Button variant="secondary" busy={checking} onClick={checkHealth}>
+          Check public service
+        </Button>
+      </div>
+    </section>
+  );
+}
