+  it('blocks on mark-to-market daily loss and rejects projected fee/slippage breaches atomically', async () => {
+    const t = makeTestApp();
+    const o = await owner(t.app);
+    t.store.set('risk', { ...t.store.risk(), dailyLossInr: '0.01' });
+    expect((await o.post('/api/orders', paperOrder())).body.error.code).toBe(
+      'PROJECTED_DAILY_LOSS',
+    );
+    expect(t.store.wallet().cash).toBe('100000');
+    expect(t.store.trades(t.store.wallet().portfolioId)).toHaveLength(0);
+    t.store.set('risk', { ...t.store.risk(), dailyLossInr: '5' });
+    await o.post('/api/orders', paperOrder());
+    t.advance(16000);
+    t.state.price = '90';
+    expect((await o.post('/api/orders', paperOrder('2'))).body.error.code).toBe('DAILY_LOSS_LIMIT');
+    expect(t.store.trades(t.store.wallet().portfolioId)).toHaveLength(1);
