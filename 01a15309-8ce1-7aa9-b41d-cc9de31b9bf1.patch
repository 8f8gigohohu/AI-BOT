new file mode 100644
index 0000000..8b58d11
--- /dev/null
+++ b/scripts/setup.mjs
@@ -0,0 +1,128 @@
+import dotenv from 'dotenv';
+import {
+  mkdirSync,
+  writeFileSync,
+  readFileSync,
+  existsSync,
+  chmodSync,
+  renameSync,
+  unlinkSync,
+} from 'node:fs';
+import { randomBytes, scryptSync } from 'node:crypto';
+import { resolve, sep } from 'node:path';
+import { createInterface } from 'node:readline/promises';
+import { Writable } from 'node:stream';
+
+dotenv.config({ quiet: true });
+if (!process.stdin.isTTY) {
+  console.error(
+    'Run npm run setup in your own interactive terminal. It asks for a new workspace password, NOT your ZebPay secret. No password is printed or accepted as a command-line argument.',
+  );
+  process.exit(1);
+}
+process.umask(0o077);
+let muted = false;
+const output = new Writable({
+  write(chunk, _encoding, callback) {
+    if (!muted) process.stdout.write(chunk);
+    callback();
+  },
+});
+const rl = createInterface({ input: process.stdin, output, terminal: true });
+async function hidden(question) {
+  process.stdout.write(question);
+  muted = true;
+  try {
+    return await rl.question('');
+  } finally {
+    muted = false;
+    process.stdout.write('\n');
+  }
+}
+try {
+  const dir = resolve(process.env.DARKDEVIL_DATA_DIR ?? '.runtime'),
+    appDir = resolve('.');
+  const reserved = [
+    'public',
+    'dist',
+    'src',
+    'server',
+    'shared',
+    'tests',
+    'scripts',
+    'docs',
+    '.git',
+    '.github',
+    'node_modules',
+  ];
+  if (
+    dir === appDir ||
+    appDir.startsWith(dir.endsWith(sep) ? dir : dir + sep) ||
+    reserved.some((name) => {
+      const path = resolve(appDir, name);
+      return dir === path || dir.startsWith(path + sep);
+    })
+  )
+    throw new Error(
+      'Choose a dedicated private DARKDEVIL_DATA_DIR, not an application, source, or public directory.',
+    );
+  if (process.env.DARKDEVIL_OWNER_HASH)
+    throw new Error(
+      'A backend DARKDEVIL_OWNER_HASH override is active. Remove that override before using file-based owner setup.',
+    );
+  const keyFile = resolve(dir, 'master.key'),
+    vaultFile = resolve(dir, 'zebpay.enc');
+  if (process.env.DARKDEVIL_MASTER_KEY) {
+    const key = Buffer.from(process.env.DARKDEVIL_MASTER_KEY, 'base64');
+    if (key.length !== 32 || key.toString('base64') !== process.env.DARKDEVIL_MASTER_KEY)
+      throw new Error(
+        'The backend master key must be canonical base64 encoding of exactly 32 bytes.',
+      );
+  } else {
+    if (process.env.NODE_ENV === 'production')
+      throw new Error('Production requires DARKDEVIL_MASTER_KEY from your backend secret manager.');
+    if (!existsSync(keyFile) && existsSync(vaultFile))
+      throw new Error(
+        'Restore the original master key for the existing vault; no replacement key was generated.',
+      );
+    if (existsSync(keyFile) && readFileSync(keyFile).length !== 32)
+      throw new Error('Invalid local master key. Restore the original; it was not replaced.');
+  }
+  console.log(
+    '\nDarkDevil Quant · secure owner setup\nThis password protects your private workspace. It is NOT a ZebPay credential.\n',
+  );
+  const password = await hidden('New workspace password (at least 14 characters): ');
+  if (password.length < 14 || password.length > 256)
+    throw new Error('Use a unique password of 14–256 characters.');
+  if (password !== (await hidden('Confirm workspace password: ')))
+    throw new Error('Passwords do not match.');
+  mkdirSync(dir, { recursive: true, mode: 0o700 });
+  chmodSync(dir, 0o700);
+  if (!process.env.DARKDEVIL_MASTER_KEY && !existsSync(keyFile))
+    writeFileSync(keyFile, randomBytes(32), { mode: 0o600, flag: 'wx' });
+  if (existsSync(keyFile)) chmodSync(keyFile, 0o600);
+  const salt = randomBytes(16),
+    hash = scryptSync(password, salt, 64);
+  const ownerFile = resolve(dir, 'owner.json'),
+    temp = `${ownerFile}.${randomBytes(8).toString('hex')}.tmp`;
+  try {
+    writeFileSync(
+      temp,
+      JSON.stringify({ passwordHash: `scrypt:${salt.toString('hex')}:${hash.toString('hex')}` }) +
+        '\n',
+      { mode: 0o600, flag: 'wx' },
+    );
+    renameSync(temp, ownerFile);
+    chmodSync(ownerFile, 0o600);
+  } finally {
+    if (existsSync(temp)) unlinkSync(temp);
+  }
+  console.log(
+    '\nOwner access configured. Restart the server, then use Unlock workspace.\nProduction requires HTTPS and DARKDEVIL_MASTER_KEY from your host secret manager.\nDo not share or commit the private runtime directory. API credentials are entered only on the protected connection page.\n',
+  );
+} catch (e) {
+  console.error(e.message ?? 'Setup failed.');
+  process.exitCode = 1;
+} finally {
+  rl.close();
+}
