+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { randomBytes, scryptSync } from 'node:crypto';
+import request from 'supertest';
+import { vi } from 'vitest';
+import { createApplication } from '../server/app';
+import { newPaperWallet } from '../server/store';
+import type { Config } from '../server/config';
+import type { Fetcher } from '../server/zebpay';
+import {
+  envelope,
+  futureInfoData,
+  futureMarketData,
+  spotRows,
+  TEST_PASSWORD,
+  futureTickerData,
+  futureAggregateData,
+} from './fixtures';
+
+const contexts: { close: () => void; dir: string }[] = [];
+export function mockTransport() {
+  const state = { price: '100', orders: [] as unknown[], failure: null as Response | Error | null };
+  const fetcher = vi.fn<Fetcher>(async (url, init) => {
+    if (state.failure instanceof Error) throw state.failure;
+    if (state.failure instanceof Response) return state.failure.clone();
+    const u = new URL(url);
+    if (init.method !== 'GET') throw new Error('TEST TRANSPORT REJECTED A MUTATION');
+    if (u.hostname === 'www.zebapi.com' && u.pathname === '/api/v1/market')
+      return Response.json(spotRows(state.price));
+    if (u.hostname === 'www.zebapi.com' && u.pathname === '/api/v1/orders')
+      return Response.json(envelope(state.orders));
+    if (u.hostname === 'www.zebapi.com' && u.pathname === '/api/v1/market/BTC-INR/ticker')
+      return Response.json({ ...spotRows(state.price)[0], buy: '101', sell: '99' });
+    if (u.hostname === 'futuresbe.zebpay.com' && u.pathname === '/api/v1/market/markets')
+      return Response.json(futureMarketData());
+    if (u.hostname === 'futuresbe.zebpay.com' && u.pathname === '/api/v1/market/marketInfo')
+      return Response.json(futureInfoData());
+    if (u.hostname === 'futuresbe.zebpay.com' && u.pathname === '/api/v1/market/ticker24Hr')
+      return Response.json(futureTickerData(u.searchParams.get('symbol') ?? 'BTCUSDT'));
+    if (u.hostname === 'futuresbe.zebpay.com' && u.pathname === '/api/v1/market/aggTrade')
+      return Response.json(futureAggregateData(u.searchParams.get('symbol') ?? 'BTCUSDT'));
+    if (u.hostname === 'futuresbe.zebpay.com' && u.pathname === '/healthCheckStatus')
+      return Response.json({ message: 'OK' });
+    if (u.hostname === 'futuresbe.zebpay.com' && u.pathname === '/api/v1/market/orderBook')
+      return Response.json({
+        statusDescription: 'OK',
+        statusCode: 200,
+        customMessage: ['OK'],
+        data: {
+          symbol: u.searchParams.get('symbol'),
+          bids: [[100, 1]],
+          asks: [[101, 2]],
+          timestamp: 1792404000000,
+        },
+      });
+    throw new Error('TEST TRANSPORT DOES NOT KNOW THIS DOCUMENTED READ');
+  });
+  return { fetcher, state };
+}
+export function makeTestApp(
+  options: { fetcher?: Fetcher; configured?: boolean; config?: Config; timeoutMs?: number } = {},
+) {
+  let time = Date.UTC(2026, 9, 19, 10, 0, 0);
+  const dir = options.config?.dataDir ?? mkdtempSync(join(tmpdir(), 'darkdevil-test-'));
+  const salt = randomBytes(16);
+  const config: Config = options.config ?? {
+    dataDir: dir,
+    masterKey: randomBytes(32),
+    ownerHash:
+      options.configured === false
+        ? null
+        : `scrypt:${salt.toString('hex')}:${scryptSync(TEST_PASSWORD, salt, 64).toString('hex')}`,
+    publicOrigin: 'http://localhost',
+    production: false,
+  };
+  const mock = mockTransport();
+  const runtime = createApplication(config, {
+    fetcher: options.fetcher ?? mock.fetcher,
+    now: () => time,
+    timeoutMs: options.timeoutMs,
+  });
+  if (!options.config) runtime.store.set('paper', newPaperWallet(time));
+  let closed = false;
+  const close = () => {
+    if (!closed) {
+      runtime.close();
+      closed = true;
+    }
+  };
+  contexts.push({ close, dir });
+  return {
+    ...runtime,
+    config,
+    ...mock,
+    now: () => time,
+    advance: (ms: number) => {
+      time += ms;
+    },
+    close,
+  };
+}
+export function cleanup() {
+  const previous = contexts.splice(0);
+  for (const ctx of previous) ctx.close();
+  for (const dir of new Set(previous.map((ctx) => ctx.dir)))
+    rmSync(dir, { recursive: true, force: true });
+}
+export async function owner(app: ReturnType<typeof createApplication>['app']) {
+  const agent = request.agent(app);
+  const initial = await agent.get('/api/session').set('Host', 'localhost');
+  const login = await agent
+    .post('/api/session/login')
+    .set('Host', 'localhost')
+    .set('Origin', 'http://localhost')
+    .set('X-CSRF-Token', initial.body.csrfToken)
+    .send({ password: TEST_PASSWORD });
+  if (login.status !== 200) throw new Error(`Test login failed (${login.status}).`);
+  const csrf = login.body.csrfToken;
+  return {
+    agent,
+    csrf,
+    get: (path: string) => agent.get(path).set('Host', 'localhost'),
+    post: (path: string, body: object | string = {}) =>
+      agent
+        .post(path)
+        .set('Host', 'localhost')
+        .set('Origin', 'http://localhost')
+        .set('X-CSRF-Token', csrf)
+        .send(body),
+    delete: (path: string) =>
+      agent
+        .delete(path)
+        .set('Host', 'localhost')
+        .set('Origin', 'http://localhost')
+        .set('X-CSRF-Token', csrf)
+        .send({}),
+  };
+}
