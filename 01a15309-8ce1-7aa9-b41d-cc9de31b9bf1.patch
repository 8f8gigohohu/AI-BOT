--- /dev/null
+++ b/server/journal.ts
@@ -0,0 +1,112 @@
+import Decimal from 'decimal.js';
+import type {
+  DecisionFills,
+  DecisionOutcome,
+  JournalView,
+  PaperPerformance,
+} from '../shared/types.js';
+import { Store } from './store.js';
+import { AppError } from './errors.js';
+
+// Roll up persisted decimal strings, never SQLite floating-point SUM(). These
+// are local simulated executions, NOT forecasts, account profits, or AI accuracy.
+const Sum = Decimal.clone({ precision: 80 });
+const add = (a: string, b: string) => new Sum(a).add(b).toString();
+export const DECISION_PAGE_SIZE = 25;
+export const DECISION_FILL_PAGE_SIZE = 20;
+
+export class JournalService {
+  constructor(private store: Store) {}
+  performance(): PaperPerformance {
+    const portfolioId = this.store.wallet().portfolioId;
+    const result: PaperPerformance = {
+      portfolioId,
+      fills: 0,
+      buys: 0,
+      sells: 0,
+      profitableSells: 0,
+      losingSells: 0,
+      breakEvenSells: 0,
+      profitableSellPercent: null,
+      assumedFees: '0',
+      realizedPnl: '0',
+      firstFillAt: null,
+      lastFillAt: null,
+    };
+    for (const trade of this.store.allPortfolioTrades(portfolioId)) {
+      result.fills++;
+      result.assumedFees = add(result.assumedFees, trade.fee);
+      result.firstFillAt = Math.min(result.firstFillAt ?? trade.createdAt, trade.createdAt);
+      result.lastFillAt = Math.max(result.lastFillAt ?? trade.createdAt, trade.createdAt);
+      if (trade.side === 'buy') result.buys++;
+      else {
+        result.sells++;
+        result.realizedPnl = add(result.realizedPnl, trade.realizedPnl);
+        const pnl = new Sum(trade.realizedPnl);
+        if (pnl.gt(0)) result.profitableSells++;
+        else if (pnl.lt(0)) result.losingSells++;
+        else result.breakEvenSells++;
+      }
+    }
+    if (result.sells)
+      result.profitableSellPercent = new Sum(result.profitableSells)
+        .div(result.sells)
+        .mul(100)
+        .toNumber();
+    return result;
+  }
+  view(decisionPage = 1): JournalView {
+    const decisions = this.store.decisions(decisionPage, DECISION_PAGE_SIZE);
+    const outcomes: Record<string, DecisionOutcome> = {};
+    const current = this.store.wallet().portfolioId;
+    for (const decision of decisions)
+      outcomes[decision.id] = {
+        decisionId: decision.id,
+        fills: 0,
+        currentWalletFills: 0,
+        archivedWalletFills: 0,
+        quantity: '0',
+        notional: '0',
+        assumedFees: '0',
+        // An entry fill has no realized exit attribution. A linked SELL reports
+        // that fill's average-cost P&L, not the success of a preceding BUY signal.
+        sellRealizedPnl: null,
+        lastFillAt: null,
+      };
+    for (const trade of this.store.allDecisionTrades(decisions.map((d) => d.id))) {
+      const outcome = outcomes[trade.decisionId!]!;
+      outcome.fills++;
+      if (trade.portfolioId === current) outcome.currentWalletFills++;
+      else outcome.archivedWalletFills++;
+      outcome.quantity = add(outcome.quantity, trade.quantity);
+      outcome.notional = add(outcome.notional, trade.notional);
+      outcome.assumedFees = add(outcome.assumedFees, trade.fee);
+      if (trade.side === 'sell')
+        outcome.sellRealizedPnl = add(outcome.sellRealizedPnl ?? '0', trade.realizedPnl);
+      outcome.lastFillAt = Math.max(outcome.lastFillAt ?? trade.createdAt, trade.createdAt);
+    }
+    return {
+      decisions,
+      decisionPage,
+      decisionPageSize: DECISION_PAGE_SIZE,
+      decisionCount: this.store.decisionCount(),
+      outcomes,
+      performance: this.performance(),
+      backtests: this.store.backtests(),
+      trades: this.store.trades(current),
+      audit: this.store.auditEvents(),
+      auditIntegrity: this.store.verifyAudit(),
+    };
+  }
+  fills(decisionId: string, page: number): DecisionFills {
+    if (!this.store.decision(decisionId))
+      throw new AppError('DECISION_NOT_FOUND', 'This local research decision does not exist.', 404);
+    return {
+      decisionId,
+      page,
+      pageSize: DECISION_FILL_PAGE_SIZE,
+      currentPortfolioId: this.store.wallet().portfolioId,
+      ...this.store.decisionFills(decisionId, page, DECISION_FILL_PAGE_SIZE),
+    };
+  }
+}
diff --git a/server/live-safety.ts b/server/live-safety.ts
new file mode 100644
index 0000000..8dd9c5b
--- /dev/null
+++ b/server/live-safety.ts
@@ -0,0 +1,91 @@
+import { z } from 'zod';
+import Decimal from 'decimal.js';
+import { LIVE_BLOCKERS } from '../shared/capabilities.js';
+import { AppError } from './errors.js';
+import { Store } from './store.js';
+import { parse, quantity, spotPair } from './validation.js';
+
+// OFFLINE schemas match requests 4–7 exactly. No undocumented client-order ID,
+// recvWindow, endpoint, order type, or Futures signing is introduced.
+const limit = z
+  .object({
+    type: z.literal('limit'),
+    pair: spotPair,
+    side: z.enum(['buy', 'sell']),
+    quantity,
+    price: quantity,
+  })
+  .strict();
+const marketBuy = z
+  .object({
+    type: z.literal('market'),
+    pair: spotPair,
+    side: z.literal('buy'),
+    marketOrderValue: quantity,
+  })
+  .strict();
+const marketSell = z
+  .object({ type: z.literal('market'), pair: spotPair, side: z.literal('sell'), quantity })
+  .strict();
+export const documentedSpotInput = z.union([limit, marketBuy, marketSell]);
+export function documentedSpotPayload(raw: unknown, timestamp: number): Record<string, unknown> {
+  const order = parse(documentedSpotInput, raw);
+  const toSafeNumber = (value: string) => {
+    const n = Number(value);
+    if (
+      !Number.isFinite(n) ||
+      n <= 0 ||
+      n > Number.MAX_SAFE_INTEGER ||
+      !new Decimal(value).eq(String(n))
+    )
+      throw new AppError(
+        'INVALID_ORDER_NUMBER',
+        'The numeric order field cannot be represented safely.',
+      );
+    return n;
+  };
+  if (!Number.isSafeInteger(timestamp) || timestamp <= 0)
+    throw new AppError('INVALID_TIMESTAMP', 'A millisecond timestamp is required.');
+  return {
+    trade_pair: order.pair,
+    side: order.side === 'buy' ? 'bid' : 'ask',
+    ...(order.type === 'limit'
+      ? { size: toSafeNumber(order.quantity), price: toSafeNumber(order.price) }
+      : order.side === 'buy'
+        ? { marketOrderValue: toSafeNumber(order.marketOrderValue) }
+        : { size: toSafeNumber(order.quantity) }),
+    tradeType: order.type === 'limit' ? 1 : 2,
+    platform: 'API_Trading',
+    timestamp,
+  };
+}
+export class LiveSafety {
+  readonly enabled = false;
+  readonly blockers = [...LIVE_BLOCKERS];
+  constructor(private store: Store) {}
+  requestEnable(confirmation: string): never {
+    if (confirmation !== 'I UNDERSTAND LIVE TRADING CAN LOSE MONEY')
+      throw new AppError(
+        'RISK_CONFIRMATION_REQUIRED',
+        'Explicit risk confirmation is required even to check live readiness.',
+        409,
+      );
+    this.store.audit('live_enable_blocked', { reasonCode: 'COLLECTION_INCOMPLETE' });
+    throw new AppError(
+      'LIVE_UNSUPPORTED',
+      'Live trading cannot be enabled safely with this collection. Balance schemas, Spot trading filters, and permission checks are incomplete. Review the collection audit; no exchange order was sent.',
+      422,
+    );
+  }
+  rejectOrder(): never {
+    const code = this.store.risk().killSwitch ? 'KILL_SWITCH_ACTIVE' : 'LIVE_DISABLED';
+    this.store.audit('live_order_blocked', { reasonCode: code });
+    throw new AppError(
+      code,
+      this.store.risk().killSwitch
+        ? 'The emergency stop is active. No order was sent.'
+        : 'Live trading is disabled and cannot be activated with the supplied collection. No exchange order was sent.',
+      409,
+    );
+  }
+}
diff --git a/server/markets.ts b/server/markets.ts
new file mode 100644
index 0000000..cb9488c
--- /dev/null
+++ b/server/markets.ts
@@ -0,0 +1,265 @@
+import Decimal from 'decimal.js';
+import type {
+  FuturesPublicSnapshot,
+  PublicRead,
+  Market,
+  MarketView,
+  Venue,
+} from '../shared/types.js';
+import { ZebpayClient } from './zebpay.js';
+import { Store } from './store.js';
+import { numeric } from './validation.js';
+import { AppError, safeError } from './errors.js';
+import { PublicReadCache } from './public-cache.js';
+
+const CACHE_MS = 15000;
+export class MarketService {
+  private cache = new Map<Venue, { until: number; markets: Market[] }>();
+  private loading = new Map<Venue, Promise<Market[]>>();
+  private publicReads: PublicReadCache;
+  constructor(
+    private client: ZebpayClient,
+    private store: Store,
+    private now: () => number = Date.now,
+  ) {
+    this.publicReads = new PublicReadCache(now);
+  }
+  async list(venue: Venue): Promise<Market[]> {
+    const cached = this.cache.get(venue);
+    if (cached && cached.until > this.now()) return cached.markets;
+    const inflight = this.loading.get(venue);
+    if (inflight) return inflight;
+    const promise = this.load(venue);
+    this.loading.set(venue, promise);
+    try {
+      const markets = await promise;
+      this.cache.set(venue, { until: this.now() + CACHE_MS, markets });
+      return markets;
+    } finally {
+      this.loading.delete(venue);
+    }
+  }
+  private async load(venue: Venue): Promise<Market[]> {
+    if (venue === 'spot') {
+      const data = await this.client.spotMarkets();
+      const observedAt = this.now();
+      return data
+        .filter(
+          (r) =>
+            /^[A-Z0-9]{1,20}-[A-Z0-9]{1,10}$/.test(r.pair) &&
+            r.pair === `${r.virtualCurrency}-${r.currency}`,
+        )
+        .map((r) => ({
+          venue,
+          pair: r.pair,
+          base: r.virtualCurrency,
+          quote: r.currency,
+          price: numeric(r.market, true),
+          change24h: numeric(r.pricechange) === null ? null : Number(r.pricechange),
+          high24h: numeric(r['24hoursHigh'], true),
+          low24h: numeric(r['24hoursLow'], true),
+          volume: numeric(r.volume),
+          observedAt,
+          exchangeTimestamp: null,
+        }));
+    }
+    const [metadata, prices] = await Promise.all([
+      this.futuresMetadata(),
+      this.client.futuresInfo(),
+    ]);
+    const observedAt = this.now();
+    return metadata.data.symbols.map((s) => {
+      const price = prices.data[s.symbol];
+      return {
+        venue,
+        pair: s.symbol,
+        base: s.baseAsset,
+        quote: s.quoteAsset,
+        // A raw marketPrice from the exact symbol is used. No INR/USDT conversion or symbol rewriting.
+        price: numeric(price?.marketPrice, true),
+        change24h:
+          numeric(price?.priceChangePercent) === null ? null : Number(price?.priceChangePercent),
+        high24h: null,
+        low24h: null,
+        volume: numeric(price?.baseAssetVolume),
+        observedAt,
+        exchangeTimestamp: null,
+        makerFeeRaw: s.makerFee,
+        takerFeeRaw: s.takerFee,
+      };
+    });
+  }
+  async view(venue: Venue, pair: string, range: '1h' | '6h' | '24h' | 'all'): Promise<MarketView> {
+    const duration = {
+      '1h': 3_600_000,
+      '6h': 21_600_000,
+      '24h': 86_400_000,
+      all: Number.POSITIVE_INFINITY,
+    }[range];
+    let markets: Market[] = [];
+    let selected: Market | null = null;
+    let reason: string | null = null;
+    try {
+      markets = await this.list(venue);
+      selected = markets.find((m) => m.pair === pair) ?? null;
+      if (!selected)
+        reason =
+          'The requested symbol was not returned by the documented market endpoint. No substitute market is used.';
+      else if (!selected.price)
+        reason = 'ZebPay did not provide a positive, documented price for this exact market.';
+      else this.store.observe(venue, pair, selected.observedAt, selected.price);
+    } catch (e) {
+      reason = safeError(e).publicMessage;
+    }
+    return {
+      status: selected?.price ? 'available' : 'unavailable',
+      reason,
+      markets,
+      selected,
+      history: this.store.history(
+        venue,
+        pair,
+        Number.isFinite(duration) ? this.now() - duration : 0,
+        1000,
+      ),
+      source:
+        venue === 'spot'
+          ? 'ZebPay · GET /api/v1/market'
+          : 'ZebPay Futures · GET /market/markets + /market/marketInfo',
+      pollSeconds: 15,
+    };
+  }
+  async paperMarkets(): Promise<Market[]> {
+    const markets = (await this.list('spot')).filter((m) => m.quote === 'INR');
+    if (!markets.length)
+      throw new AppError(
+        'NO_MARKET_DATA',
+        'No verified INR markets are available from ZebPay. Paper execution is paused.',
+        409,
+      );
+    if (markets.some((m) => this.now() - m.observedAt > 30000 || m.observedAt > this.now()))
+      throw new AppError(
+        'STALE_MARKET_DATA',
+        'Market observations are stale. Refresh before simulating an order.',
+        409,
+      );
+    return markets;
+  }
+  private futuresMetadata() {
+    return this.publicReads.read('futures.metadata', () => this.client.futuresMarkets());
+  }
+  private async publicObservation<T>(read: () => Promise<T>): Promise<PublicRead<T>> {
+    try {
+      return { status: 'available', data: await read(), receivedAt: this.now(), reason: null };
+    } catch (e) {
+      return {
+        status: 'unavailable',
+        data: null,
+        receivedAt: null,
+        reason: safeError(e).publicMessage,
+      };
+    }
+  }
+  async futuresSnapshot(symbol: string): Promise<FuturesPublicSnapshot> {
+    // Validate against actual metadata without depending on marketInfo's price
+    // availability. Never rewrite a symbol or substitute its quote currency.
+    const metadata = await this.futuresMetadata();
+    const market = metadata.data.symbols.find((m) => m.symbol === symbol);
+    if (!market)
+      throw new AppError(
+        'UNSUPPORTED_MARKET',
+        'This exact symbol was not returned by ZebPay Futures.',
+        422,
+      );
+    return this.publicReads.read(`futures.snapshot:${symbol}`, async () => {
+      const [ticker, aggregates] = await Promise.all([
+        this.publicObservation(async () => {
+          const result = (await this.client.futuresTicker24h(symbol)).data;
+          if (result.symbol !== symbol || result.info.symbol !== symbol)
+            throw new AppError(
+              'SYMBOL_MISMATCH',
+              'The ticker response did not match the exact requested symbol.',
+              502,
+            );
+          return result;
+        }),
+        this.publicObservation(async () => {
+          const result = (await this.client.futuresAggregates(symbol)).data;
+          if (result.some((t) => t.symbol !== symbol))
+            throw new AppError(
+              'SYMBOL_MISMATCH',
+              'The aggregate-trade response included a different symbol. No rows were substituted.',
+              502,
+            );
+          return {
+            trades: result
+              .slice()
+              .sort((a, b) => b.tradeTime - a.tradeTime || b.aggregateTradeId - a.aggregateTradeId)
+              .slice(0, 200),
+            returnedCount: result.length,
+            truncated: result.length > 200,
+          };
+        }),
+      ]);
+      const conflicts: string[] = [];
+      if (ticker.data) {
+        const pairs = [
+          ['priceChangePercentage', 'percentage'],
+          ['lastPrice', 'last'],
+          ['highestPrice', 'high'],
+          ['lowestPrice', 'low'],
+          ['openPrice', 'open'],
+          ['weightedAveragePrice', 'vwap'],
+          ['priceChange', 'change'],
+          ['totalTradedVolume', 'baseVolume'],
+          ['totalTradedQuoteAssetVolume', 'quoteVolume'],
+        ] as const;
+        for (const [nested, outer] of pairs)
+          if (!new Decimal(ticker.data.info[nested]).eq(ticker.data[outer]))
+            conflicts.push(
+              `info.${nested} and data.${outer} differ. Both raw values are retained; no canonical value is inferred.`,
+            );
+      }
+      return {
+        symbol,
+        baseAsset: market.baseAsset,
+        quoteAsset: market.quoteAsset,
+        ticker,
+        aggregates,
+        conflicts,
+        pollSeconds: 15,
+      };
+    });
+  }
+  async futuresHealth(): Promise<PublicRead<{ message: 'OK' }>> {
+    return this.publicReads.read('futures.health', () =>
+      this.publicObservation(() => this.client.futuresHealth()),
+    );
+  }
+  async futuresDepth(symbol: string) {
+    const metadata = await this.futuresMetadata();
+    if (!metadata.data.symbols.some((m) => m.symbol === symbol))
+      throw new AppError(
+        'UNSUPPORTED_MARKET',
+        'This exact symbol was not returned by ZebPay Futures.',
+        422,
+      );
+    return this.publicReads.read(`futures.depth:${symbol}`, async () => {
+      const result = await this.client.futuresBook(symbol);
+      if (result.data.symbol !== symbol)
+        throw new AppError(
+          'SYMBOL_MISMATCH',
+          'The order-book response did not match the requested symbol.',
+          502,
+        );
+      return result.data;
+    });
+  }
+  async futuresRules() {
+    return (await this.client.futuresExchangeInfo()).data.pairs;
+  }
+  cachedSpot(): Market[] | null {
+    const c = this.cache.get('spot');
+    return c && c.until + CACHE_MS > this.now() ? c.markets : null;
+  }
+}
diff --git a/server/paper.ts b/server/paper.ts
new file mode 100644
index 0000000..541656d
--- /dev/null
+++ b/server/paper.ts
@@ -0,0 +1,294 @@
+import { createHash, randomUUID } from 'node:crypto';
+import Decimal from 'decimal.js';
+import { z } from 'zod';
+import type { Market, PaperWallet, PaperView, PaperTrade } from '../shared/types.js';
+import { Store, newPaperWallet } from './store.js';
+import { MarketService } from './markets.js';
+import { AppError } from './errors.js';
+import { spotPair, quantity, parse } from './validation.js';
+
+Decimal.set({ precision: 40 });
+export const paperOrderSchema = z
+  .object({
+    mode: z.literal('paper'),
+    venue: z.literal('spot'),
+    pair: spotPair,
+    side: z.enum(['buy', 'sell']),
+    quantity,
+    requestId: z.uuid(),
+    decisionId: z.uuid().nullable().optional(),
+  })
+  .strict();
+export type PaperOrderInput = z.infer<typeof paperOrderSchema>;
+
+export function valuation(
+  wallet: PaperWallet,
+  markets: Market[] | null,
+  now: number,
+): { equity: Decimal; unrealized: Decimal; observedAt: number } | null {
+  let equity = new Decimal(wallet.cash);
+  let unrealized = new Decimal(0);
+  let observedAt = now;
+  for (const [pair, position] of Object.entries(wallet.positions)) {
+    if (new Decimal(position.quantity).isZero()) continue;
+    const market = markets?.find((m) => m.pair === pair && m.venue === 'spot' && m.quote === 'INR');
+    if (!market?.price || now - market.observedAt > 30000 || market.observedAt > now) return null;
+    const value = new Decimal(position.quantity).mul(market.price);
+    equity = equity.add(value);
+    unrealized = unrealized.add(value.sub(position.cost));
+    observedAt = Math.min(observedAt, market.observedAt);
+  }
+  return { equity, unrealized, observedAt };
+}
+export class PaperEngine {
+  constructor(
+    private store: Store,
+    private markets: MarketService,
+    private now: () => number = Date.now,
+  ) {}
+  view(): PaperView {
+    const wallet = this.store.wallet();
+    const now = this.now();
+    const value = valuation(wallet, this.markets.cachedSpot(), now);
+    const currentDay = new Date(now).toISOString().slice(0, 10);
+    return {
+      wallet,
+      equity: value?.equity.toString() ?? null,
+      unrealizedPnl: value?.unrealized.toString() ?? null,
+      dailyPnl:
+        value && currentDay === wallet.day
+          ? value.equity.sub(wallet.dayOpeningEquity).toString()
+          : null,
+      valuationAt: value?.observedAt ?? null,
+      valuationReason: value
+        ? null
+        : 'Fresh prices for every simulated holding are required to value this paper wallet. No stale P&L is reported.',
+      trades: this.store.trades(wallet.portfolioId),
+    };
+  }
+  async execute(raw: unknown): Promise<{ trade: PaperTrade; replayed: boolean }> {
+    const input = parse(paperOrderSchema, raw);
+    try {
+      if (!this.store.verifyAudit())
+        throw new AppError(
+          'AUDIT_INTEGRITY',
+          'Audit integrity check failed. Paper execution is locked; restore a trusted backup.',
+          503,
+        );
+      if (this.store.risk().killSwitch)
+        throw new AppError(
+          'KILL_SWITCH_ACTIVE',
+          'The emergency stop is active. No paper or live execution is allowed.',
+          409,
+        );
+      const existing = this.store.findRequest(input.requestId);
+      const priorWallet = this.store.wallet();
+      const q = new Decimal(input.quantity);
+      const fingerprint = createHash('sha256')
+        .update(JSON.stringify([priorWallet.portfolioId, input.pair, input.side, q.toString()]))
+        .digest('hex');
+      if (existing) {
+        if (
+          existing.fingerprint !== fingerprint ||
+          existing.trade.decisionId !== (input.decisionId ?? null)
+        )
+          throw new AppError(
+            'IDEMPOTENCY_CONFLICT',
+            'This request ID belongs to a different order. Do not change an order while reusing its request ID.',
+            409,
+          );
+        return { trade: existing.trade, replayed: true };
+      }
+      const markets = await this.markets.paperMarkets(); // Public GET only; the engine has no private adapter.
+      return this.store.transaction(() => {
+        const wallet = this.store.wallet();
+        const risk = this.store.risk();
+        const now = this.now();
+        if (!this.store.verifyAudit())
+          throw new AppError(
+            'AUDIT_INTEGRITY',
+            'Audit integrity check failed during validation. Paper execution is locked.',
+            503,
+          );
+        if (wallet.portfolioId !== priorWallet.portfolioId)
+          throw new AppError(
+            'WALLET_CHANGED',
+            'The paper wallet changed during validation. Review it before submitting a new simulation.',
+            409,
+          );
+        if (risk.killSwitch)
+          throw new AppError('KILL_SWITCH_ACTIVE', 'The emergency stop is active.', 409);
+        const duplicate = this.store.findRequest(input.requestId);
+        if (duplicate) {
+          if (
+            duplicate.fingerprint !== fingerprint ||
+            duplicate.trade.decisionId !== (input.decisionId ?? null)
+          )
+            throw new AppError(
+              'IDEMPOTENCY_CONFLICT',
+              'This request ID already belongs to another order.',
+              409,
+            );
+          return { trade: duplicate.trade, replayed: true };
+        }
+        if (this.store.recentFingerprint(fingerprint, now - 30000))
+          throw new AppError(
+            'DUPLICATE_ORDER',
+            'An identical paper order was filled within 30 seconds. Review the ledger before submitting again.',
+            409,
+          );
+        if (input.decisionId) {
+          const decision = this.store.decision(input.decisionId);
+          if (
+            !decision ||
+            decision.venue !== 'spot' ||
+            decision.pair !== input.pair ||
+            decision.signal !== input.side ||
+            now - decision.createdAt > 60 * 60 * 1000
+          )
+            throw new AppError(
+              'DECISION_MISMATCH',
+              'Only a matching, recent Spot decision can be linked to this manual paper order.',
+              409,
+            );
+        }
+        const market = markets.find(
+          (m) => m.pair === input.pair && m.venue === 'spot' && m.quote === 'INR',
+        );
+        if (!market?.price)
+          throw new AppError(
+            'UNSUPPORTED_MARKET',
+            'The exact INR market must be returned by ZebPay with a positive price. No substitute is allowed.',
+            422,
+          );
+        if (now - market.observedAt > 30000 || market.observedAt > now)
+          throw new AppError('STALE_MARKET_DATA', 'A fresh ZebPay observation is required.', 409);
+        const before = valuation(wallet, markets, now);
+        if (!before)
+          throw new AppError(
+            'VALUATION_UNAVAILABLE',
+            'Fresh prices for all simulated holdings are required before another order.',
+            409,
+          );
+        const day = new Date(now).toISOString().slice(0, 10);
+        if (wallet.day !== day) {
+          wallet.day = day;
+          wallet.dayOpeningEquity = before.equity.toString();
+        }
+        const dailyLoss = new Decimal(wallet.dayOpeningEquity).sub(before.equity);
+        if (dailyLoss.gte(risk.dailyLossInr))
+          throw new AppError(
+            'DAILY_LOSS_LIMIT',
+            'The simulated daily-loss limit has been reached. Execution is paused for this UTC day.',
+            409,
+          );
+        const reference = new Decimal(market.price);
+        const slippage = new Decimal(risk.slippageBps).div(10000);
+        const fillPrice = reference.mul(
+          input.side === 'buy' ? slippage.add(1) : new Decimal(1).sub(slippage),
+        );
+        const notional = q.mul(fillPrice);
+        if (notional.gt(risk.maximumOrderInr))
+          throw new AppError(
+            'MAXIMUM_ORDER',
+            'The simulated order exceeds your maximum INR order-size limit, including assumed slippage.',
+            409,
+          );
+        const fee = notional.mul(risk.feeBps).div(10000);
+        const position = wallet.positions[input.pair] ?? { quantity: '0', cost: '0' };
+        let realized = new Decimal(0);
+        if (input.side === 'buy') {
+          const debit = notional.add(fee);
+          if (debit.gt(wallet.cash))
+            throw new AppError(
+              'INSUFFICIENT_PAPER_FUNDS',
+              'Your virtual INR balance is insufficient, including the assumed fee.',
+              409,
+            );
+          wallet.cash = new Decimal(wallet.cash).sub(debit).toString();
+          wallet.positions[input.pair] = {
+            quantity: new Decimal(position.quantity).add(q).toString(),
+            cost: new Decimal(position.cost).add(debit).toString(),
+          };
+        } else {
+          if (q.gt(position.quantity))
+            throw new AppError(
+              'INSUFFICIENT_PAPER_ASSET',
+              'You cannot sell more than your simulated holding. Paper trading is long-only and does not allow shorting.',
+              409,
+            );
+          const removedCost = new Decimal(position.cost).mul(q).div(position.quantity);
+          realized = notional.sub(fee).sub(removedCost);
+          wallet.cash = new Decimal(wallet.cash).add(notional).sub(fee).toString();
+          const remaining = new Decimal(position.quantity).sub(q);
+          if (remaining.isZero()) delete wallet.positions[input.pair];
+          else
+            wallet.positions[input.pair] = {
+              quantity: remaining.toString(),
+              cost: new Decimal(position.cost).sub(removedCost).toString(),
+            };
+          wallet.realizedPnl = new Decimal(wallet.realizedPnl).add(realized).toString();
+        }
+        const after = valuation(wallet, markets, now)!;
+        if (new Decimal(wallet.dayOpeningEquity).sub(after.equity).gte(risk.dailyLossInr))
+          throw new AppError(
+            'PROJECTED_DAILY_LOSS',
+            'Assumed fees and slippage would cross the paper daily-loss limit. The simulation was not executed.',
+            409,
+          );
+        const trade: PaperTrade = {
+          id: randomUUID(),
+          portfolioId: wallet.portfolioId,
+          requestId: input.requestId,
+          pair: input.pair,
+          side: input.side,
+          quantity: q.toString(),
+          referencePrice: reference.toString(),
+          fillPrice: fillPrice.toString(),
+          fee: fee.toString(),
+          notional: notional.toString(),
+          realizedPnl: realized.toString(),
+          createdAt: now,
+          decisionId: input.decisionId ?? null,
+          status: 'simulated_fill',
+        };
+        this.store.set('paper', wallet);
+        this.store.addTrade(trade, fingerprint);
+        this.store.observe('spot', input.pair, market.observedAt, market.price);
+        this.store.audit(
+          'paper_order_filled',
+          {
+            pair: input.pair,
+            side: input.side,
+            requestId: input.requestId,
+            tradeId: trade.id,
+            decisionId: trade.decisionId,
+          },
+          now,
+        );
+        return { trade, replayed: false };
+      });
+    } catch (error) {
+      if (error instanceof AppError && error.code !== 'AUDIT_INTEGRITY')
+        this.store.audit('paper_order_rejected', {
+          reasonCode: error.code,
+          pair: input.pair,
+          requestId: input.requestId,
+        });
+      throw error;
+    }
+  }
+  reset(confirmation: string, startingCash: string): PaperView {
+    if (confirmation !== 'RESET PAPER WALLET')
+      throw new AppError(
+        'CONFIRMATION_REQUIRED',
+        'Type RESET PAPER WALLET to archive the existing simulated portfolio.',
+        409,
+      );
+    this.store.transaction(() => {
+      this.store.set('paper', newPaperWallet(this.now(), startingCash));
+      this.store.audit('paper_wallet_reset');
+    });
+    return this.view();
+  }
+}
