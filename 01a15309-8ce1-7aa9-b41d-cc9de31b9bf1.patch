+import { randomUUID } from 'node:crypto';
+import type { Decision, PaperTrade } from '../../shared/types';
+import { test, expect } from '@playwright/test';
+import { mockApi } from './mock-api';
+import { TEST_KEY, TEST_SECRET } from '../fixtures';
+
+test('real preview smoke: renders read-only without fabricated balances, browser errors, or overflow', async ({
+  page,
+}) => {
+  const errors: string[] = [];
+  page.on('pageerror', (e) => errors.push(e.message));
+  page.on('console', (m) => {
+    if (m.type() === 'error') errors.push(m.text());
+  });
+  await page.goto('/');
+  await expect(page.getByRole('heading', { name: 'Trade with a clearer edge.' })).toBeVisible();
+  await expect(page.getByText('Response schema not supplied', { exact: true })).toBeVisible();
+  await expect(page.getByRole('button', { name: 'Unlock paper trading' })).toBeVisible();
+  expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true);
+  expect(errors).toEqual([]);
+  for (const path of [
+    '/.env',
+    '/.runtime/master.key',
+    '/.runtime/owner.json',
+    '/server/config.ts',
+    '/scripts/setup.mjs',
+    '/tests/fixtures.ts',
+    '/docs/collection-audit.json',
+    '/example.postman_collection(1).json',
+  ]) {
+    const response = await page.request.get(path);
+    expect(response.status()).toBe(404);
+    expect(await response.text()).toBe('Not found');
+  }
+});
+
+test.describe('Explicit test-only browser network fixtures', () => {
+  test('masked write-only credentials clear after verification; no secret in DOM or browser storage', async ({
+    page,
+  }) => {
+    const state = await mockApi(page);
+    await page.goto('/#connection');
+    const keyInput = page.getByLabel('ZebPay API key');
+    const secret = page.getByLabel('ZebPay API secret');
+    await expect(keyInput).toHaveAttribute('type', 'password');
+    await expect(secret).toHaveAttribute('type', 'password');
+    await keyInput.fill(TEST_KEY);
+    await secret.fill(TEST_SECRET);
+    await page.getByLabel('IP-whitelist status', { exact: true }).selectOption('confirmed');
+    await page.getByRole('button', { name: 'Connect & verify', exact: true }).click();
+    await expect(page.getByText('Read access verified', { exact: true })).toBeVisible();
+    await expect(keyInput).toHaveValue('');
+    await expect(secret).toHaveValue('');
+    expect(await page.locator('body').innerText()).not.toContain(TEST_SECRET);
+    expect(await page.evaluate(() => [localStorage.length, sessionStorage.length])).toEqual([0, 0]);
