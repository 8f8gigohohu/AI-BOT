+import { useEffect, useState, type FormEvent } from 'react';
+import {
+  AlertTriangle,
+  ArrowRight,
+  CircleStop,
+  FileLock2,
+  LockKeyhole,
+  RotateCcw,
+  Save,
+  ShieldCheck,
+  ShieldX,
+  SlidersHorizontal,
+} from 'lucide-react';
+import type { CommonProps } from '../context';
+import { LIVE_BLOCKERS } from '../../shared/capabilities';
+import { api, formatMoney } from '../api';
+import {
+  Badge,
+  Button,
+  Field,
+  Modal,
+  Notice,
+  PageHeading,
+  Panel,
+  TextLink,
+} from '../components/ui';
+
+export function RiskPage({
+  workspace,
+  session,
+  requireOwner,
+  refreshWorkspace,
+  notify,
+  openLive,
+  navigate,
+  openKill,
+}: CommonProps & { openKill: () => void }) {
+  const [maxOrder, setMaxOrder] = useState('5000'),
+    [dailyLoss, setDailyLoss] = useState('1000'),
+    [fee, setFee] = useState('10'),
+    [slippage, setSlippage] = useState('5');
+  const [busy, setBusy] = useState(false);
+  const [resetText, setResetText] = useState('');
+  const [showReset, setShowReset] = useState(false);
+  const [walletPhrase, setWalletPhrase] = useState('');
+  const [startingCash, setStartingCash] = useState('100000');
+  const risk = workspace?.risk;
+  useEffect(() => {
+    if (risk) {
+      setMaxOrder(risk.maximumOrderInr);
+      setDailyLoss(risk.dailyLossInr);
+      setFee(String(risk.feeBps));
+      setSlippage(String(risk.slippageBps));
+    }
+  }, [risk?.maximumOrderInr, risk?.dailyLossInr, risk?.feeBps, risk?.slippageBps]);
+  async function save(e: FormEvent) {
+    e.preventDefault();
+    if (!requireOwner()) return;
+    setBusy(true);
+    try {
+      await api('/api/risk', 'POST', {
+        maximumOrderInr: maxOrder,
+        dailyLossInr: dailyLoss,
+        feeBps: Number(fee),
+        slippageBps: Number(slippage),
+      });
+      await refreshWorkspace();
+      notify('Paper risk limits and cost assumptions saved on the server.', 'success');
+    } catch (e) {
+      notify((e as Error).message, 'error');
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function resetKill(e: FormEvent) {
+    e.preventDefault();
+    if (!requireOwner()) return;
+    setBusy(true);
+    try {
+      await api('/api/kill-switch', 'POST', { enabled: false, confirmation: resetText });
+      setResetText('');
+      await refreshWorkspace();
+      notify(
+        'Emergency stop reset. Paper execution can resume; live trading is still disabled.',
+        'success',
+      );
+    } catch (e) {
+      notify((e as Error).message, 'error');
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function resetWallet() {
+    setBusy(true);
+    try {
+      await api('/api/paper/reset', 'POST', { confirmation: walletPhrase, startingCash });
+      await refreshWorkspace();
+      setShowReset(false);
+      setWalletPhrase('');
+      notify(
+        'A new virtual portfolio was initialized. The previous ledger and audit history remain archived on the backend.',
+        'success',
+      );
+    } catch (e) {
+      notify((e as Error).message, 'error');
+    } finally {
+      setBusy(false);
+    }
+  }
+  return (
+    <>
+      <PageHeading
+        eyebrow="RISK & SAFETY"
+        title="Discipline is your edge"
+        description="Server-enforced guardrails. Explicit consent. No shortcuts around missing evidence."
+        actions={
+          <Badge tone="green">
+            <ShieldCheck size={13} />
+            Fail-closed execution
+          </Badge>
+        }
+      />
+      <div className="risk-mode-banner">
+        <div className="mode-symbol">
+          <ShieldCheck size={25} />
+        </div>
+        <div>
+          <span className="eyebrow">CURRENT EXECUTION MODE</span>
+          <h2>
+            Paper trading
+            <span className="tiny-dot green" />
+          </h2>
+          <p>Virtual funds only. Exchange order submission is structurally disabled.</p>
+        </div>
+        <Button variant="secondary" onClick={openLive}>
+          <LockKeyhole size={14} />
+          Review live readiness
+        </Button>
+      </div>
+      <div className="two-columns risk-columns">
+        <Panel
+          title="Paper risk limits"
+          description="Enforced again on every simulation — not just in this interface."
+          actions={<SlidersHorizontal size={18} className="muted" />}
+        >
+          <form className="form-panel-content" onSubmit={save}>
+            {!session?.authenticated && (
+              <Notice>
+                These are default application limits, not values read from your account. Unlock to
+                view and change your saved settings.
+              </Notice>
+            )}
+            <div className="form-two">
+              <Field
+                label="Maximum order size (virtual INR)"
+                hint="Simulated notional including assumed slippage. Fees are additional."
+              >
+                <div className="prefix-input">
+                  <span>₹</span>
+                  <input
+                    aria-label="Maximum order size"
+                    inputMode="decimal"
+                    value={maxOrder}
+                    disabled={!session?.authenticated || busy}
+                    onChange={(e) => setMaxOrder(e.target.value)}
+                    required
+                  />
+                </div>
+              </Field>
+              <Field
+                label="Daily-loss limit (virtual INR)"
+                hint="Measured against the first fresh valuation of each UTC day."
+              >
+                <div className="prefix-input">
+                  <span>₹</span>
+                  <input
+                    aria-label="Daily loss limit"
+                    inputMode="decimal"
+                    value={dailyLoss}
+                    disabled={!session?.authenticated || busy}
+                    onChange={(e) => setDailyLoss(e.target.value)}
+                    required
+                  />
+                </div>
+              </Field>
+            </div>
+            <div className="risk-limit-indicator">
+              <div>
+                <span>Current simulated daily P&L</span>
+                <strong className="mono">{formatMoney(workspace?.paper.dailyPnl)}</strong>
+              </div>
+              <p>
+                Includes unrealized changes when every paper holding has a fresh price. Missing
+                valuations block new simulations.
+              </p>
+            </div>
+            <div className="form-divider">
+              <span>SIMULATION ASSUMPTIONS</span>
+              <Badge tone="amber">Not exchange fees</Badge>
+            </div>
+            <div className="form-two">
+              <Field
+                label="Assumed trading fee (bps)"
+                hint="10 basis points = 0.10%. This is a configurable simulation input."
+              >
+                <input
+                  type="number"
+                  min="0"
+                  max="500"
+                  step="1"
+                  aria-label="Assumed fee in basis points"
+                  value={fee}
+                  disabled={!session?.authenticated || busy}
+                  onChange={(e) => setFee(e.target.value)}
+                  required
+                />
+              </Field>
+              <Field
+                label="Assumed slippage (bps)"
+                hint="Applied adversely to buys and sells. Not an execution guarantee."
+              >
+                <input
+                  type="number"
+                  min="0"
+                  max="500"
+                  step="1"
+                  aria-label="Assumed slippage in basis points"
+                  value={slippage}
+                  disabled={!session?.authenticated || busy}
+                  onChange={(e) => setSlippage(e.target.value)}
+                  required
+                />
+              </Field>
+            </div>
+            <div className="form-actions">
+              <Button busy={busy} type="submit" disabled={!session?.authenticated}>
+                <Save size={14} />
+                Save paper limits
+              </Button>
+            </div>
+          </form>
+        </Panel>
+        <div className="risk-right">
+          <Panel
+            title="Emergency stop"
+            actions={
+              <Badge tone={risk?.killSwitch ? 'red' : 'green'} dot>
+                {risk?.killSwitch ? 'ACTIVE' : 'Standby'}
+              </Badge>
+            }
+            className={`emergency-panel ${risk?.killSwitch ? 'emergency-active' : ''}`}
+          >
+            <div className="form-panel-content">
+              <div className="emergency-icon">
+                <CircleStop size={27} />
+              </div>
+              <h3>Stop first. Review second.</h3>
+              <p>
+                The emergency stop blocks new paper executions, aborts active authenticated reads,
+                and persists across restarts. It cannot cancel existing ZebPay orders.
+              </p>
+              {risk?.killSwitch ? (
+                <form onSubmit={resetKill}>
+                  <Field label="Type RESET KILL SWITCH to resume paper execution">
+                    <input
+                      aria-label="Reset kill switch confirmation"
+                      value={resetText}
+                      onChange={(e) => setResetText(e.target.value)}
+                      autoComplete="off"
+                    />
+                  </Field>
+                  <Button
+                    variant="secondary"
+                    type="submit"
+                    busy={busy}
+                    disabled={resetText !== 'RESET KILL SWITCH'}
+                  >
+                    Reset stop · keep live disabled
+                  </Button>
+                </form>
+              ) : (
+                <Button
+                  variant="danger"
+                  onClick={() => {
+                    if (requireOwner()) openKill();
+                  }}
+                >
+                  <CircleStop size={15} />
+                  Activate emergency stop
+                </Button>
+              )}
+            </div>
+          </Panel>
+          <div className="safety-mini">
+            <FileLock2 size={21} />
+            <div>
+              <strong>Every meaningful action leaves a trail.</strong>
+              <p>
+                Connection attempts, rejected simulations, risk changes, and decisions are recorded
+                without credentials.
+              </p>
+              <TextLink onClick={() => navigate('orders')}>Open execution journal</TextLink>
+            </div>
+          </div>
+        </div>
+      </div>
+      <Panel
+        title="Why live trading is locked"
+        description="An explicit opt-in is necessary, but it is not enough when the collection cannot support the safety checks."
+        actions={
+          <Badge tone="amber">
+            <LockKeyhole size={12} />
+            Collection blockers
+          </Badge>
+        }
+        className="live-blockers-panel"
+      >
+        <div className="blocker-list">
+          {LIVE_BLOCKERS.map((reason, i) => (
+            <div className="blocker" key={reason}>
+              <span className="blocker-index mono">0{i + 1}</span>
+              <p>{reason}</p>
+              <LockKeyhole size={14} />
+            </div>
+          ))}
+        </div>
+        <div className="panel-bottom-action">
+          <TextLink onClick={() => navigate('audit')}>Inspect the supporting API audit</TextLink>
+          <span>No environment flag can override these missing contracts.</span>
+        </div>
+      </Panel>
+      <div className="reset-wallet-panel">
+        <div>
+          <h3>Start a new paper portfolio</h3>
+          <p>
+            Virtual funds only. Archives the previous paper portfolio; does not touch exchange funds
+            or erase audit history.
+          </p>
+        </div>
+        <Button
+          variant="secondary"
+          onClick={() => {
+            if (requireOwner()) setShowReset(true);
+          }}
+        >
+          <RotateCcw size={14} />
+          Reset virtual wallet
+        </Button>
+      </div>
+      {showReset && (
+        <Modal
+          title="Start a new paper portfolio?"
+          subtitle="This changes only simulated accounting. The previous paper ledger stays archived in the backend database."
+          onClose={() => {
+            if (!busy) setShowReset(false);
+          }}
+        >
+          <Field label="New virtual INR allocation">
+            <input
+              inputMode="decimal"
+              value={startingCash}
+              onChange={(e) => setStartingCash(e.target.value)}
+              aria-label="Starting virtual cash"
+            />
+          </Field>
+          <Field label="Type RESET PAPER WALLET to confirm">
+            <input
+              autoComplete="off"
+              value={walletPhrase}
+              onChange={(e) => setWalletPhrase(e.target.value)}
+              aria-label="Reset paper wallet confirmation"
+            />
+          </Field>
+          <Notice tone="amber">
+            This does not reset the emergency stop, remove account credentials, or enable live
+            trading.
+          </Notice>
+          <div className="modal-actions">
+            <Button variant="secondary" onClick={() => setShowReset(false)} disabled={busy}>
+              Go back
+            </Button>
+            <Button
+              busy={busy}
+              disabled={walletPhrase !== 'RESET PAPER WALLET'}
+              onClick={resetWallet}
+            >
+              Initialize virtual funds
+            </Button>
+          </div>
+        </Modal>
+      )}
+    </>
+  );
+}
