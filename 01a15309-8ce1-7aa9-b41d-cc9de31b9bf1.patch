+    t.close();
+    const restarted = makeTestApp({ config: t.config });
+    const again = await owner(restarted.app);
+    expect((await again.post('/api/orders', order)).body.replayed).toBe(true);
+    expect(restarted.store.wallet().cash).toBe(balance);
