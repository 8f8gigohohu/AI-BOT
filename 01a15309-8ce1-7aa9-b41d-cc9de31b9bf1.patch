+import { afterEach, describe, expect, it, vi } from 'vitest';
+import request from 'supertest';
+import { cleanup, makeTestApp, mockTransport } from './helpers';
+import { futureAggregateData, futureTickerData, TEST_KEY, TEST_SECRET } from './fixtures';
+import { PublicReadCache } from '../server/public-cache';
+import { ZebpayClient } from '../server/zebpay';
+
+afterEach(cleanup);
+const snapshot = '/api/futures/snapshot?symbol=BTCUSDT';
+describe('Source-pinned Futures public snapshots, not account fills', () => {
+  it('uses actual ticker24Hr/aggTrade symbol queries and exact public headers without auth', async () => {
+    const t = makeTestApp({ configured: false });
+    const response = await request(t.app).get(snapshot);
+    expect(response.status).toBe(200);
+    expect(response.body).toMatchObject({
+      symbol: 'BTCUSDT',
+      baseAsset: 'BTC',
+      quoteAsset: 'USDT',
+      pollSeconds: 15,
+      ticker: { status: 'available', receivedAt: t.now() },
+      aggregates: { status: 'available', data: { returnedCount: 2, truncated: false } },
+    });
+    expect(
+      response.body.aggregates.data.trades.map(
+        (row: { aggregateTradeId: number }) => row.aggregateTradeId,
+      ),
+    ).toEqual([2, 1]);
+    const ticker = t.fetcher.mock.calls.find(([url]) => url.includes('/ticker24Hr'))!;
+    const aggregates = t.fetcher.mock.calls.find(([url]) => url.includes('/aggTrade'))!;
+    expect(ticker[0]).toBe('https://futuresbe.zebpay.com/api/v1/market/ticker24Hr?symbol=BTCUSDT');
+    expect(ticker[1].headers).toEqual({ accept: 'application/json' });
+    expect(aggregates[0]).toBe(
+      'https://futuresbe.zebpay.com/api/v1/market/aggTrade?symbol=BTCUSDT',
+    );
+    expect(aggregates[1].headers).toEqual({ 'Content-Type': 'application/json' });
+    for (const [, init] of t.fetcher.mock.calls) {
+      expect(init.method).toBe('GET');
+      expect(init.redirect).toBe('error');
+      expect(init.headers).not.toHaveProperty('X-AUTH-APIKEY');
+      expect(init.headers).not.toHaveProperty('X-AUTH-SIGNATURE');
+      expect(init.headers).not.toHaveProperty('Authorization');
+    }
+    expect(t.store.history('futures', 'BTCUSDT')).toEqual([]); // snapshots cannot seed signals/candles
+    expect(t.connection.status().status).toBe('disconnected');
+    expect(t.live.enabled).toBe(false);
+  });
+  it('does not attach saved Spot credentials to any new Futures public read', async () => {
+    const t = makeTestApp();
+    await t.connection.connect(TEST_KEY, TEST_SECRET, 'confirmed');
+    const before = t.fetcher.mock.calls.length;
+    await request(t.app).get(snapshot);
+    await request(t.app).get('/api/futures/health');
+    for (const [url, init] of t.fetcher.mock.calls.slice(before)) {
+      expect(new URL(url).hostname).toBe('futuresbe.zebpay.com');
+      expect(init.headers).not.toHaveProperty('X-AUTH-APIKEY');
+      expect(init.headers).not.toHaveProperty('X-AUTH-SIGNATURE');
+    }
+    expect(t.connection.status().status).toBe('connected');
+  });
+  it('keeps disagreeing percentage fields separate and never overwrites the market price/history', async () => {
+    const base = mockTransport();
+    const t = makeTestApp({
+      fetcher: async (url, init) => {
+        if (url.includes('/ticker24Hr')) {
+          const data = futureTickerData();
+          data.data.percentage = 27;
+          return Response.json(data);
+        }
+        return base.fetcher(url, init);
+      },
+    });
+    const response = await request(t.app).get(snapshot);
+    expect(response.body.ticker.data.info.priceChangePercentage).toBe('1.5');
+    expect(response.body.ticker.data.percentage).toBe(27);
+    expect(response.body.conflicts).toHaveLength(1);
+    expect(response.body.conflicts[0]).toContain(
+      'info.priceChangePercentage and data.percentage differ',
+    );
+    expect(t.store.history('futures', 'BTCUSDT')).toEqual([]);
+    expect((await t.markets.view('futures', 'BTCUSDT', 'all')).selected!.price).toBe('10');
+    expect(t.store.history('futures', 'BTCUSDT')[0].price).toBe('10');
+  });
+  it.each(['outer', 'inner'])(
+    'rejects the wrong %s ticker symbol without substituting INR/USDT',
+    async (location) => {
+      const base = mockTransport();
+      const t = makeTestApp({
+        fetcher: async (url, init) => {
+          if (url.includes('/ticker24Hr')) {
+            const data = futureTickerData();
+            if (location === 'outer') data.data.symbol = 'BTCINR';
+            else data.data.info.symbol = 'BTCINR';
+            return Response.json(data);
+          }
+          return base.fetcher(url, init);
+        },
+      });
+      const response = await request(t.app).get(snapshot);
+      expect(response.body.ticker.status).toBe('unavailable');
+      expect(response.body.ticker.data).toBeNull();
+      expect(response.body.aggregates.status).toBe('available');
+      expect(response.body.conflicts).toEqual([]);
+    },
+  );
+  it('rejects a mixed-symbol aggregate response rather than filtering in a substitute market', async () => {
+    const base = mockTransport();
+    const t = makeTestApp({
+      fetcher: async (url, init) => {
+        if (url.includes('/aggTrade')) {
+          const data = futureAggregateData();
+          data.data[0].symbol = 'BTCINR';
+          return Response.json(data);
+        }
+        return base.fetcher(url, init);
+      },
+    });
+    const response = await request(t.app).get(snapshot);
+    expect(response.body.ticker.status).toBe('available');
+    expect(response.body.aggregates).toMatchObject({ status: 'unavailable', data: null });
+  });
+  it('requires the saved nested ticker shape instead of accepting contradictory flat prose', async () => {
+    const body = futureTickerData();
+    const client = new ZebpayClient(async () => Response.json({ ...body, data: body.data.info }));
+    await expect(client.futuresTicker24h('BTCUSDT')).rejects.toMatchObject({
+      code: 'UNDOCUMENTED_RESPONSE',
+    });
+  });
+  it.each(['not-a-price', '-1', '0x20', 'Infinity'])(
+    'rejects invalid/nondecimal price %s with a curated partial response',
+    async (value) => {
+      const base = mockTransport();
+      const t = makeTestApp({
+        fetcher: async (url, init) => {
+          if (url.includes('/ticker24Hr')) {
+            const data = futureTickerData();
+            data.data.info.lastPrice = value;
+            return Response.json(data);
+          }
+          return base.fetcher(url, init);
+        },
+      });
+      const response = await request(t.app).get(snapshot);
+      expect(response.status).toBe(200);
+      expect(response.body.ticker.status).toBe('unavailable');
+      expect(response.body.aggregates.status).toBe('available');
+      expect(response.body.ticker.reason).toContain('does not match');
+    },
+  );
+  it('strips undocumented fields instead of returning arbitrary upstream JSON', async () => {
+    const base = mockTransport();
+    const t = makeTestApp({
+      fetcher: async (url, init) => {
+        if (url.includes('/ticker24Hr')) {
+          const data = futureTickerData();
+          return Response.json({
+            ...data,
+            data: {
+              ...data.data,
+              apiSecret: TEST_SECRET,
+              info: { ...data.data.info, apiKey: TEST_KEY },
+            },
+          });
+        }
+        return base.fetcher(url, init);
+      },
+    });
+    const response = await request(t.app).get(snapshot);
+    expect(response.body.ticker.status).toBe('available');
+    expect(response.text).not.toContain(TEST_SECRET);
+    expect(response.text).not.toContain(TEST_KEY);
+  });
+  it('isolates an upstream ticker error from valid aggregates and never reflects its body', async () => {
+    const base = mockTransport();
+    const t = makeTestApp({
+      fetcher: async (url, init) =>
+        url.includes('/ticker24Hr')
+          ? new Response(TEST_SECRET, { status: 503 })
+          : base.fetcher(url, init),
+    });
+    const response = await request(t.app).get(snapshot);
+    expect(response.body.ticker).toMatchObject({
+      status: 'unavailable',
+      data: null,
+      receivedAt: null,
+    });
+    expect(response.body.aggregates.status).toBe('available');
+    expect(response.text).not.toContain(TEST_SECRET);
+  });
+  it('can read snapshots without marketInfo prices when metadata is available', async () => {
+    const base = mockTransport();
+    const t = makeTestApp({
+      fetcher: async (url, init) =>
+        url.endsWith('/marketInfo') ? new Response('', { status: 503 }) : base.fetcher(url, init),
+    });
+    expect((await request(t.app).get(snapshot)).body.ticker.status).toBe('available');
+    expect(base.fetcher.mock.calls.some(([url]) => url.includes('/marketInfo'))).toBe(false);
+  });
+  it('can read depth independently of price availability and coalesces repeated snapshots', async () => {
+    const base = mockTransport();
+    const t = makeTestApp({
+      fetcher: async (url, init) =>
+        url.endsWith('/marketInfo') ? new Response('', { status: 503 }) : base.fetcher(url, init),
+    });
+    const [a, b] = await Promise.all([
+      request(t.app).get('/api/futures/depth?symbol=BTCUSDT'),
+      request(t.app).get('/api/futures/depth?symbol=BTCUSDT'),
+    ]);
+    expect(a.body.data.symbol).toBe('BTCUSDT');
+    expect(b.body.data.symbol).toBe('BTCUSDT');
+    expect(base.fetcher).toHaveBeenCalledTimes(2);
+    expect(base.fetcher.mock.calls.some(([url]) => url.includes('/marketInfo'))).toBe(false);
+  });
+  it('accepts only symbols returned by metadata and sends no invented query parameters', async () => {
+    const t = makeTestApp();
+    expect((await request(t.app).get('/api/futures/snapshot?symbol=UNKNOWN')).status).toBe(422);
+    expect(t.fetcher.mock.calls).toHaveLength(1);
+    expect(t.fetcher.mock.calls[0][0]).toContain('/market/markets');
+    for (const path of [
+      '/api/futures/snapshot?symbol=https://attacker.invalid',
+      '/api/futures/snapshot?symbol=BTCUSDT&limit=50',
+      '/api/futures/health?url=https://attacker.invalid',
+    ])
+      expect((await request(t.app).get(path)).status).toBe(400);
+    expect(t.fetcher.mock.calls).toHaveLength(1);
+  });
+  it('coalesces public reads and refreshes after 15 seconds instead of treating stale snapshots as new', async () => {
+    const t = makeTestApp();
+    await Promise.all(Array.from({ length: 8 }, () => request(t.app).get(snapshot)));
+    expect(t.fetcher).toHaveBeenCalledTimes(3);
+    t.advance(15001);
+    const fresh = await request(t.app).get(snapshot);
+    expect(fresh.body.ticker.receivedAt).toBe(t.now());
+    expect(t.fetcher).toHaveBeenCalledTimes(6);
+  });
+  it('bounds displayed aggregates but retains true returned count; no remote limit/backfill is invented', async () => {
+    const base = mockTransport();
+    const t = makeTestApp({
+      fetcher: async (url, init) => {
+        if (url.includes('/aggTrade')) {
+          const data = futureAggregateData();
+          data.data = Array.from({ length: 205 }, (_, i) => ({
+            ...data.data[0],
+            aggregateTradeId: i + 1,
+            tradeTime: 1792404000000 + i,
+          }));
+          return Response.json(data);
+        }
+        return base.fetcher(url, init);
+      },
+    });
+    const response = await request(t.app).get(snapshot);
+    expect(response.body.aggregates.data.trades).toHaveLength(200);
+    expect(response.body.aggregates.data.returnedCount).toBe(205);
+    expect(response.body.aggregates.data.truncated).toBe(true);
+    expect(response.body.aggregates.data.trades[0].aggregateTradeId).toBe(205);
+  });
+  it('reads public service health independently, never treating it as account verification', async () => {
+    const t = makeTestApp({ configured: false });
+    const health = await request(t.app).get('/api/futures/health');
+    expect(health.body).toEqual({
+      status: 'available',
+      data: { message: 'OK' },
+      receivedAt: t.now(),
+      reason: null,
+    });
+    expect(t.fetcher.mock.calls).toHaveLength(1);
+    expect(t.fetcher.mock.calls[0][0]).toBe('https://futuresbe.zebpay.com/healthCheckStatus');
+    expect(t.fetcher.mock.calls[0][1].headers).toEqual({ 'Content-Type': 'application/json' });
+    expect(t.connection.status().status).toBe('disconnected');
+    expect(t.live.enabled).toBe(false);
+    await request(t.app).get('/api/futures/health');
+    expect(t.fetcher).toHaveBeenCalledTimes(1);
+    t.advance(15001);
+    t.state.failure = Response.json({ message: TEST_SECRET });
+    const failed = await request(t.app).get('/api/futures/health');
+    expect(failed.body).toMatchObject({ status: 'unavailable', data: null, receivedAt: null });
+    expect(failed.text).not.toContain(TEST_SECRET);
+  });
+});
+describe('Bounded public cache, not a private retry mechanism', () => {
+  it('coalesces one in-flight read and applies a fixed TTL and eviction bound', async () => {
+    let now = 0;
+    const cache = new PublicReadCache(() => now, 15, 2);
+    const load = vi.fn(async () => 42);
+    expect(await Promise.all([cache.read('a', load), cache.read('a', load)])).toEqual([42, 42]);
+    expect(load).toHaveBeenCalledTimes(1);
+    await cache.read('b', load);
+    await cache.read('c', load);
+    await cache.read('a', load);
+    expect(load).toHaveBeenCalledTimes(4);
+    now = 16;
+    await cache.read('a', load);
+    expect(load).toHaveBeenCalledTimes(5);
+  });
+  it('does not automatically retry rejected reads and releases the pending slot', async () => {
+    const cache = new PublicReadCache(() => 0);
+    const load = vi.fn(async () => {
+      throw new Error('test-only-failure');
+    });
+    await expect(cache.read('a', load)).rejects.toThrow('test-only-failure');
+    expect(load).toHaveBeenCalledTimes(1);
+    await expect(cache.read('a', load)).rejects.toThrow('test-only-failure');
+    expect(load).toHaveBeenCalledTimes(2);
+  });
+  it('limits distinct in-flight public loads without making a second request', async () => {
+    let done!: (value: number) => void;
+    const cache = new PublicReadCache(() => 0, 15, 2, 1);
+    const first = cache.read(
+      'a',
+      () =>
+        new Promise<number>((resolve) => {
+          done = resolve;
+        }),
+    );
+    const other = vi.fn(async () => 2);
+    await expect(cache.read('b', other)).rejects.toMatchObject({ code: 'PUBLIC_READ_BUSY' });
+    expect(other).not.toHaveBeenCalled();
+    done(1);
+    expect(await first).toBe(1);
+    expect(await cache.read('b', other)).toBe(2);
+  });
+});
