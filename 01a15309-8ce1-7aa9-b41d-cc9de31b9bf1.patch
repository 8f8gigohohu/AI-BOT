new file mode 100644
index 0000000..1c72ec5
--- /dev/null
+++ b/server/public-cache.ts
@@ -0,0 +1,39 @@
+import { AppError } from './errors.js';
+
+// Public GET observations only: bounded in-memory cache and in-flight coalescing.
+// It never accepts a URL, credential, mutation, or retry callback.
+export class PublicReadCache {
+  private values = new Map<string, { until: number; value: unknown }>();
+  private inflight = new Map<string, Promise<unknown>>();
+  constructor(
+    private now: () => number,
+    private ttlMs = 15000,
+    private limit = 32,
+    private maxInflight = 4,
+  ) {}
+  async read<T>(key: string, load: () => Promise<T>): Promise<T> {
+    const cached = this.values.get(key);
+    if (cached && cached.until > this.now()) return cached.value as T;
+    const pending = this.inflight.get(key);
+    if (pending) return pending as Promise<T>;
+    if (this.inflight.size >= this.maxInflight)
+      throw new AppError(
+        'PUBLIC_READ_BUSY',
+        'Public snapshots are busy. Wait before refreshing; no automatic retry was made.',
+        429,
+      );
+    const task = load();
+    this.inflight.set(key, task);
+    try {
+      const value = await task;
+      for (const [old, entry] of this.values)
+        if (entry.until <= this.now()) this.values.delete(old);
+      if (!this.values.has(key) && this.values.size >= this.limit)
+        this.values.delete(this.values.keys().next().value!);
+      this.values.set(key, { until: this.now() + this.ttlMs, value });
+      return value;
+    } finally {
+      this.inflight.delete(key);
+    }
+  }
+}
diff --git a/server/research.ts b/server/research.ts
new file mode 100644
index 0000000..41e304f
--- /dev/null
+++ b/server/research.ts
@@ -0,0 +1,288 @@
+import { randomUUID } from 'node:crypto';
+import Decimal from 'decimal.js';
+import type {
+  Decision,
+  Observation,
+  Venue,
+  SignalSide,
+  BacktestResult,
+  RiskSettings,
+} from '../shared/types.js';
+import { Store } from './store.js';
+import { AppError } from './errors.js';
+
+const WARNINGS = [
+  'Deterministic SMA/RSI research rules, not a trained or self-learning AI. Signals are not investment advice.',
+  'Locally observed REST prices are not candles or guaranteed executable quotes; gaps and exchange latency may affect conclusions.',
+  'Signals never place orders. Fees, liquidity, taxes, slippage, and market reversals can overwhelm a trend.',
+];
+export function evaluate(
+  history: Observation[],
+  venue: Venue,
+  pair: string,
+  now: number,
+): Decision {
+  const base: Decision = {
+    id: randomUUID(),
+    venue,
+    pair,
+    signal: 'hold',
+    strength: 'insufficient',
+    risk: 'high',
+    reasons: [],
+    risks: [...WARNINGS],
+    observations: history.length,
+    fastSma: null,
+    slowSma: null,
+    rsi: null,
+    volatility: null,
+    createdAt: now,
+    lastObservationAt: history.at(-1)?.time ?? null,
+    engine: 'sma-rsi-v1',
+  };
+  if (history.length < 20)
+    return {
+      ...base,
+      reasons: [
+        `Need 20 genuine observations; ${history.length} available. HOLD means no evidence to act, not a bullish or bearish prediction.`,
+      ],
+    };
+  if (!history.at(-1) || now - history.at(-1)!.time > 60000 || history.at(-1)!.time > now)
+    return {
+      ...base,
+      reasons: [
+        'The latest stored observation is stale. Analysis is paused rather than inferring a current signal.',
+      ],
+    };
+  const recent = history.slice(-20);
+  if (
+    recent.some(
+      (o, i) => i > 0 && (o.time <= recent[i - 1].time || o.time - recent[i - 1].time > 120000),
+    )
+  )
+    return {
+      ...base,
+      reasons: [
+        'The latest window has an observation gap longer than two minutes or invalid chronology. Collect a continuous window before evaluating it.',
+      ],
+    };
+  const p = recent.map((o) => Number(o.price));
+  if (p.some((v) => !Number.isFinite(v) || v <= 0))
+    return {
+      ...base,
+      reasons: [
+        'Stored observations do not contain valid positive prices. No signal is generated.',
+      ],
+    };
+  const mean = (xs: number[]) => xs.reduce((a, b) => a + b, 0) / xs.length;
+  const fast = mean(p.slice(-5));
+  const slow = mean(p);
+  const diffs = p
+    .slice(-15)
+    .slice(1)
+    .map((v, i) => v - p.slice(-15)[i]);
+  const gain = mean(diffs.map((v) => Math.max(v, 0)));
+  const loss = mean(diffs.map((v) => Math.max(-v, 0)));
+  const rsi = loss === 0 ? (gain === 0 ? 50 : 100) : 100 - 100 / (1 + gain / loss);
+  const returns = p.slice(1).map((v, i) => v / p[i] - 1);
+  const avgReturn = mean(returns);
+  const volatility = Math.sqrt(mean(returns.map((v) => (v - avgReturn) ** 2)));
+  const spread = fast / slow - 1;
+  if (![fast, slow, rsi, volatility, spread].every(Number.isFinite))
+    return {
+      ...base,
+      reasons: [
+        'The recorded prices exceed the finite numerical range of this research model. No directional signal is generated.',
+      ],
+    };
+  let signal: SignalSide = 'hold';
+  const reasons = [];
+  if (volatility >= 0.03)
+    reasons.push(
+      'Observed return volatility exceeds the 3% per-observation safety threshold. HOLD overrides directional rules.',
+    );
+  else if (spread > 0.0015 && rsi < 70) {
+    signal = 'buy';
+    reasons.push(
+      'The 5-observation SMA is more than 0.15% above the 20-observation SMA, while RSI is below 70. The rule detects upward momentum without its overbought condition.',
+    );
+  } else if (spread < -0.0015 || rsi > 75) {
+    signal = 'sell';
+    reasons.push(
+      spread < -0.0015
+        ? 'The 5-observation SMA is more than 0.15% below the 20-observation SMA. The rule detects weakening momentum.'
+        : 'RSI exceeds 75. The rule flags extended upward momentum and potential reversal risk.',
+    );
+  } else
+    reasons.push(
+      'The moving-average spread and RSI do not meet a directional rule. HOLD avoids forcing a trade from weak evidence.',
+    );
+  if (signal === 'sell')
+    reasons.push(
+      'For Spot paper trading, SELL only reduces an existing simulated holding. It does not open a short position.',
+    );
+  if (venue === 'futures')
+    reasons.push(
+      'Futures analysis is observation-only; leverage, funding, margin, liquidation, and private positions are not modeled.',
+    );
+  return {
+    ...base,
+    signal,
+    strength: Math.abs(spread) > 0.003 ? 'moderate' : 'low',
+    risk: volatility > 0.02 ? 'high' : 'moderate',
+    reasons,
+    fastSma: fast,
+    slowSma: slow,
+    rsi,
+    volatility,
+  };
+}
+
+export function backtest(
+  history: Observation[],
+  pair: string,
+  risk: RiskSettings,
+  now: number,
+): BacktestResult {
+  if (history.length < 40)
+    throw new AppError(
+      'INSUFFICIENT_HISTORY',
+      `Backtesting needs at least 40 genuine, locally observed prices. ${history.length} are available. The collection supplies no historical candle endpoint.`,
+      422,
+    );
+  if (
+    history.some((observation, i) => {
+      try {
+        const price = new Decimal(observation.price);
+        return (
+          !price.isFinite() ||
+          price.lte(0) ||
+          !Number.isFinite(Number(observation.price)) ||
+          Number(observation.price) <= 0 ||
+          !Number.isSafeInteger(observation.time) ||
+          (i > 0 && observation.time <= history[i - 1].time)
+        );
+      } catch {
+        return true;
+      }
+    })
+  )
+    throw new AppError(
+      'INVALID_HISTORY',
+      'Backtesting requires finite positive analysis-range prices in strict chronological order.',
+      422,
+    );
+  const initial = new Decimal(100000);
+  let cash = initial;
+  let held = new Decimal(0);
+  let cost = new Decimal(0);
+  let peak = initial;
+  let drawdown = new Decimal(0);
+  let executions = 0;
+  let roundTrips = 0;
+  let wins = 0;
+  const feeRate = new Decimal(risk.feeBps).div(10000);
+  const slip = new Decimal(risk.slippageBps).div(10000);
+  const equityCurve = [];
+  for (let i = 0; i < history.length; i++) {
+    const observation = history[i];
+    const mark = new Decimal(observation.price);
+    // Decide with data ending at i-1 and execute at i. The current fill price
+    // is NEVER visible to the decision that caused that fill.
+    if (i >= 20) {
+      const decision = evaluate(history.slice(0, i), 'spot', pair, history[i - 1].time);
+      if (decision.signal === 'buy' && held.isZero()) {
+        const fill = mark.mul(slip.add(1));
+        const budget = Decimal.min(cash.div(feeRate.add(1)), risk.maximumOrderInr);
+        if (budget.gt(0)) {
+          held = budget.div(fill);
+          cost = budget.mul(feeRate.add(1));
+          cash = cash.sub(cost);
+          executions++;
+        }
+      } else if (decision.signal === 'sell' && held.gt(0)) {
+        const proceeds = held
+          .mul(mark)
+          .mul(new Decimal(1).sub(slip))
+          .mul(new Decimal(1).sub(feeRate));
+        cash = cash.add(proceeds);
+        if (proceeds.gt(cost)) wins++;
+        roundTrips++;
+        executions++;
+        held = new Decimal(0);
+        cost = new Decimal(0);
+      }
+    }
+    const equity = cash.add(held.mul(mark));
+    peak = Decimal.max(peak, equity);
+    drawdown = Decimal.max(drawdown, peak.sub(equity).div(peak).mul(100));
+    const value = equity.toNumber();
+    if (!Number.isFinite(value))
+      throw new AppError(
+        'UNSUPPORTED_NUMERIC_RANGE',
+        'Recorded prices would produce non-finite backtest metrics. No result was recorded.',
+        422,
+      );
+    equityCurve.push({ time: observation.time, value });
+  }
+  const final = cash.add(held.mul(history.at(-1)!.price));
+  return {
+    id: randomUUID(),
+    pair,
+    observations: history.length,
+    start: history[0].time,
+    end: history.at(-1)!.time,
+    initialEquity: initial.toString(),
+    finalEquity: final.toString(),
+    netPnl: final.sub(initial).toString(),
+    returnPercent: final.div(initial).sub(1).mul(100).toNumber(),
+    maxDrawdownPercent: drawdown.toNumber(),
+    executions,
+    completedRoundTrips: roundTrips,
+    winRatePercent: roundTrips ? (wins / roundTrips) * 100 : null,
+    feeBps: risk.feeBps,
+    slippageBps: risk.slippageBps,
+    createdAt: now,
+    caveats: [
+      'Exploratory long-only SMA/RSI simulation, not a forecast. No automatic optimization or learning is implemented.',
+      'Uses locally recorded ZebPay Spot observations only. No candles, synthetic history, future samples, leverage, or other exchange data.',
+      `Next-observation fills, assumed fee ${risk.feeBps} bps, and assumed slippage ${risk.slippageBps} bps. These are simulation inputs, NOT verified ZebPay fees.`,
+      'Unliquidated inventory is marked to the final observed price. No forced final fill or realized-profit claim is made.',
+      'Sampling gaps may suppress signals. Taxes, liquidity, partial fills, and exchange restrictions are not modeled.',
+      'Research backtests use the maximum-order cap, but do not model the paper daily-loss latch. They are not an execution-safety certification.',
+    ],
+    equityCurve,
+  };
+}
+export class ResearchEngine {
+  constructor(
+    private store: Store,
+    private now: () => number = Date.now,
+  ) {}
+  analyze(venue: Venue, pair: string): Decision {
+    const decision = evaluate(this.store.history(venue, pair, 0, 500), venue, pair, this.now());
+    this.store.transaction(() => {
+      this.store.addDecision(decision);
+      this.store.audit('decision_recorded', {
+        venue,
+        pair,
+        decisionId: decision.id,
+        side: decision.signal,
+      });
+    });
+    return decision;
+  }
+  runBacktest(pair: string): BacktestResult {
+    const result = backtest(
+      this.store.history('spot', pair, 0, 1000),
+      pair,
+      this.store.risk(),
+      this.now(),
+    );
+    this.store.transaction(() => {
+      this.store.addBacktest(result);
+      this.store.audit('backtest_recorded', { pair, count: result.observations });
+    });
+    return result;
+  }
+}
