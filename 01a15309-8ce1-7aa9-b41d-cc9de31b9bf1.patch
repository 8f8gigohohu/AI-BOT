+    expect(res.headers['cache-control']).toBe('no-store');
+    expect(runtime.fetcher).not.toHaveBeenCalled();
+  });
+  it('rejects malformed URL escapes without returning a server exception', async () => {
+    const runtime = makeTestApp({ configured: false });
+    const res = await request(runtime.app).get('/%E0%A4%A');
+    expect(res.status).toBe(400);
+    expect(res.text).toBe('');
+    expect(runtime.fetcher).not.toHaveBeenCalled();
+  });
+});
