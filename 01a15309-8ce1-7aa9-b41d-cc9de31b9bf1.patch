+    t.advance(24 * 60 * 60 * 1000);
+    const nextDayOwner = await owner(t.app); // Previous security session has correctly expired.
+    const response = await nextDayOwner.post('/api/orders', paperOrder('1', 'sell'));
+    expect(response.status).toBe(201);
+    expect(t.store.wallet().day).toBe('2026-10-20');
