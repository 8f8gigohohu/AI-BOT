diff --git a/scripts/audit-collection.mjs b/scripts/audit-collection.mjs
new file mode 100644
index 0000000..87c6935
--- /dev/null
+++ b/scripts/audit-collection.mjs
@@ -0,0 +1,221 @@
+import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
+import { createHash } from 'node:crypto';
+
+const path = process.argv[2];
+if (!path) {
+  console.error('Usage: npm run audit:collection -- /path/to/your/supplied-collection.json');
+  process.exit(1);
+}
+const bytes = readFileSync(path);
+const collection = JSON.parse(bytes);
+const digest = createHash('sha256').update(bytes).digest('hex');
+const EXPECTED = '0462b41646c31a25cc9580b873d91eb57c42072346807e86b7895795f4defdbd';
+if (digest !== EXPECTED)
+  throw new Error('Different collection. Review its changes before updating the pinned audit.');
+
+// Inspect EVERY example and array item, without publishing sample account IDs, tokens, or balances.
+function schema(values) {
+  const types = [
+    ...new Set(values.map((v) => (v === null ? 'null' : Array.isArray(v) ? 'array' : typeof v))),
+  ].sort();
+  const result = { types };
+  const arrays = values.filter(Array.isArray);
+  if (arrays.length) result.items = schema(arrays.flat());
+  const objects = values.filter((v) => v && typeof v === 'object' && !Array.isArray(v));
+  if (objects.length) {
+    const keys = [...new Set(objects.flatMap(Object.keys))].sort();
+    if (
+      keys.length > 80 &&
+      objects.every((o) =>
+        Object.values(o).every((v) => v && typeof v === 'object' && !Array.isArray(v)),
+      )
+    ) {
+      result.recordValues = schema(objects.flatMap(Object.values));
+    } else {
+      result.properties = Object.fromEntries(
+        keys.map((k) => [
+          k,
+          {
+            ...schema(objects.filter((o) => Object.hasOwn(o, k)).map((o) => o[k])),
+            presentInEveryExample: objects.every((o) => Object.hasOwn(o, k)),
+          },
+        ]),
+      );
+    }
+  }
+  return result;
+}
+const scriptAudit = [];
+const endpoints = [];
+function scripts(node, location) {
+  for (const e of node.event ?? []) {
+    const source = (e.script?.exec ?? []).join('\n');
+    scriptAudit.push({
+      location,
+      event: e.listen,
+      nonempty: Boolean(source.trim()),
+      sha256: createHash('sha256').update(source).digest('hex'),
+    });
+  }
+}
+function disposition(folder, name) {
+  if (folder === 'Market')
+    return name === 'Book'
+      ? {
+          support: 'partial',
+          implementation: 'unavailable',
+          reason:
+            'The request and example both use undefined {{baseUrl}}. No automatic casing alias or book_long endpoint is assumed.',
+        }
+      : {
+          support: 'full',
+          implementation: 'read-only',
+          reason:
+            name === 'Market'
+              ? 'Concrete originalRequest URL and response examples are present.'
+              : 'Defined {{baseurl}}, explicit group=singapore, and response example are present.',
+        };
+  if (folder === 'Trade API') {
+    if (name.startsWith('Place a New'))
+      return {
+        support: 'partial',
+        implementation: 'offline serializer only; transport blocked',
+        reason:
+          'POST signing and payloads are documented, but balance, fees, market limits, and write-permission checks cannot be verified. No live order can be sent.',
+      };
+    if (name.startsWith('List Trade'))
+      return {
+        support: 'full',
+        implementation: 'signed read-only',
+        reason: name.includes('Complete')
+          ? 'Use the documented Complete filter verbatim. Its example incorrectly contains a pending order: always show actual returned status.'
+          : 'Used for connection verification. Concrete URL, GET signature algorithm, query order, and response envelope are documented.',
+      };
+    if (name.startsWith('Cancel'))
+      return {
+        support: 'partial',
+        implementation: 'unavailable',
+        reason:
+          'DELETE signature algorithm and response format are absent. GET signing must not be assumed to apply to DELETE.',
+      };
+    return {
+      support: 'partial',
+      implementation: 'unavailable',
+      reason:
+        'Request exists, but no response example or response-field schema is supplied; {{baseUrl}} is also undefined here. Do not infer balances, fee units, fills, or trading filters.',
+    };
+  }
+  if (folder === 'Futures / Market' || name === 'ExchangeInfo' || name === 'HealthCheckStatus')
+    return {
+      support: 'full',
+      implementation: 'public read-only',
+      reason:
+        'Public request and response example supplied. Use the actual query-string URL, not contradictory prose path examples. Saved response examples pin the parser where prose differs.',
+    };
+  return {
+    support: 'partial',
+    implementation: 'unavailable',
+    reason:
+      'Futures has no scoped signature-generation algorithm; Trade API signing is scoped to its sibling Spot folder. Some Futures prose/requests conflict on Bearer vs X-AUTH headers, timestamp meaning, and response nesting. No token-acquisition flow is supplied. Never reuse Spot auth by assumption.',
+  };
+}
+function walk(items, trail = []) {
+  for (const item of items) {
+    const names = [...trail, item.name];
+    const location = names.join(' / ');
+    scripts(item, location);
+    if (item.item) {
+      walk(item.item, names);
+      continue;
+    }
+    const request = item.request;
+    const url = typeof request.url === 'string' ? request.url : request.url.raw;
+    const examples = [];
+    const responses = [];
+    for (const response of item.response ?? []) {
+      const original = response.originalRequest;
+      if (original) {
+        scripts(original, `${location} / originalRequest`);
+        const originalUrl = typeof original.url === 'string' ? original.url : original.url?.raw;
+        examples.push({ code: response.code, method: original.method, url: originalUrl });
+      }
+      if (response.body?.trim()) responses.push(JSON.parse(response.body));
+      // Traverse headers/cookies as well; deliberately retain no account-specific values.
+      for (const header of response.header ?? []) void header.value;
+      for (const cookie of response.cookie ?? []) void cookie.value;
+    }
+    let body;
+    if (request.body?.raw?.trim()) body = schema([JSON.parse(request.body.raw)]);
+    endpoints.push({
+      number: endpoints.length + 1,
+      location,
+      method: request.method,
+      url,
+      authType: request.auth?.type ?? 'none specified',
+      headerNames: (request.header ?? []).map((h) => h.key),
+      query: (request.url?.query ?? []).map((q) => ({
+        name: q.key,
+        enabled: !q.disabled,
+        description: q.description ?? '',
+      })),
+      bodySchema: body ?? null,
+      hasResponseDocumentation: Boolean(
+        responses.length ||
+        /Response (Body|\n)|#### Response|### Response/i.test(request.description ?? ''),
+      ),
+      responseExampleCount: responses.length,
+      responseSchema: responses.length ? schema(responses) : null,
+      exampleRequests: examples,
+      ...disposition(trail.join(' / '), item.name),
+      documentationConflicts: [
+        ...(url.includes('/market/ticker24Hr')
+          ? [
+              'Saved ticker info.priceChangePercentage and data.percentage disagree. Preserve both raw fields; do not infer a canonical percentage.',
+            ]
+          : []),
+        ...(/Bearer|Authorization/.test(request.description ?? '') &&
+        (request.header ?? []).some((h) => h.key === 'X-AUTH-SIGNATURE')
+          ? ['Prose describes Bearer authentication while request uses X-AUTH headers.']
+          : []),
+        ...((request.url?.query ?? []).some(
+          (q) => q.key === 'timestamp' && /marker|incremental/.test(q.description ?? ''),
+        )
+          ? [
+              'timestamp is described as a pagination cursor, not unambiguously an authentication nonce.',
+            ]
+          : []),
+      ],
+    });
+  }
+}
+scripts(collection, 'Collection');
+walk(collection.item);
+const report = {
+  sourceName: 'Zebpay API Documentation.postman_collection(1).json',
+  sourceSha256: digest,
+  auditedOn: '2026-10-19',
+  auditScope:
+    'All folders, 38 requests, descriptions, headers, query parameters, bodies, events, originalRequests, and every saved response/array item. No other exchange documentation used.',
+  collectionVariables: collection.variable,
+  requestCount: endpoints.length,
+  responseExampleCount: endpoints.reduce((n, e) => n + e.responseExampleCount, 0),
+  scriptAudit,
+  endpoints,
+  absent: [
+    'Historical candles/OHLCV',
+    'API-key scopes/permission introspection',
+    'IP-whitelist introspection',
+    'Account identity',
+    'Spot balance response schema',
+    'Spot fee response schema',
+    'Spot market filter response schema',
+    'DELETE signature generation',
+    'Futures-specific signature generation',
+    'Bearer token issuance',
+  ],
+};
+mkdirSync('docs', { recursive: true });
+writeFileSync('docs/collection-audit.json', JSON.stringify(report, null, 2) + '\n');
+console.log(
+  `Audited ${endpoints.length} requests, ${report.responseExampleCount} saved responses, ${scriptAudit.length} events. Source SHA-256 matches. No sample credentials/account values copied.`,
+);
diff --git a/scripts/check-secrets.mjs b/scripts/check-secrets.mjs
new file mode 100644
index 0000000..69e708c
--- /dev/null
+++ b/scripts/check-secrets.mjs
@@ -0,0 +1,88 @@
+import { execFileSync } from 'node:child_process';
+import { readFileSync, statSync, readdirSync, existsSync } from 'node:fs';
+import { join } from 'node:path';
+
+const tracked = execFileSync('git', ['ls-files', '-z'], { encoding: 'utf8' })
+  .split('\0')
+  .filter(Boolean);
+const candidates = execFileSync(
+  'git',
+  ['ls-files', '-z', '--cached', '--others', '--exclude-standard'],
+  { encoding: 'utf8' },
+)
+  .split('\0')
+  .filter(Boolean);
+const problems = new Set();
+for (const path of tracked) {
+  if (
+    /^\.runtime\//.test(path) ||
+    (/(^|\/)\.env(?:\..*)?$/.test(path) && !path.endsWith('.env.example')) ||
+    /\.(sqlite(?:-.*)?|db(?:-.*)?|enc|key|pem|p12|pfx)$/.test(path) ||
+    /(?:^|\/)owner\.json(?:\..*\.tmp)?$/.test(path) ||
+    /zebpay\.enc\..*\.tmp$/.test(path) ||
+    /\.postman_collection.*\.json$/.test(path)
+  )
+    problems.add(`${path}: private/runtime/export file tracked`);
+}
+for (const path of candidates) {
+  if (
+    !existsSync(path) ||
+    statSync(path).isDirectory() ||
+    statSync(path).size > 2_000_000 ||
+    /package-lock\.json$/.test(path)
+  )
+    continue;
+  const text = readFileSync(path, 'utf8');
+  if (/-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/.test(text))
+    problems.add(`${path}: private-key material detected`);
+  if (/\b(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,})\b/.test(text))
+    problems.add(`${path}: access-token pattern detected`);
+  if (/\bDARKDEVIL_MASTER_KEY\s*[:=]\s*['\"]?[A-Za-z0-9+/]{43}=/.test(text))
+    problems.add(`${path}: potential hardcoded encryption key`);
+  const literals = text.matchAll(
+    /\b(?:APIKEY|SECRET|apiKey|apiSecret|API_SECRET|API_KEY)\s*[:=]\s*['"]([^'"\n]{12,})['"]/g,
+  );
+  for (const match of literals) {
+    const value = match[1];
+    const syntheticFixture = path.startsWith('tests/') && value.startsWith('test-only-');
+    const nonValue = /^(?:\{\{|process\.|Enter |ZebPay |test-only-)/.test(value);
+    if (!syntheticFixture && !nonValue)
+      problems.add(`${path}: potential hardcoded exchange credential`);
+  }
+}
+const client = 'dist/client/assets';
+if (existsSync(client))
+  for (const name of readdirSync(client).filter((n) => n.endsWith('.js'))) {
+    const text = readFileSync(join(client, name), 'utf8');
+    if (
+      text.includes('test-only-api-secret-not-an-account') ||
+      text.includes('test-only-api-key-not-an-account')
+    )
+      problems.add(`${client}/${name}: test-only exchange fixture leaked into client bundle`);
+  }
+for (const probe of [
+  'custom-private-store/master.key',
+  'custom-private-store/owner.json',
+  'custom-private-store/zebpay.enc.123.tmp',
+  '.runtime/zebpay.enc',
+  '.runtime/master.key',
+  '.runtime/owner.json',
+  '.runtime/workspace.sqlite',
+  '.env',
+  'example.postman_collection(1).json',
+  'darkdevil-journal-2026-10-19.json',
+]) {
+  try {
+    execFileSync('git', ['check-ignore', '-q', probe]);
+  } catch {
+    problems.add(`${probe}: missing ignore protection`);
+  }
+}
+if (problems.size) {
+  // Intentionally print locations/reasons, never matched secret contents.
+  console.error('Secret safeguard failed:\n' + [...problems].map((p) => `- ${p}`).join('\n'));
+  process.exitCode = 1;
+} else
+  console.log(
+    `Secret safeguard passed for ${candidates.length} working-tree files. Runtime/config/export paths are ignored; no detected hardcoded credentials or test fixture in the built client. This heuristic does not replace reviewing your diff.`,
+  );
