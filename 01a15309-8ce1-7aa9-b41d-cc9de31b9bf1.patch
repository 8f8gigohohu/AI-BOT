+export function Watchlist({
+  market,
+  venue,
+  pair,
+  chooseMarket,
+  navigate,
+  expanded = false,
+}: MarketProps & Pick<CommonProps, 'navigate'> & { expanded?: boolean }) {
+  const [search, setSearch] = useState('');
+  const list = (market?.markets ?? []).filter(
+    (m) =>
+      (venue === 'futures' || m.quote === 'INR') &&
+      `${m.pair} ${m.base}`.toLowerCase().includes(search.toLowerCase()),
+  );
+  const priority = ['BTC', 'ETH', 'SOL', 'XRP', 'DOGE'];
+  const sorted = [...list].sort((a, b) => {
+    const ai = priority.indexOf(a.base),
+      bi = priority.indexOf(b.base);
+    return (ai < 0 ? 999 : ai) - (bi < 0 ? 999 : bi);
+  });
+  const shown = expanded ? sorted : sorted.slice(0, 5);
+  return (
+    <Panel
+      title={expanded ? 'Market explorer' : 'Market watch'}
+      actions={
+        !expanded ? (
+          <TextLink onClick={() => navigate('markets')}>View all markets</TextLink>
+        ) : (
+          <Badge>{list.length} returned markets</Badge>
+        )
+      }
+      className="watchlist-panel"
+    >
+      <div className="market-search">
+        <Search size={15} />
+        <input
+          aria-label="Search returned markets"
+          placeholder="Search a market…"
+          value={search}
+          onChange={(e) => setSearch(e.target.value)}
+        />
+        <span>{venue === 'spot' ? 'INR' : 'FUTURES'}</span>
+      </div>
+      {shown.length ? (
+        <div className="table-scroll">
+          <table className="market-table">
+            <thead>
+              <tr>
+                <th>Market</th>
+                <th>Last observed price</th>
+                <th>24h change</th>
+                {expanded && <th>Volume (base)</th>}
+                <th aria-label="Select market" />
+              </tr>
+            </thead>
+            <tbody>
+              {shown.map((m) => (
+                <tr key={m.pair} className={m.pair === pair ? 'selected-row' : ''}>
+                  <td>
+                    <button className="market-cell" onClick={() => chooseMarket(venue, m.pair)}>
+                      <span className={`coin-icon small coin-${m.base.toLowerCase()}`}>
+                        {m.base.slice(0, 1)}
+                      </span>
+                      <span>
+                        <strong>
+                          {m.base}
+                          <small> / {m.quote}</small>
+                        </strong>
+                        <span>ZebPay {venue === 'spot' ? 'Spot' : 'Futures'}</span>
+                      </span>
+                    </button>
+                  </td>
+                  <td className="mono">{formatPrice(m.price, m.quote)}</td>
+                  <td>
+                    <span
+                      className={`mono change-cell ${m.change24h === null ? 'muted' : m.change24h >= 0 ? 'positive' : 'negative'}`}
+                    >
+                      {m.change24h !== null &&
+                        (m.change24h >= 0 ? (
+                          <ArrowUpRight size={12} />
+                        ) : (
+                          <ArrowDownRight size={12} />
+                        ))}
+                      {percent(m.change24h)}
+                    </span>
+                  </td>
+                  {expanded && <td className="mono muted">{formatNumber(m.volume, 2)}</td>}
+                  <td>
+                    <button
+                      className="icon-button"
+                      onClick={() => {
+                        chooseMarket(venue, m.pair);
+                        if (expanded) navigate('overview');
+                      }}
+                      aria-label={`Open ${m.pair}`}
+                    >
+                      <ArrowUpRight size={15} />
+                    </button>
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      ) : (
+        <Empty
+          compact
+          icon={<Search size={21} />}
+          title={search ? 'No matching returned markets' : 'Waiting for ZebPay markets'}
+          text={
+            search
+              ? 'Try a different symbol. Only markets returned by ZebPay are listed.'
+              : 'Verified market prices will appear here. Saved collection examples are never shown as live data.'
+          }
+        />
+      )}
+      {!expanded && (
+        <div className="table-foot">
+          <span className="tiny-dot gray" />
+          Prices are observations, not execution guarantees.
+        </div>
+      )}
+    </Panel>
+  );
+}
