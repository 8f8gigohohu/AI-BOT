+describe('Fail-closed live, cancellation, and emergency workflow', () => {
+  it('starts and stays in paper mode; explicit opt-in cannot bypass missing contracts', async () => {
+    const t = makeTestApp();
+    const o = await owner(t.app);
+    expect((await o.get('/api/workspace')).body.liveEnabled).toBe(false);
+    expect((await o.post('/api/live/enable', { confirmation: 'yes' })).body.error.code).toBe(
+      'RISK_CONFIRMATION_REQUIRED',
+    );
+    expect(
+      (
+        await o.post('/api/live/enable', {
+          confirmation: 'I UNDERSTAND LIVE TRADING CAN LOSE MONEY',
+        })
+      ).body.error.code,
+    ).toBe('LIVE_UNSUPPORTED');
+    expect((await o.get('/api/workspace')).body.liveEnabled).toBe(false);
+    expect(t.fetcher).not.toHaveBeenCalled();
+  });
+  it('rejects all live order attempts even with frontend override flags and valid-looking payloads', async () => {
+    const t = makeTestApp();
+    const o = await owner(t.app);
+    const response = await o.post('/api/orders', {
+      ...paperOrder(),
+      mode: 'live',
+      liveEnabled: true,
+      riskConfirmed: true,
+      bypassValidation: true,
+      apiKey: TEST_KEY,
+      apiSecret: TEST_SECRET,
+    });
+    expect(response.body.error.code).toBe('LIVE_DISABLED');
+    expect(t.fetcher).not.toHaveBeenCalled();
+    expect(JSON.stringify(t.store.auditEvents())).not.toContain(TEST_SECRET);
+  });
+  it('has no transfer/withdrawal API or cancellation signing implementation', async () => {
+    const t = makeTestApp();
+    const o = await owner(t.app);
+    for (const path of ['/api/withdraw', '/api/transfer', '/api/futures/order', '/api/proxy'])
+      expect((await o.post(path, {})).status).toBe(404);
+    expect((await o.delete('/api/orders/42')).body.error.code).toBe('CANCEL_UNSUPPORTED');
+    expect(t.fetcher).not.toHaveBeenCalled();
+  });
+  it('emergency stop persists across restart and prevents paper requests before even fetching a quote', async () => {
+    const t = makeTestApp();
+    const o = await owner(t.app);
+    await o.post('/api/kill-switch', { enabled: true });
+    expect((await o.post('/api/orders', paperOrder())).body.error.code).toBe('KILL_SWITCH_ACTIVE');
+    expect(t.fetcher).not.toHaveBeenCalled();
+    t.close();
+    const restarted = makeTestApp({ config: t.config });
+    const r = await owner(restarted.app);
+    expect(restarted.store.risk().killSwitch).toBe(true);
+    expect((await r.post('/api/orders', paperOrder())).body.error.code).toBe('KILL_SWITCH_ACTIVE');
+    expect(restarted.fetcher).not.toHaveBeenCalled();
+  });
+  it('requires a separate reset phrase and never enables live trading when resetting the stop', async () => {
+    const t = makeTestApp();
+    const o = await owner(t.app);
+    await o.post('/api/kill-switch', { enabled: true });
+    expect((await o.post('/api/kill-switch', { enabled: false, confirmation: 'yes' })).status).toBe(
+      409,
+    );
+    expect(
+      (await o.post('/api/kill-switch', { enabled: false, confirmation: 'RESET KILL SWITCH' })).body
+        .liveEnabled,
+    ).toBe(false);
+    expect(t.store.risk().killSwitch).toBe(false);
+  });
+  it('rejects a stale quote if the emergency stop is activated while quote validation is pending', async () => {
+    const t = makeTestApp();
+    const o = await owner(t.app);
+    let release!: (value: Market[]) => void;
+    let started!: () => void;
+    const begun = new Promise<void>((resolve) => {
+      started = resolve;
+    });
+    vi.spyOn(t.markets, 'paperMarkets').mockImplementation(() => {
+      started();
+      return new Promise((resolve) => {
+        release = resolve;
+      });
+    });
+    const pending = o.post('/api/orders', paperOrder()).then((r) => r);
+    await begun;
+    await o.post('/api/kill-switch', { enabled: true });
+    release([]);
+    expect((await pending).body.error.code).toBe('KILL_SWITCH_ACTIVE');
+    expect(t.store.wallet().cash).toBe('100000');
+  });
+  it('does not reactivate or save credentials if disconnected during verification', async () => {
+    let finish!: (response: Response) => void;
+    let begun!: () => void;
+    const started = new Promise<void>((r) => {
+      begun = r;
+    });
+    const fetcher = vi.fn(() => {
+      begun();
+      return new Promise<Response>((resolve) => {
+        finish = resolve;
+      });
+    });
+    const t = makeTestApp({ fetcher });
+    const o = await owner(t.app);
+    const pending = o
