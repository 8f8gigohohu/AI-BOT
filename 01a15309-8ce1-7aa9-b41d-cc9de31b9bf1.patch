--- /dev/null
+++ b/server/store.ts
@@ -0,0 +1,327 @@
+import { DatabaseSync } from 'node:sqlite';
+import { createHmac, hkdfSync, randomUUID } from 'node:crypto';
+import { chmodSync } from 'node:fs';
+import { resolve } from 'node:path';
+import type {
+  AuditEvent,
+  Observation,
+  PaperWallet,
+  RiskSettings,
+  PaperTrade,
+  Decision,
+  BacktestResult,
+  Venue,
+} from '../shared/types.js';
+import { AppError } from './errors.js';
+
+export const DEFAULT_RISK: RiskSettings = {
+  maximumOrderInr: '5000',
+  dailyLossInr: '1000',
+  feeBps: 10,
+  slippageBps: 5,
+  killSwitch: false,
+};
+export function newPaperWallet(now = Date.now(), cash = '100000'): PaperWallet {
+  return {
+    portfolioId: randomUUID(),
+    initialCash: cash,
+    cash,
+    positions: {},
+    realizedPnl: '0',
+    day: new Date(now).toISOString().slice(0, 10),
+    dayOpeningEquity: cash,
+  };
+}
+type AuditDetails = Partial<
+  Record<
+    | 'reasonCode'
+    | 'pair'
+    | 'venue'
+    | 'side'
+    | 'requestId'
+    | 'orderId'
+    | 'decisionId'
+    | 'tradeId'
+    | 'operation'
+    | 'count'
+    | 'status'
+    | 'maximumOrderInr'
+    | 'dailyLossInr'
+    | 'feeBps'
+    | 'slippageBps'
+    | 'ipStatus',
+    string | number | boolean | null
+  >
+>;
+const AUDIT_KEYS = new Set([
+  'reasonCode',
+  'pair',
+  'venue',
+  'side',
+  'requestId',
+  'orderId',
+  'decisionId',
+  'tradeId',
+  'operation',
+  'count',
+  'status',
+  'maximumOrderInr',
+  'dailyLossInr',
+  'feeBps',
+  'slippageBps',
+  'ipStatus',
+]);
+
+export class Store {
+  readonly db: DatabaseSync;
+  private auditKey: Buffer;
+  constructor(dataDir: string, masterKey: Buffer) {
+    const path = resolve(dataDir, 'workspace.sqlite');
+    this.db = new DatabaseSync(path);
+    this.auditKey = Buffer.from(hkdfSync('sha256', masterKey, 'darkdevil', 'audit-v1', 32));
+    try {
+      chmodSync(path, 0o600);
+      this.db.exec(`
+      PRAGMA journal_mode = WAL;
+      PRAGMA synchronous = FULL;
+      PRAGMA busy_timeout = 5000;
+      CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, body TEXT NOT NULL);
+      CREATE TABLE IF NOT EXISTS observations (venue TEXT NOT NULL, pair TEXT NOT NULL, bucket INTEGER NOT NULL, time INTEGER NOT NULL, price TEXT NOT NULL, PRIMARY KEY(venue, pair, bucket));
+      CREATE INDEX IF NOT EXISTS observation_time ON observations(venue, pair, time);
+      CREATE TABLE IF NOT EXISTS paper_trades (id TEXT PRIMARY KEY, portfolio_id TEXT NOT NULL, request_id TEXT NOT NULL UNIQUE, fingerprint TEXT NOT NULL, created_at INTEGER NOT NULL, body TEXT NOT NULL);
+      CREATE INDEX IF NOT EXISTS paper_portfolio_time ON paper_trades(portfolio_id,created_at DESC);
+      CREATE INDEX IF NOT EXISTS paper_decision_time ON paper_trades(json_extract(body,'$.decisionId'),created_at DESC);
+      CREATE TABLE IF NOT EXISTS decisions (id TEXT PRIMARY KEY, created_at INTEGER NOT NULL, body TEXT NOT NULL);
+      CREATE INDEX IF NOT EXISTS decision_pair_time ON decisions(json_extract(body,'$.venue'),json_extract(body,'$.pair'),created_at DESC);
+      CREATE TABLE IF NOT EXISTS backtests (id TEXT PRIMARY KEY, created_at INTEGER NOT NULL, body TEXT NOT NULL);
+      CREATE INDEX IF NOT EXISTS backtest_pair_time ON backtests(json_extract(body,'$.pair'),created_at DESC);
+      CREATE TABLE IF NOT EXISTS audit (id INTEGER PRIMARY KEY AUTOINCREMENT, time INTEGER NOT NULL, action TEXT NOT NULL, details TEXT NOT NULL, previous_hash TEXT NOT NULL, hash TEXT NOT NULL);
+    `);
+      if (!this.setting<RiskSettings>('risk')) this.set('risk', DEFAULT_RISK);
+      if (!this.setting<PaperWallet>('paper')) this.set('paper', newPaperWallet());
+      if (!this.verifyAudit()) {
+        throw new AppError(
+          'AUDIT_INTEGRITY',
+          'Audit integrity check failed. Workspace execution is locked; restore a trusted backup.',
+          503,
+        );
+      }
+    } catch (error) {
+      this.db.close();
+      this.auditKey.fill(0);
+      throw error;
+    }
+  }
+  setting<T>(key: string): T | null {
+    const row = this.db.prepare('SELECT body FROM settings WHERE key = ?').get(key);
+    return row ? (JSON.parse(String(row.body)) as T) : null;
+  }
+  set(key: string, value: unknown): void {
+    this.db
+      .prepare(
+        'INSERT INTO settings(key,body) VALUES(?,?) ON CONFLICT(key) DO UPDATE SET body=excluded.body',
+      )
+      .run(key, JSON.stringify(value));
+  }
+  risk(): RiskSettings {
+    return this.setting<RiskSettings>('risk')!;
+  }
+  wallet(): PaperWallet {
+    return this.setting<PaperWallet>('paper')!;
+  }
+  transaction<T>(work: () => T): T {
+    this.db.exec('BEGIN IMMEDIATE');
+    try {
+      const value = work();
+      this.db.exec('COMMIT');
+      return value;
+    } catch (e) {
+      this.db.exec('ROLLBACK');
+      throw e;
+    }
+  }
+  observe(venue: Venue, pair: string, time: number, price: string): void {
+    this.db
+      .prepare('INSERT OR IGNORE INTO observations(venue,pair,bucket,time,price) VALUES(?,?,?,?,?)')
+      .run(venue, pair, Math.floor(time / 15000), time, price);
+    // Bounded research history; there is no remote historical endpoint in the collection.
+    this.db
+      .prepare(
+        'DELETE FROM observations WHERE venue=? AND pair=? AND bucket NOT IN (SELECT bucket FROM observations WHERE venue=? AND pair=? ORDER BY time DESC LIMIT 10000)',
+      )
+      .run(venue, pair, venue, pair);
+  }
+  history(venue: Venue, pair: string, since = 0, limit = 1000): Observation[] {
+    const rows = this.db
+      .prepare(
+        'SELECT time,price FROM (SELECT time,price FROM observations WHERE venue=? AND pair=? AND time>=? ORDER BY time DESC LIMIT ?) ORDER BY time ASC',
+      )
+      .all(venue, pair, since, limit);
+    return rows.map((r) => ({ time: Number(r.time), price: String(r.price) }));
+  }
+  findRequest(requestId: string): { trade: PaperTrade; fingerprint: string } | null {
+    const row = this.db
+      .prepare('SELECT body,fingerprint FROM paper_trades WHERE request_id=?')
+      .get(requestId);
+    return row
+      ? { trade: JSON.parse(String(row.body)), fingerprint: String(row.fingerprint) }
+      : null;
+  }
+  recentFingerprint(fingerprint: string, since: number): boolean {
+    return Boolean(
+      this.db
+        .prepare('SELECT 1 FROM paper_trades WHERE fingerprint=? AND created_at>? LIMIT 1')
+        .get(fingerprint, since),
+    );
+  }
+  addTrade(trade: PaperTrade, fingerprint: string): void {
+    this.db
+      .prepare(
+        'INSERT INTO paper_trades(id,portfolio_id,request_id,fingerprint,created_at,body) VALUES(?,?,?,?,?,?)',
+      )
+      .run(
+        trade.id,
+        trade.portfolioId,
+        trade.requestId,
+        fingerprint,
+        trade.createdAt,
+        JSON.stringify(trade),
+      );
+  }
+  trades(portfolioId: string): PaperTrade[] {
+    return this.db
+      .prepare(
+        'SELECT body FROM paper_trades WHERE portfolio_id=? ORDER BY created_at DESC,rowid DESC LIMIT 200',
+      )
+      .all(portfolioId)
+      .map((r) => JSON.parse(String(r.body)));
+  }
+  addDecision(d: Decision): void {
+    this.db
+      .prepare('INSERT INTO decisions(id,created_at,body) VALUES(?,?,?)')
+      .run(d.id, d.createdAt, JSON.stringify(d));
+  }
+  decision(id: string): Decision | null {
+    const row = this.db.prepare('SELECT body FROM decisions WHERE id=?').get(id);
+    return row ? JSON.parse(String(row.body)) : null;
+  }
+  decisions(page = 1, pageSize = 100): Decision[] {
+    return this.db
+      .prepare('SELECT body FROM decisions ORDER BY created_at DESC,rowid DESC LIMIT ? OFFSET ?')
+      .all(pageSize, (page - 1) * pageSize)
+      .map((r) => JSON.parse(String(r.body)));
+  }
+  latestDecision(venue: Venue, pair: string): Decision | null {
+    const row = this.db
+      .prepare(
+        "SELECT body FROM decisions WHERE json_extract(body,'$.venue')=? AND json_extract(body,'$.pair')=? ORDER BY created_at DESC,rowid DESC LIMIT 1",
+      )
+      .get(venue, pair);
+    return row ? JSON.parse(String(row.body)) : null;
+  }
+  latestBacktest(pair: string): BacktestResult | null {
+    const row = this.db
+      .prepare(
+        "SELECT body FROM backtests WHERE json_extract(body,'$.pair')=? ORDER BY created_at DESC,rowid DESC LIMIT 1",
+      )
+      .get(pair);
+    return row ? JSON.parse(String(row.body)) : null;
+  }
+  decisionCount(): number {
+    return Number(this.db.prepare('SELECT COUNT(*) AS total FROM decisions').get()!.total);
+  }
+  *allPortfolioTrades(portfolioId: string): IterableIterator<PaperTrade> {
+    for (const row of this.db
+      .prepare('SELECT body FROM paper_trades WHERE portfolio_id=? ORDER BY rowid ASC')
+      .iterate(portfolioId))
+      yield JSON.parse(String(row.body));
+  }
+  *allDecisionTrades(ids: string[]): IterableIterator<PaperTrade> {
+    if (!ids.length) return;
+    // IDs are bound values; only placeholder count is generated internally.
+    for (const row of this.db
+      .prepare(
+        `SELECT body FROM paper_trades WHERE json_extract(body,'$.decisionId') IN (${ids.map(() => '?').join(',')}) ORDER BY rowid ASC`,
+      )
+      .iterate(...ids))
+      yield JSON.parse(String(row.body));
+  }
+  decisionFills(
+    id: string,
+    page: number,
+    pageSize: number,
+  ): { trades: PaperTrade[]; total: number } {
+    const total = Number(
+      this.db
+        .prepare(
+          "SELECT COUNT(*) AS total FROM paper_trades WHERE json_extract(body,'$.decisionId')=?",
+        )
+        .get(id)!.total,
+    );
+    const trades = this.db
+      .prepare(
+        "SELECT body FROM paper_trades WHERE json_extract(body,'$.decisionId')=? ORDER BY created_at DESC,rowid DESC LIMIT ? OFFSET ?",
+      )
+      .all(id, pageSize, (page - 1) * pageSize)
+      .map((row) => JSON.parse(String(row.body)) as PaperTrade);
+    return { total, trades };
+  }
+  addBacktest(b: BacktestResult): void {
+    this.db
+      .prepare('INSERT INTO backtests(id,created_at,body) VALUES(?,?,?)')
+      .run(b.id, b.createdAt, JSON.stringify(b));
+  }
+  backtests(): BacktestResult[] {
+    return this.db
+      .prepare('SELECT body FROM backtests ORDER BY created_at DESC LIMIT 20')
+      .all()
+      .map((r) => JSON.parse(String(r.body)));
+  }
+  audit(action: string, details: AuditDetails = {}, time = Date.now()): void {
+    if (
+      !/^[a-z_]{2,50}$/.test(action) ||
+      Object.entries(details).some(
+        ([key, v]) => !AUDIT_KEYS.has(key) || (typeof v === 'string' && v.length > 100),
+      )
+    )
+      throw new Error('Unsafe audit event rejected.');
+    const previous = this.db.prepare('SELECT hash FROM audit ORDER BY id DESC LIMIT 1').get();
+    const previousHash = previous ? String(previous.hash) : 'genesis';
+    const body = JSON.stringify(details);
+    const hash = createHmac('sha256', this.auditKey)
+      .update(JSON.stringify([time, action, body, previousHash]))
+      .digest('hex');
+    this.db
+      .prepare('INSERT INTO audit(time,action,details,previous_hash,hash) VALUES(?,?,?,?,?)')
+      .run(time, action, body, previousHash, hash);
+  }
+  auditEvents(): AuditEvent[] {
+    return this.db
+      .prepare('SELECT id,time,action,details,hash FROM audit ORDER BY id DESC LIMIT 200')
+      .all()
+      .map((r) => ({
+        id: Number(r.id),
+        time: Number(r.time),
+        action: String(r.action),
+        details: JSON.parse(String(r.details)),
+        hash: String(r.hash),
+      }));
+  }
+  verifyAudit(): boolean {
+    let previous = 'genesis';
+    for (const row of this.db.prepare('SELECT * FROM audit ORDER BY id ASC').iterate()) {
+      const expected = createHmac('sha256', this.auditKey)
+        .update(
+          JSON.stringify([Number(row.time), String(row.action), String(row.details), previous]),
+        )
+        .digest('hex');
+      if (row.previous_hash !== previous || row.hash !== expected) return false;
+      previous = expected;
+    }
+    return true;
+  }
+  close(): void {
+    this.db.close();
+    this.auditKey.fill(0);
+  }
+}
