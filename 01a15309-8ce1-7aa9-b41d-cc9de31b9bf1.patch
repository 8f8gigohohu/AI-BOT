+import { CredentialVault } from '../server/vault';
+import { cleanup, makeTestApp, owner } from './helpers';
+import { TEST_KEY, TEST_PASSWORD, TEST_SECRET, exampleOrder } from './fixtures';
+
+afterEach(cleanup);
+describe('Owner boundary and session safety', () => {
+  it('is read-only until local owner setup; it never bootstraps a public admin account', async () => {
+    const t = makeTestApp({ configured: false });
+    const a = request.agent(t.app);
+    const s = await a.get('/api/session').set('Host', 'localhost');
+    expect(s.body).toMatchObject({ configured: false, authenticated: false });
+    const attempt = await a
+      .post('/api/session/login')
+      .set('Host', 'localhost')
+      .set('Origin', 'http://localhost')
+      .set('X-CSRF-Token', s.body.csrfToken)
+      .send({ password: TEST_PASSWORD });
+    expect(attempt.status).toBe(503);
+    expect(t.fetcher).not.toHaveBeenCalled();
+  });
+  it('does not expose private account data or credential entry to anonymous users', async () => {
+    const t = makeTestApp();
+    for (const path of [
+      '/api/workspace',
+      '/api/connection',
+      '/api/journal',
+      '/api/account/balances',
+    ])
+      expect((await request(t.app).get(path)).status).toBe(401);
+    expect(t.fetcher).not.toHaveBeenCalled();
+  });
+  it('sets HttpOnly, SameSite=Strict cookies and rotates the session on login', async () => {
+    const t = makeTestApp();
+    const a = request.agent(t.app);
+    const s = await a.get('/api/session').set('Host', 'localhost');
+    const cookie = s.headers['set-cookie'][0];
+    expect(cookie).toContain('HttpOnly');
+    expect(cookie).toContain('SameSite=Strict');
+    const login = await a
+      .post('/api/session/login')
+      .set('Host', 'localhost')
+      .set('Origin', 'http://localhost')
+      .set('X-CSRF-Token', s.body.csrfToken)
+      .send({ password: TEST_PASSWORD });
+    expect(login.status).toBe(200);
+    expect(login.body.csrfToken).not.toBe(s.body.csrfToken);
+    expect(login.headers['set-cookie'][0].split(';')[0]).not.toBe(cookie.split(';')[0]);
+  });
+  it('uses Secure host-only cookies behind the HTTPS preview proxy', async () => {
+    const t = makeTestApp();
+    const s = await request(t.app)
+      .get('/api/session')
+      .set('Host', 'preview.e2b.app')
+      .set('X-Forwarded-Proto', 'https');
+    expect(s.headers['set-cookie'][0]).toMatch(/^__Host-ddq=/);
+    expect(s.headers['set-cookie'][0]).toContain('Secure');
+    expect(s.headers['set-cookie'][0]).not.toContain('Domain=');
+  });
+  it('rejects cross-origin, missing-CSRF, malformed-CSRF, and non-JSON actions before exchange access', async () => {
+    const t = makeTestApp();
+    const o = await owner(t.app);
+    const wrongOrigin = await o.agent
+      .post('/api/connection')
+      .set('Host', 'localhost')
+      .set('Origin', 'https://attacker.invalid')
+      .set('X-CSRF-Token', o.csrf)
+      .send({});
+    expect(wrongOrigin.body.error.code).toBe('ORIGIN_REJECTED');
+    const missing = await o.agent
+      .post('/api/connection')
+      .set('Host', 'localhost')
+      .set('Origin', 'http://localhost')
+      .send({});
+    expect(missing.body.error.code).toBe('CSRF_REJECTED');
+    const malformed = await o.agent
+      .post('/api/connection')
+      .set('Host', 'localhost')
+      .set('Origin', 'http://localhost')
+      .set('X-CSRF-Token', 'a'.repeat(63) + '!')
+      .send({});
+    expect(malformed.status).toBe(403);
+    const nonJson = await o.agent
+      .post('/api/connection')
+      .set('Host', 'localhost')
+      .set('Origin', 'http://localhost')
+      .set('X-CSRF-Token', o.csrf)
+      .type('form')
+      .send('apiKey=test');
+    expect(nonJson.body.error.code).toBe('JSON_REQUIRED');
+    expect(t.fetcher).not.toHaveBeenCalled();
+  });
+  it('rate-limits password attempts without logging submitted passwords', async () => {
+    const t = makeTestApp();
+    const a = request.agent(t.app);
+    const s = await a.get('/api/session').set('Host', 'localhost');
+    for (let i = 0; i < 6; i++)
+      expect(
+        (
+          await a
+            .post('/api/session/login')
+            .set('Host', 'localhost')
+            .set('Origin', 'http://localhost')
+            .set('X-CSRF-Token', s.body.csrfToken)
+            .send({ password: 'test-only-wrong-password' })
+        ).status,
+      ).toBe(401);
+    expect(
+      (
+        await a
+          .post('/api/session/login')
+          .set('Host', 'localhost')
+          .set('Origin', 'http://localhost')
+          .set('X-CSRF-Token', s.body.csrfToken)
+          .send({ password: 'test-only-wrong-password' })
+      ).status,
+    ).toBe(429);
+    expect(JSON.stringify(t.store.auditEvents())).not.toContain('test-only-wrong-password');
+  });
+  it('expires owner access after 30 minutes of inactivity', async () => {
+    const t = makeTestApp();
+    const o = await owner(t.app);
+    t.advance(30 * 60000 + 1);
