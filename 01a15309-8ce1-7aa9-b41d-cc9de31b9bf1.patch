+      side: 'ask',
+      size: 0.00001,
+      tradeType: 2,
+      platform: 'API_Trading',
+      timestamp: now,
+    });
+    expect(() =>
+      documentedSpotPayload({ type: 'market', pair: 'BTC-INR', side: 'buy', quantity: '1' }, now),
