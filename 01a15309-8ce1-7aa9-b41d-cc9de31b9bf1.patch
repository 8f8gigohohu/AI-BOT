+import { Badge, Empty, Notice, PageHeading, Panel } from '../components/ui';
+interface Endpoint {
+  number: number;
+  location: string;
+  method: string;
+  url: string;
+  support: string;
+  implementation: string;
+  reason: string;
+  conflicts: string[];
+  responseExamples: number;
+}
+interface AuditData {
+  source: string;
+  sha256: string;
+  requests: number;
+  endpoints: Endpoint[];
+}
+export function AuditPage() {
+  const [data, setData] = useState<AuditData | null>(null),
+    [error, setError] = useState(''),
+    [filter, setFilter] = useState('all'),
+    [search, setSearch] = useState('');
+  useEffect(() => {
+    const controller = new AbortController();
+    api<AuditData>('/api/collection', 'GET', undefined, controller.signal)
+      .then(setData)
+      .catch(() => {
+        if (!controller.signal.aborted)
+          setError(
+            'The endpoint inventory could not be loaded. The checked-in audit is available in docs/collection-audit.json.',
+          );
+      });
+    return () => controller.abort();
+  }, []);
+  const filtered = useMemo(
+    () =>
+      (data?.endpoints ?? []).filter(
+        (e) =>
+          (filter === 'all' ||
+            (filter === 'futures'
+              ? e.location.startsWith('Futures')
+              : !e.location.startsWith('Futures'))) &&
+          `${e.location} ${e.url} ${e.reason}`.toLowerCase().includes(search.toLowerCase()),
+      ),
+    [data, filter, search],
+  );
+  return (
+    <>
+      <PageHeading
+        eyebrow="SOURCE OF TRUTH"
+        title="Documented. Not assumed"
+        description="A request-by-request audit of your exact Postman collection. Nothing borrowed from another exchange."
+        actions={
+          <Badge tone="green">
+            <ShieldCheck size={13} />
+            Collection-pinned integration
+          </Badge>
+        }
+      />
+      <div className="source-card">
+        <div className="source-icon">
+          <FileJson2 size={30} />
+        </div>
+        <div className="source-card-text">
+          <span className="eyebrow">THE ONLY EXCHANGE DOCUMENTATION USED</span>
+          <h2>{SOURCE_NAME}</h2>
+          <p>
+            <Fingerprint size={13} />
+            <span className="mono">SHA-256 · {SOURCE_SHA256}</span>
+          </p>
+        </div>
+        <Badge>Audited 19 Oct 2026</Badge>
+      </div>
+      <div className="audit-stats">
+        <div>
+          <strong className="mono">38</strong>
+          <span>requests inspected</span>
+        </div>
+        <div>
+          <strong className="mono">30</strong>
+          <span>saved responses inspected</span>
+        </div>
+        <div>
+          <strong className="mono">58</strong>
+          <span>event scripts inspected</span>
+        </div>
+        <div>
+          <strong className="mono">0</strong>
+          <span>guessed exchange contracts</span>
+        </div>
+      </div>
+      <Notice
+        tone="amber"
+        title="Supported contracts are not a promise of account-level availability."
+      >
+        Real account access must be verified from your own secured server. This environment has no
+        account credentials; blocked network access or missing permission is shown as unavailable.
+        Live trading is not acceptance-ready with the supplied collection.
+      </Notice>
+      <Panel
+        title="Feature support matrix"
+        description="“Partial” means a request exists, but information needed for a safe implementation is missing."
+        className="support-panel"
+      >
+        <div className="support-matrix">
+          {CAPABILITIES.map((c) => (
+            <div className="support-row" key={c.title}>
+              <div>
+                <h3>{c.title}</h3>
+                <p>{c.detail}</p>
+              </div>
+              <Badge
+                tone={
+                  c.status === 'supported' ? 'green' : c.status === 'partial' ? 'amber' : 'neutral'
+                }
+              >
+                {c.status === 'supported' && <Check size={11} />} {c.status}
+              </Badge>
+            </div>
+          ))}
+        </div>
+      </Panel>
+      <Panel
+        title="All 38 requests"
+        actions={
+          <div className="segment small">
+            {['all', 'spot', 'futures'].map((f) => (
+              <button key={f} className={filter === f ? 'active' : ''} onClick={() => setFilter(f)}>
+                {f === 'all' ? 'All requests' : f === 'spot' ? 'Spot' : 'Futures'}
+              </button>
+            ))}
+          </div>
+        }
+        className="endpoints-panel"
+      >
+        <div className="market-search">
+          <Search size={15} />
+          <input
+            aria-label="Search API audit"
+            value={search}
+            onChange={(e) => setSearch(e.target.value)}
+            placeholder="Search requests, paths, or audit findings…"
+          />
+          <span>{filtered.length} REQUESTS</span>
+        </div>
+        {error ? (
+          <Empty title="Inventory unavailable" text={error} />
+        ) : !data ? (
+          <Empty
+            title="Loading the pinned inventory"
+            text="Reading the sanitized audit generated from the supplied collection."
+          />
+        ) : filtered.length ? (
+          <div className="endpoint-list">
+            {filtered.map((e) => (
+              <details className="endpoint" key={e.number}>
+                <summary>
+                  <span className="endpoint-number mono">{String(e.number).padStart(2, '0')}</span>
+                  <span className={`method method-${e.method.toLowerCase()}`}>{e.method}</span>
+                  <span className="endpoint-name">
+                    <strong>{e.location.split(' / ').at(-1)}</strong>
+                    <span>{e.location.split(' / ').slice(0, -1).join(' / ')}</span>
+                  </span>
+                  <Badge tone={e.support === 'full' ? 'green' : 'amber'}>
+                    {e.support === 'full' ? 'Documented read' : 'Incomplete contract'}
+                  </Badge>
+                  <ChevronDown size={15} />
+                </summary>
+                <div className="endpoint-detail">
+                  <code>{e.url}</code>
+                  <div className="endpoint-metadata">
+                    <span>
+                      {e.responseExamples} saved response example
+                      {e.responseExamples === 1 ? '' : 's'}
