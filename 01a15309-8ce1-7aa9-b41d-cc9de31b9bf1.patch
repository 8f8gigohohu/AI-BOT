+                </details>
+                <div className="decision-meta">
+                  <Clock3 size={12} />
+                  {formatTime(current.createdAt, true)} UTC · {current.observations} observations ·{' '}
+                  {current.strength} rule strength
+                </div>
+              </>
+            ) : (
+              <Empty
+                compact
+                icon={<BrainCircuit size={26} />}
+                title="No decision without evidence"
+                text="Run the engine to evaluate the observations available for this market. Insufficient or stale data produces HOLD with a clear reason."
+              />
+            )}
+            <div className="workbench-actions">
+              <Button
+                busy={busy === 'signal'}
+                disabled={busy !== null && busy !== 'signal'}
+                onClick={analyze}
+              >
+                <Zap size={14} />
+                {current ? 'Evaluate again' : 'Generate research signal'}
+              </Button>
+              {current && current.signal !== 'hold' && venue === 'spot' && (
+                <Button variant="secondary" onClick={() => prefill(current)}>
+                  Prefill paper ticket
+                  <ArrowRight size={14} />
+                </Button>
+              )}
+            </div>
+            <div className="engine-foot">
+              <LockKeyhole size={12} />
+              Generating this signal never places an order.
+            </div>
+          </div>
+        </Panel>
+        <Panel
+          title="Strategy specification"
+          description="Fixed rules you can inspect and test."
+          actions={<Badge>v1.0</Badge>}
+        >
+          <div className="strategy-spec">
+            <div>
+              <span className="spec-index mono">01</span>
+              <div>
+                <strong>Observe a continuous window</strong>
+                <p>
+                  At least 20 positive price observations. Latest sample must be within 60 seconds.
+                  Gaps over two minutes suppress directional signals.
+                </p>
+              </div>
+            </div>
+            <div>
+              <span className="spec-index mono">02</span>
+              <div>
+                <strong>Measure momentum & extension</strong>
+                <p>
+                  Compare 5- and 20-observation simple moving averages. Compute RSI from 14 changes
+                  and standard deviation of observed returns.
+                </p>
+              </div>
+            </div>
+            <div>
+              <span className="spec-index mono">03</span>
+              <div>
+                <strong>Apply explicit thresholds</strong>
+                <p>
+                  BUY: SMA spread &gt; 0.15% and RSI &lt; 70. SELL: spread &lt; −0.15% or RSI &gt;
+                  75. Otherwise HOLD. Return volatility ≥ 3% overrides to HOLD.
+                </p>
+              </div>
+            </div>
+            <div>
+              <span className="spec-index mono">04</span>
+              <div>
+                <strong>Keep execution separate</strong>
+                <p>
+                  Signals only record decisions. A matching Spot signal can prefill a paper ticket,
+                  but your review and submit action are always required.
+                </p>
+              </div>
+            </div>
+          </div>
+          <div className="strategy-foot">
+            <FlaskConical size={16} />
+            <span>Rule strength is qualitative, not a calibrated win probability.</span>
+          </div>
+        </Panel>
+      </div>
+      <Panel
+        title="Backtest the observations"
+        description="Research on data you actually collected — not a manufactured historical track record."
+        actions={<Badge tone="amber">Spot · long-only · hypothetical</Badge>}
+        className="backtest-panel"
+      >
+        <div className="backtest-toolbar">
+          <div>
+            <Database size={18} />
+            <span>
+              <strong>{market?.history.length ?? 0}</strong> visible observations
+              <span className="muted"> · 40 minimum to backtest</span>
+            </span>
+          </div>
+          <Button
+            variant="secondary"
+            busy={busy === 'backtest'}
+            disabled={venue !== 'spot' || (busy !== null && busy !== 'backtest')}
+            onClick={run}
+          >
+            <Play size={13} />
+            Run observation backtest
+          </Button>
+        </div>
+        {venue === 'futures' && (
+          <div className="padded-notice">
+            <Notice tone="amber">
+              Futures backtests are disabled. The engine does not model leverage, funding, margin,
+              or liquidation. Select a Spot INR market to research the long-only simulation.
+            </Notice>
+          </div>
+        )}
+        {result && result.pair === pair && venue === 'spot' ? (
+          <div className="backtest-result">
+            <div className="backtest-metrics">
+              <div>
+                <span>Hypothetical net P&L</span>
+                <strong className="mono">{formatMoney(result.netPnl)}</strong>
+                <small>{percent(result.returnPercent)} return</small>
+              </div>
+              <div>
+                <span>Max observed drawdown</span>
+                <strong className="mono">{result.maxDrawdownPercent.toFixed(2)}%</strong>
+                <small>No annualization</small>
+              </div>
+              <div>
+                <span>Simulated executions</span>
+                <strong className="mono">{result.executions}</strong>
+                <small>{result.completedRoundTrips} completed round trips</small>
+              </div>
+              <div>
+                <span>Round-trip win rate</span>
+                <strong className="mono">
+                  {result.winRatePercent === null ? '—' : `${result.winRatePercent.toFixed(1)}%`}
+                </strong>
+                <small>
+                  {result.winRatePercent === null ? 'No completed round trips' : 'Not a prediction'}
+                </small>
+              </div>
+            </div>
+            <div className="backtest-chart-label">
+              <span>HYPOTHETICAL EQUITY · INR</span>
+              <span>
+                {formatTime(result.start, true)} — {formatTime(result.end, true)} UTC
+              </span>
+            </div>
+            <PriceChart
+              history={result.equityCurve.map((p) => ({ time: p.time, price: String(p.value) }))}
+              available
+              research
+            />
+            <div className="backtest-caveats">
+              {result.caveats.map((c) => (
+                <p key={c}>{c}</p>
+              ))}
+            </div>
+          </div>
+        ) : (
+          <Empty
+            icon={<ChartNoAxesCombined size={27} />}
+            title="Build a history worth testing"
+            text="Keep market polling on to record genuine prices. This collection has no candle endpoint, so we cannot retrieve or invent earlier history. Backtests use next-observation fills with explicit cost assumptions."
+          />
+        )}
+      </Panel>
+    </>
+  );
+}
