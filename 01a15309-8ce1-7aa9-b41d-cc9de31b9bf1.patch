+    expect((await o.post('/api/orders', paperOrder())).body.error.code).toBe('DUPLICATE_ORDER');
+    expect(t.store.trades(t.store.wallet().portfolioId)).toHaveLength(1);
+  });
+  it('persists idempotency and balances across a process restart', async () => {
+    const t = makeTestApp();
